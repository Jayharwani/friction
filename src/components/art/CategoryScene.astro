---
/**
 * One isometric scene per family. Eight of them, drawn in one hand.
 *
 * Shared rules, which is what makes eight separate drawings read as a set:
 *
 *   · a 240×180 box, isometric at the standard 2:1 ratio
 *   · one light from upper left, so every top face is the lightest tone and
 *     every right face the darkest
 *   · three tones only — the family hue at three strengths against the page
 *   · a soft ground shadow tinted to the hue, never to black
 *   · no outlines: the planes separate by tone, the way real light does
 *
 * Each scene is the failure as an object, not an icon of the category:
 *
 *   stability     a stack with one slab slid out and falling
 *   speed         a belt of blocks bunching up against a closed gate
 *   money         a slot with the coin caught halfway
 *   data          two halves of a store with the bridge missing
 *   access        a door in a wall with no handle
 *   wayfinding    stepping stones that fork, one branch running out
 *   interruption  a screen with a panel dropped across it
 *   support       a counter with nobody behind it
 */
import { type Family } from '../../lib/categories';

interface Props {
  family: Family;
  /** Rendered at the card size by default; the page header asks for large. */
  size?: 'card' | 'large';
  class?: string;
}

const { family, size = 'card', class: klass } = Astro.props;

/*
 * Faces are declared as polygon points. `t` is the tone: 0 top (lightest),
 * 1 left, 2 right (darkest), 3 the accentless ground.
 */
type Face = { p: string; t: 0 | 1 | 2 | 3 };

const SCENES: Record<Family, Face[]> = {
  /* A stack of slabs, the third slid out and tipping. */
  stability: [
    { p: '60,132 120,166 180,132 120,98', t: 3 },
    { p: '60,110 120,144 180,110 120,76', t: 0 },
    { p: '60,110 60,122 120,156 120,144', t: 1 },
    { p: '180,110 180,122 120,156 120,144', t: 2 },
    { p: '60,86 120,120 180,86 120,52', t: 0 },
    { p: '60,86 60,98 120,132 120,120', t: 1 },
    { p: '180,86 180,98 120,132 120,120', t: 2 },
    { p: '84,48 150,30 196,56 130,74', t: 0 },
    { p: '84,48 84,60 130,86 130,74', t: 1 },
    { p: '196,56 196,68 130,86 130,74', t: 2 },
  ],
  /* A belt running away downhill, its load bunched against a closed gate. */
  speed: [
    { p: '40,70 200,158 178,170 18,82', t: 3 },
    { p: '18,82 178,170 178,178 18,90', t: 1 },
    { p: '97,124 117,135 137,124 117,113', t: 0 },
    { p: '97,124 97,138 117,149 117,135', t: 1 },
    { p: '137,124 137,138 117,149 117,135', t: 2 },
    { p: '124,139 144,150 164,139 144,128', t: 0 },
    { p: '124,139 124,153 144,164 144,150', t: 1 },
    { p: '164,139 164,153 144,164 144,150', t: 2 },
    { p: '150,153 170,164 190,153 170,142', t: 0 },
    { p: '150,153 150,167 170,178 170,164', t: 1 },
    { p: '190,153 190,167 170,178 170,164', t: 2 },
    { p: '186,104 204,104 204,172 186,172', t: 2 },
  ],
  /* A slot, and a coin stuck across its mouth. */
  money: [
    { p: '60,140 120,170 180,140 120,110', t: 3 },
    { p: '62,96 120,126 178,96 120,66', t: 0 },
    { p: '62,96 62,124 120,154 120,126', t: 1 },
    { p: '178,96 178,124 120,154 120,126', t: 2 },
    { p: '96,92 120,104 144,92 120,80', t: 2 },
    { p: '120,40 136,50 136,80 120,90 104,80 104,50', t: 1 },
    { p: '136,50 141,53 141,83 136,80', t: 2 },
  ],
  /* Two halves of a store, the span between them gone. */
  data: [
    { p: '24,132 108,132 168,162 84,162', t: 3 },
    { p: '30,96 76,96 100,108 54,108', t: 0 },
    { p: '30,96 30,126 54,138 54,108', t: 1 },
    { p: '100,108 100,138 54,138 54,108', t: 2 },
    { p: '140,96 186,96 210,108 164,108', t: 0 },
    { p: '140,96 140,126 164,138 164,108', t: 1 },
    { p: '210,108 210,138 164,138 164,108', t: 2 },
