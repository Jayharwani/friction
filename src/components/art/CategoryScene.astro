  /*
   * A standing screen with something dropped across its face. Upright rather
   * than stacked: two flat slabs read as the stability scene, and these two
   * sit next to each other on the index.
   */
  interruption: [
    { p: '64,150 132,168 190,146 122,128', t: 3 },
    { p: '64,60 144,100 144,152 64,112', t: 0 },
    { p: '144,100 162,91 162,143 144,152', t: 2 },
    { p: '64,60 144,100 162,91 82,51', t: 1 },
    { p: '96,140 112,148 112,162 96,154', t: 2 },
    { p: '52,84 176,146 176,164 52,102', t: 2 },
  ],
  /* A counter, and nobody behind it. */
  support: [
    { p: '40,140 120,178 200,140 120,102', t: 3 },
    { p: '46,104 120,140 194,104 120,68', t: 0 },
    { p: '46,104 46,124 120,160 120,140', t: 1 },
    { p: '194,104 194,124 120,160 120,140', t: 2 },
    { p: '132,60 168,78 168,96 132,78', t: 1 },
    { p: '168,78 196,64 196,82 168,96', t: 2 },
  ],
};

const faces = SCENES[family];
---

<svg
  class:list={['scene', `is-${size}`, klass]}
  viewBox="0 0 240 180"
  role="img"
  aria-label={`An illustration for the ${family} family.`}
  data-family={family}
>
  {/* The ground shadow, tinted to the hue rather than to black. */}
  <ellipse class="shade" cx="120" cy="164" rx="78" ry="16" />
  {faces.map((f) => <polygon points={f.p} class={`t${f.t}`} />)}
</svg>

<style>
  .scene {
    display: block;
    width: 100%;
    height: auto;
  }

  .is-card {
    max-width: 240px;
  }

  .shade {
    fill: color-mix(in oklab, var(--cat) 26%, transparent);
    filter: blur(9px);
  }

  /*
   * Three tones from one hue, in the order light falls on an isometric
   * solid: top lightest, left middle, right darkest. No outlines — the
   * planes separate the way real light separates them.
   */
  .t0 {
    fill: color-mix(in oklab, var(--cat) 82%, var(--color-paper));
  }

  .t1 {
    fill: color-mix(in oklab, var(--cat) 55%, var(--color-paper));
  }

  .t2 {
    fill: color-mix(in oklab, var(--cat) 34%, var(--color-paper));
  }

  /* The plane everything stands on. */
  .t3 {
    fill: color-mix(in oklab, var(--cat) 12%, var(--color-paper));
  }
</style>
