  /*
   * Stepping stones that fork. Drawn in the same slab vocabulary as the rest
   * of the set, because a ribbon path read as one diagonal stripe and the
   * split — which is the whole idea — disappeared at card size.
   */
  wayfinding: [
    { p: '38,50 60,62 82,50 60,38', t: 0 },
    { p: '38,50 38,57 60,69 60,62', t: 1 },
    { p: '82,50 82,57 60,69 60,62', t: 2 },
    { p: '82,75 104,87 126,75 104,63', t: 0 },
    { p: '82,75 82,82 104,94 104,87', t: 1 },
    { p: '126,75 126,82 104,94 104,87', t: 2 },
    { p: '126,100 148,112 170,100 148,88', t: 0 },
    { p: '126,100 126,107 148,119 148,112', t: 1 },
    { p: '170,100 170,107 148,119 148,112', t: 2 },
    { p: '170,125 192,137 214,125 192,113', t: 0 },
    { p: '170,125 170,132 192,144 192,137', t: 1 },
    { p: '214,125 214,132 192,144 192,137', t: 2 },
