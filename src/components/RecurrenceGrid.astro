---
/**
 * Twelve weeks at a glance.
 *
 * Deliberately *not* the hero. At eight problems and twelve weeks this is
 * ninety-six cells with about twenty filled, and a sparse heat grid reads as
 * noise rather than pattern. It earns a promotion once the site carries forty
 * or more problems with several months behind them.
 *
 * Built as a real <table> because it is genuinely tabular: that gives row and
 * column headers to a screen reader for free, and every cell states its count
 * in text as well as in colour.
 */
import { url } from '../lib/url';
import { weekLabel } from '../lib/data';
import type { RecurrenceGrid } from '../lib/data';

interface Props {
  grid: RecurrenceGrid;
}

const { grid } = Astro.props;

/**
 * Five discrete steps from the page surface to the accent, interpolated in
 * OKLCH by the --heat-* tokens.
 *
 * Steps rather than a continuous mix: at the counts this data actually
 * produces, a continuous ramp puts everything in a narrow band nobody can
 * tell apart. Monotonic by construction — more reviews is never a lighter cell.
 */
function heatStep(t: number): number {
  if (t <= 0) return 0;
  return Math.min(4, Math.max(1, Math.ceil(t * 4)));
}

const firstWeek = grid.weeks[0];
const lastWeek = grid.weeks.at(-1);
---

<figure class="grid-figure">
  <figcaption class="explain">
    Each cell is one week. Darker means more reviews reporting that problem that week.
  </figcaption>

  <div class="scroller">
    <table>
      <caption class="sr-only">
        Evidence volume by week. Rows are the {grid.rows.length} highest-scoring active problems,
        columns are the {grid.weeks.length} ISO weeks from {weekLabel(firstWeek ?? '')} to {
          weekLabel(lastWeek ?? '')
        }. Each cell gives the number of reviews recorded for that problem in that week.
      </caption>

      <thead>
        <tr>
          <th scope="col" class="corner"><span class="sr-only">Problem</span></th>
          {
            grid.weeks.map((week) => (
              <th scope="col" class="week">
                <span class="sr-only">Week of {weekLabel(week)}</span>
                {/* Every column is labelled, not every third. */}
                <span class="week-label num" aria-hidden="true">
                  {weekLabel(week)}
                </span>
              </th>
            ))
          }
        </tr>
      </thead>

      <tbody>
        {
          grid.rows.map((row) => (
            <tr>
              <th scope="row" class="label">
                <a href={url(`/problems/${row.problem.slug}`)}>{row.problem.title}</a>
              </th>
              {row.cells.map((cell) => (
                <td
                  class="cell"
                  data-heat={heatStep(cell.count / grid.max)}
                  title={`${cell.count} ${cell.count === 1 ? 'review' : 'reviews'} in the week of ${weekLabel(cell.week)}`}
                >
                  <span class="sr-only">
                    {cell.count} in the week of {weekLabel(cell.week)}
                  </span>
                </td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p class="legend">
    <span>Fewer</span>
    <span class="ramp" aria-hidden="true">
      <span data-heat="0"></span>
      <span data-heat="1"></span>
      <span data-heat="2"></span>
      <span data-heat="3"></span>
      <span data-heat="4"></span>
    </span>
    <span>More</span>
  </p>
</figure>

<style>
  .grid-figure {
    margin: 0;
  }

  .explain {
    color: var(--color-muted);
    font-size: var(--text-sm);
    margin-bottom: var(--space-md);
    max-width: var(--measure);
  }

  .scroller {
    overflow-x: auto;
    overscroll-behavior-x: contain;
  }

  table {
    border-collapse: separate;
    border-spacing: 2px;
    /* Sized by its columns rather than stretched: at full width the cells
       become wide bands and it stops reading as a grid. */
    width: auto;
    table-layout: fixed;
  }

  .corner {
    width: 14rem;
  }

  /* Wide enough for a full "29 Jun" label without rotation. */
  .week {
    width: 3rem;
    font-weight: 400;
    vertical-align: bottom;
    padding-bottom: var(--space-2xs);
  }

  @media (max-width: 48rem) {
    .corner {
      width: 9.5rem;
    }
  }

  .week-label {
    display: block;
    font-size: var(--text-xs);
    color: var(--color-muted);
    text-align: left;
    line-height: 1;
    white-space: nowrap;
  }

  /* Pinned while the cells scroll sideways: otherwise you scroll to a cell and
     lose the row it belongs to. */
  .label,
  .corner {
    position: sticky;
    left: 0;
    z-index: 1;
    background: var(--color-paper);
  }

  .label {
    font-weight: 400;
    text-align: left;
    padding-right: var(--space-sm);
    font-size: var(--text-sm);
    max-width: 14rem;
  }

  .label a {
    text-decoration: none;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.25;
  }

  .label a:hover {
    text-decoration: underline;
    text-underline-offset: 0.16em;
  }

  .cell {
    height: 1.75rem;
    padding: 0;
  }

  /* One hue. Five steps. Nothing else in the product uses a second colour. */
  [data-heat='0'] { background: var(--color-paper-2); }
  [data-heat='1'] { background: var(--heat-1); }
  [data-heat='2'] { background: var(--heat-2); }
  [data-heat='3'] { background: var(--heat-3); }
  [data-heat='4'] { background: var(--heat-4); }

  .legend {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin-top: var(--space-md);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .ramp {
    display: inline-flex;
    gap: 2px;
  }

  .ramp span {
    width: 1.1rem;
    height: 0.6rem;
  }
</style>
