---
/**
 * The hero: a question, and a box you can actually type in.
 *
 * Every problem on the site is indexed at build time and serialised into the
 * page, so the search is instant, works offline, and needs no backend. The
 * index is small — 25 problems is a few KB — and it is the same data the
 * cards below render from, so it cannot drift.
 *
 * Without JavaScript the input is still a labelled field inside a form that
 * submits to /problems, where the full filterable list lives. Nothing here
 * is a dead affordance.
 */
import { url } from '../lib/url';
import { getProblems, getProduct } from '../lib/data';
import { FAMILIES, FAMILY_LABEL, familyOf } from '../lib/categories';
import CategoryGlyph from './CategoryGlyph.astro';

const problems = getProblems();

/* One flat record per problem. `hay` is what the query is matched against. */
const index = problems.map((p) => {
  const app = getProduct(p.productSlug)?.name ?? p.productSlug;
  const family = familyOf(p.category);
  return {
    slug: p.slug,
    title: p.title,
    app,
    category: p.category,
    family,
    score: p.score,
    verdict: p.verdict,
    hay: `${p.title} ${app} ${p.category} ${FAMILY_LABEL[family]} ${p.verdict}`.toLowerCase(),
  };
});

const families = FAMILIES.map((family) => ({
  family,
  count: problems.filter((p) => familyOf(p.category) === family).length,
})).filter((f) => f.count > 0);
---

<section class="hero-search" data-hero-search>
  <h1>
    <span class="line-1">See what's broken</span>
    <span class="line-2">in the apps everyone uses</span>
  </h1>

  <form class="box" action={url('/problems')} method="get" role="search">
    <label class="sr-only" for="hero-q">Search problems</label>
    <input
      id="hero-q"
      type="search"
      name="q"
      placeholder="Ask about any app, or any kind of problem…"
      autocomplete="off"
      spellcheck="false"
      data-hero-input
    />
    <button type="submit" aria-label="Search">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h13" /><path d="M13 6.5l5.5 5.5-5.5 5.5" />
      </svg>
    </button>
  </form>

  {/* Results replace nothing until something is typed. */}
  <div class="results" data-hero-results hidden>
    <ul data-hero-list></ul>
    <p class="none" data-hero-none hidden>Nothing matches that.</p>
  </div>

  <ul class="chips" data-hero-chips aria-label="Jump to a kind of problem">
    {
      families.map(({ family, count }) => (
        <li>
          <a href={url(`/problems?family=${family}`)} data-family={family} data-chip={family}>
            <CategoryGlyph family={family} size={15} />
            <span>{FAMILY_LABEL[family]}</span>
            <span class="c-n num">{count}</span>
          </a>
        </li>
      ))
    }
  </ul>

  {/* Inside the section: the script looks for it under the component root. */}
  <script is:inline type="application/json" data-hero-index set:html={JSON.stringify(index)} />
</section>

<style>
  .hero-search {
    display: grid;
    justify-items: center;
    text-align: center;
    padding-block: var(--space-4xl) var(--space-2xl);
  }

  /*
   * Two lines, two voices. The statement is set light and wide; the promise
   * under it is Newsreader in italic on a lit panel. One roman line and one
   * italic serif line is the whole identity of this page.
   */
  /*
   * The measure is in rem, not em: em here resolves against the h1's own
   * inherited 1rem, not against the display size the spans set, which
   * crushed the whole headline into a 288px column.
   */
  h1 {
    display: grid;
    gap: var(--space-2xs);
    margin: 0;
    width: 100%;
    max-width: 52rem;
    /* The two lines are one statement; neither may break inside a word. */
    overflow-wrap: normal;
    text-wrap: balance;
  }

  .line-1 {
    font-size: clamp(2.1rem, 1rem + 4.2vw, 3.9rem);
    font-weight: 300;
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--color-ink);
  }

  .line-2 {
    justify-self: center;
    max-width: 100%;
    font-family: var(--font-quote);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(2rem, 0.9rem + 4.2vw, 3.8rem);
    line-height: 1.08;
    letter-spacing: -0.012em;
    padding: 0.08em 0.5em 0.18em;
    border-radius: 14px;
    color: var(--color-ink);
    background: linear-gradient(
      180deg,
      color-mix(in oklch, var(--color-paper-3) 90%, transparent),
      color-mix(in oklch, var(--color-paper-2) 40%, transparent)
    );
  }

  /* ---- the box ---- */

  .box {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    width: min(38rem, 100%);
    margin-top: var(--space-2xl);
    padding: var(--space-xs) var(--space-xs) var(--space-xs) var(--space-lg);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: 14px;
    background: var(--color-paper-2);
  }

  .box:focus-within {
    border-color: color-mix(in oklch, var(--color-accent) 55%, var(--color-rule));
  }

  input {
    flex: 1 1 auto;
    min-width: 0;
    font: inherit;
    font-size: var(--text-md);
    color: var(--color-ink);
    background: none;
    border: 0;
    padding-block: var(--space-2xs);
  }

  input::placeholder {
    color: var(--color-neutral);
  }

  input:focus {
    outline: none;
  }

  /* The box is tall enough; the field inside it was not. */
  @media (pointer: coarse) {
    input {
      min-height: var(--tap);
    }
  }

  /* The search input's own clear affordance, which we do not style. */
  input::-webkit-search-cancel-button {
    filter: grayscale(1);
  }

  .box button {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 0;
    border-radius: 10px;
    background: var(--color-accent);
    color: var(--color-paper);
    cursor: pointer;
  }

  /* ---- results ---- */

  .results {
    width: min(38rem, 100%);
    margin-top: var(--space-sm);
    text-align: start;
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: 12px;
    background: var(--color-paper-2);
    overflow: hidden;
  }

  .results ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .results :global(li + li) {
    border-top: var(--rule-hair) solid var(--color-rule);
  }

  .results :global(a) {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    min-height: var(--tap);
    text-decoration: none;
  }

  .results :global(a:hover),
  .results :global(a:focus-visible) {
    background: var(--cat-tint, var(--color-paper-3));
  }

  .results :global(.r-title) {
    font-size: var(--text-sm);
    line-height: 1.3;
    color: var(--color-ink);
  }

  .results :global(.r-app) {
    display: block;
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .results :global(.r-score) {
    font-size: var(--text-md);
    font-weight: 600;
    color: var(--color-ink);
  }

  .results :global(.glyph) {
    color: var(--cat);
  }

  .none {
    padding: var(--space-md);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  /* ---- chips ---- */

  .chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2xs);
    list-style: none;
    margin: var(--space-lg) 0 0;
    padding: 0;
  }

  .chips a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    min-height: var(--tap);
    padding: var(--space-2xs) var(--space-sm);
    font-size: var(--text-xs);
    color: var(--color-ink);
    text-decoration: none;
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: 999px;
    background: var(--color-paper-2);
  }

  .chips :global(.glyph) {
    color: var(--cat);
  }

  .chips a:hover,
  .chips a:focus-visible {
    border-color: var(--cat-edge);
    background: var(--cat-tint);
  }

  .c-n {
    color: var(--color-muted);
  }

  @media (prefers-reduced-motion: no-preference) {
    .chips a,
    .box {
      transition:
        background-color var(--dur-micro) var(--ease-out),
        border-color var(--dur-micro) var(--ease-out);
    }
  }
</style>


<script>
  import { initHeroSearch } from '../scripts/hero-search';

  document.addEventListener('astro:page-load', initHeroSearch);
</script>
