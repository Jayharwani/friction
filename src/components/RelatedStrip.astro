---
/**
 * Up to three other challenges that share this one's app or category.
 *
 * Every challenge page was a dead end: the only way out was the nav. Same app
 * first, because that is the strongest relation, then same category across
 * apps, which is how a reader finds that three apps all break the same way.
 *
 * No sparkline and no verdict here. This strip is a way out of the page, and
 * a chart in it would be the machinery leaking back onto a surface page. The
 * reach words carry what the sparkline carried.
 */
import type { Problem } from '../../scripts/validate';
import { url } from '../lib/url';
import { getChallenge, getProblems, getProduct, surfaceLabel } from '../lib/data';

interface Props {
  problem: Problem;
  limit?: number;
}

const { problem, limit = 3 } = Astro.props;

const others = getProblems().filter((p) => p.slug !== problem.slug);

const sameApp = others
  .filter((p) => p.productSlug === problem.productSlug)
  .sort((a, b) => b.score - a.score);

const sameCategory = others
  .filter((p) => p.productSlug !== problem.productSlug && p.category === problem.category)
  .sort((a, b) => b.score - a.score);

/*
 * Previous and next within the app, in score order — the order the app's own
 * page lists them in, so the two agree.
 */
const siblings = getProblems()
  .filter((p) => p.productSlug === problem.productSlug)
  .sort((a, b) => b.score - a.score);
const here = siblings.findIndex((p) => p.slug === problem.slug);
const previous = here > 0 ? siblings[here - 1] : undefined;
const next = here >= 0 && here < siblings.length - 1 ? siblings[here + 1] : undefined;

/** The human title where one has been written, the extracted one otherwise. */
const named = (p: Problem) => getChallenge(p.slug)?.humanTitle ?? p.title;
const appName = getProduct(problem.productSlug)?.name ?? problem.productSlug;

const related = [...sameApp, ...sameCategory].slice(0, limit).map((p) => ({
  problem: p,
  app: getProduct(p.productSlug)?.name ?? p.productSlug,
  humanTitle: named(p),
  label: surfaceLabel(p),
  relation: p.productSlug === problem.productSlug ? 'same app' : 'same category',
}));
---

{
  (previous || next) && (
    <nav class="seq" aria-label={`Other challenges in ${appName}`}>
      {previous ? (
        <a class="prev" href={url(`/challenges/${previous.slug}`)}>
          <span class="dir">Previous in {appName}</span>
          <span class="t written-text">{named(previous)}</span>
        </a>
      ) : (
        <span />
      )}
      {next && (
        <a class="next" href={url(`/challenges/${next.slug}`)}>
          <span class="dir">Next in {appName}</span>
          <span class="t written-text">{named(next)}</span>
        </a>
      )}
    </nav>
  )
}

{
  related.length > 0 && (
    <section class="related" aria-labelledby="related-heading">
      <h2 id="related-heading">Related challenges</h2>
      <ul>
        {related.map(({ problem: p, app, humanTitle, label, relation }) => (
          <li>
            <div class="body">
              <h3 class="written-text">
                <a href={url(`/challenges/${p.slug}`)}>{humanTitle}</a>
              </h3>
              <p class="meta num">
                {app}, {relation}, {p.evidence.length}{' '}
                {p.evidence.length === 1 ? 'review' : 'reviews'}
              </p>
            </div>
            <p class="reach meta">{label}</p>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  /* ---- previous / next within the app ---- */

  .seq {
    display: grid;
    gap: var(--space-md);
    margin-top: var(--space-2xl);
    padding-top: var(--space-lg);
    border-top: var(--rule-hair) solid var(--color-rule);
  }

  @media (min-width: 40rem) {
    .seq {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-xl);
    }
  }

  .seq a {
    display: grid;
    gap: var(--space-3xs);
    text-decoration: none;
    padding: var(--space-sm);
    margin: calc(var(--space-sm) * -1);
    border-radius: var(--r-cell);
  }

  .seq a:hover,
  .seq a:focus-visible {
    background: color-mix(in oklch, var(--color-ink) 5%, transparent);
  }

  .seq .next {
    text-align: right;
  }

  .dir {
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .t {
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: 1.3;
  }

  .related {
    margin-top: var(--space-2xl);
    padding-top: var(--space-lg);
    border-top: var(--rule-hair) solid var(--color-rule);
  }

  h2 {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-muted);
  }

  ul {
    list-style: none;
    margin: var(--space-sm) 0 0;
    padding: 0;
  }

  li {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: var(--space-lg);
    padding: var(--space-sm) var(--space-sm) var(--space-sm) 0;
    border-top: var(--rule-hair) solid var(--color-rule);
  }

  li:has(a:hover),
  li:has(a:focus-visible) {
    background: color-mix(in oklch, var(--color-ink) 5%, transparent);
  }

  .body {
    flex: 1 1 auto;
    min-width: 0;
  }

  h3 {
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: 1.3;
  }

  h3 a {
    text-decoration: none;
  }

  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .meta {
    margin-top: var(--space-3xs);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .reach {
    flex: none;
    font-size: var(--text-xs);
    color: var(--color-muted);
    min-width: 7em;
    text-align: right;
  }

  @media (max-width: 40rem) {
    li {
      flex-wrap: wrap;
      gap: var(--space-xs) var(--space-md);
    }

    .reach {
      text-align: left;
      min-width: 0;
    }
  }
</style>
