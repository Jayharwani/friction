---
/**
 * Up to three other challenges that share this one's app or category.
 *
 * Every challenge page was a dead end: the only way out was the nav. Same app
 * first, because that is the strongest relation, then same category across
 * apps, which is how a reader finds that three apps all break the same way.
 *
 * Cards rather than text rows. Three titles with a metadata line under each
 * and a hairline between them is the pattern this project keeps drifting back
 * to, and the one the rest of the site has already left.
 */
import type { Problem } from '../../scripts/validate';
import { url } from '../lib/url';
import { getChallenge, getProblems, getProduct } from '../lib/data';
import ChallengeCard from './ui/ChallengeCard.astro';

interface Props {
  problem: Problem;
  limit?: number;
}

const { problem, limit = 3 } = Astro.props;

const all = getProblems();
const others = all.filter((p) => p.slug !== problem.slug);

const sameApp = others
  .filter((p) => p.productSlug === problem.productSlug)
  .sort((a, b) => b.score - a.score);

const sameCategory = others
  .filter((p) => p.productSlug !== problem.productSlug && p.category === problem.category)
  .sort((a, b) => b.score - a.score);

/*
 * Previous and next within the app, in score order — the order the app's own
 * page lists them in, so the two agree.
 */
const siblings = all
  .filter((p) => p.productSlug === problem.productSlug)
  .sort((a, b) => b.score - a.score);
const here = siblings.findIndex((p) => p.slug === problem.slug);
const previous = here > 0 ? siblings[here - 1] : undefined;
const next = here >= 0 && here < siblings.length - 1 ? siblings[here + 1] : undefined;
const appName = getProduct(problem.productSlug)?.name ?? problem.productSlug;

/** The human title where one has been written, the extracted one otherwise. */
const named = (p: Problem) => getChallenge(p.slug)?.humanTitle ?? p.title;

/** Apps sharing a category — what a challenge card needs for its lenses. */
const appsIn = (category: string) =>
  new Set(all.filter((p) => p.category === category).map((p) => p.productSlug)).size;

const related = [...sameApp, ...sameCategory].slice(0, limit);
---

{
  (previous || next) && (
    <nav class="seq" aria-label={`Other challenges in ${appName}`}>
      {previous ? (
        <a class="prev" href={url(`/challenges/${previous.slug}`)}>
          <span class="dir">Previous in {appName}</span>
          <span class="t written-text">{named(previous)}</span>
        </a>
      ) : (
        <span />
      )}
      {next && (
        <a class="next" href={url(`/challenges/${next.slug}`)}>
          <span class="dir">Next in {appName}</span>
          <span class="t written-text">{named(next)}</span>
        </a>
      )}
    </nav>
  )
}

{
  related.length > 0 && (
    <section class="related" aria-labelledby="related-heading">
      <h2 id="related-heading">Related challenges</h2>
      <div class="cards">
        {related.map((p) => (
          <ChallengeCard problem={p} appsInCategory={appsIn(p.category)} level={3} />
        ))}
      </div>
    </section>
  )
}

<style>
  /* ---- previous / next within the app ---- */

  .seq {
    display: grid;
    gap: var(--space-md);
    margin-top: var(--space-2xl);
  }

  @media (min-width: 40rem) {
    .seq {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-xl);
    }
  }

  .seq a {
    display: grid;
    gap: var(--space-3xs);
    text-decoration: none;
    padding: var(--space-sm);
    margin: calc(var(--space-sm) * -1);
    border-radius: var(--shape-sm);
  }

  .seq a:hover,
  .seq a:focus-visible {
    background: var(--m-surface-container-low);
  }

  .seq .next {
    text-align: right;
  }

  .dir {
    font-size: var(--label-md);
    color: var(--m-on-surface-variant);
  }

  .t {
    font-size: var(--body-md);
    font-weight: 500;
    line-height: var(--line-body);
  }

  .related {
    margin-top: var(--space-2xl);
  }

  h2 {
    font-size: var(--title-md);
    font-weight: var(--weight-emphasis);
    letter-spacing: var(--track-emphasis);
    color: var(--m-on-surface-variant);
  }

  .cards {
    display: grid;
    gap: var(--space-md);
    margin-top: var(--space-md);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }
</style>
