---
/**
 * A term the page has not taught yet, with its definition attached.
 *
 * A dotted underline, opening one sentence on hover and on focus. No
 * JavaScript: a real <button> for focus, `:hover` and `:focus-within` for the
 * reveal. A tooltip that only opens on hover is useless to the person who
 * needs it, because they do not know to hover — so this opens on keyboard
 * focus too, and the definition is in the accessible name either way.
 *
 * Only the first appearance on a page is marked. See lib/terms.ts.
 */
interface Props {
  /** The word as it appears in the sentence. */
  label: string;
  /** One sentence, in plain language. */
  definition: string;
}

const { label, definition } = Astro.props;
---

<span class="term">
  <button type="button" aria-label={`${label}: ${definition}`}>{label}</button>
  <span class="def" aria-hidden="true">{definition}</span>
</span>

<style>
  .term {
    position: relative;
    display: inline-block;
  }

  button {
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    padding: 0;
    cursor: help;
    /* A dotted rule, not a link underline: this explains itself rather than
       going anywhere. */
    text-decoration: underline dotted
      color-mix(in oklch, currentColor 55%, transparent);
    text-underline-offset: 0.22em;
  }

  button:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .def {
    position: absolute;
    top: calc(100% + var(--space-2xs));
    left: 0;
    z-index: 6;
    width: max-content;
    max-width: 17rem;
    padding: var(--space-xs) var(--space-sm);
    background: var(--color-paper-3);
    color: var(--color-ink);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: 6px;
    font-size: var(--text-xs);
    font-weight: 400;
    line-height: 1.45;
    white-space: normal;
    text-align: left;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .term:hover .def,
  .term:focus-within .def {
    opacity: 1;
    visibility: visible;
  }

  /*
   * In a right-aligned column the definition would run off the viewport, so
   * it opens leftward there. Set by the row rather than guessed by a
   * container query, which had no container to query.
   */
  :global(.figures) .def,
  .term[data-align='end'] .def {
    left: auto;
    right: 0;
  }
</style>
