---
/**
 * The top app bar.
 *
 * The quietest surface on the site until it is scrolled past, when it takes
 * one step up the ramp and grows a hairline. That is a colour change, so it
 * runs on an effects curve; nothing here moves.
 *
 * The active page is a pill in primary-container, not an underline. An
 * underline in a row of links is the browser's own idea of a visited state
 * and reads as one.
 */
import BrandMark from '../BrandMark.astro';
import ThemeToggle from '../ThemeToggle.astro';
import { url } from '../../lib/url';

interface Props {
  nav: Array<{ href: string; label: string }>;
  here: string;
}

const { nav, here } = Astro.props;
---

<header class="site-header" data-nav>
  <div class="header-inner">
    <a class="wordmark" href={url('/')}>
      <BrandMark size={19} />
      <span>Friction</span>
    </a>

    <nav aria-label="Primary">
      <ul>
        {
          nav.map((item) => {
            const target = url(item.href).replace(/\/$/, '');
            const current = here === target;
            return (
              <li>
                <a href={url(item.href)} aria-current={current ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <button class="find" type="button" data-palette-open>
      <span>Search</span>
      <kbd aria-hidden="true">⌘K</kbd>
    </button>

    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-skip);
    border-bottom: var(--rule-hair) solid transparent;
  }



  .site-header[data-scrolled] {
    background: color-mix(in oklab, var(--m-surface-container-low) 94%, transparent);
    border-bottom-color: var(--m-outline-variant);
  }

  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm) var(--space-lg);
    padding: var(--space-md) var(--page-gutter);
  }

  .find {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    font: inherit;
    font-size: var(--text-xs);
    color: var(--color-muted);
    background: none;
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--r-pill);
    /* Matches the theme control beside it: same padding, same line-height. */
    padding: var(--space-2xs) var(--space-xs);
    line-height: 1.4;
    /* One explicit height shared with the theme control beside it. The two
       are bordered differently — one per button, one on the wrapper — so
       matching their padding was never going to match their boxes. */
    height: 1.875rem;
    cursor: pointer;
  }

  .find:hover {
    color: var(--color-ink);
  }

  .find:active {
    background: color-mix(in oklch, var(--color-ink) 10%, transparent);
  }

  .find:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .find kbd {
    font-family: var(--font-mono);
    color: var(--m-on-surface-variant);
  }

  .wordmark {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-lg);
    letter-spacing: -0.02em;
    text-decoration: none;
    margin-right: auto;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--text-sm);
  }

  nav a {
    color: var(--color-muted);
    text-decoration: none;
    padding-block: var(--space-3xs);
  }

    .wordmark {
      display: inline-flex;
      align-items: center;
      min-height: var(--tap);
    }

  nav a:hover {
    color: var(--color-ink);
  }

  nav a[aria-current='page'] {
    color: var(--color-ink);
    font-weight: 600;
    box-shadow: inset 0 -1px 0 0 currentColor;
  }

    .header-inner {
      gap: var(--space-xs) var(--space-sm);
      padding-block: var(--space-sm);
    }
  /* The active page, as a pill rather than an underline. */
  nav a[aria-current='page'] {
    background: var(--m-primary-container);
    color: var(--m-on-primary-container);
    border-radius: var(--shape-full);
    padding: var(--space-3xs) var(--space-sm);
    font-weight: var(--weight-emphasis);
    letter-spacing: var(--track-emphasis);
    text-decoration: none;
  }

  /*
   * Below this the label collapses to the word and the shortcut goes: there
   * is no keyboard to press it with. These three rules were lifted out of
   * this media query when the header moved into its own file, which put
   * "Find" on every desktop screen until it was caught.
   */
  @media (max-width: 48rem) {
    .find span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }

    .find kbd {
      display: none;
    }

    .find::after {
      content: 'Find';
      color: var(--m-on-surface-variant);
    }
  }

  @media (max-width: 34rem) {
    /* Wordmark and theme control share the first row; nav wraps under. */
    nav {
      order: 3;
      width: 100%;
    }
  }

  @media (pointer: coarse) {
    nav a,
    .find {
      min-height: var(--tap);
      display: inline-flex;
      align-items: center;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .site-header {
      transition:
        background-color var(--dur-effects-default) var(--effects-default),
        border-color var(--dur-effects-default) var(--effects-default);
    }

    nav a {
      transition: color var(--dur-effects-fast) var(--effects-fast);
    }
  }
</style>
