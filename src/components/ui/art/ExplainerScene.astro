---
/**
 * The four scenes that carry How it works.
 *
 * Each is a place or a thing, drawn literally. "Where it comes from" is two
 * phones with reviews on them and the reviews coming off them — not an arrow,
 * not a cloud, not a database cylinder.
 *
 * Art direction and the tone scale live in Scene.astro.
 */
import Scene from './Scene.astro';

export type Explainer = 'sources' | 'filter' | 'model' | 'written';

interface Props {
  scene: Explainer;
  class?: string;
}

const { scene, class: klass } = Astro.props;

const LABEL: Record<Explainer, string> = {
  sources:
    'Two phones showing app store reviews, with a stream of review cards coming off them.',
  filter: 'A wide stream of review cards entering a funnel and a thin stream leaving it.',
  model: 'Scattered cards gathered into one stack, beside a column of numbers struck through.',
  written: 'A card of three printed lines and one handwritten line that is visibly different.',
};

/** Five stars in a row, from x,y, at 11px. `on` of them carry the warm tone. */
function stars(x: number, y: number, on: number, size = 11): string[] {
  const out: string[] = [];
  for (let i = 0; i < 5; i++) {
    const cx = x + i * (size + 3);
    /* A five-point star, built once and translated, so every star in the
       whole set is exactly the same shape. */
    const r = size / 2;
    const pts: string[] = [];
    for (let p = 0; p < 10; p++) {
      const rad = p % 2 === 0 ? r : r * 0.44;
      const a = (Math.PI / 5) * p - Math.PI / 2;
      pts.push(`${(cx + r + Math.cos(a) * rad).toFixed(1)},${(y + r + Math.sin(a) * rad).toFixed(1)}`);
    }
    out.push(pts.join(' '));
  }
  return out.map((p, i) => (i < on ? `W${p}` : `N${p}`));
}
---

<Scene label={LABEL[scene]} class={klass}>
  <rect width="480" height="300" rx="0" fill="var(--ill-bg)" />

  {
    scene === 'sources' && (
      <>
        {/* the ground the phones stand on */}
        <ellipse cx="150" cy="256" rx="96" ry="10" fill="var(--shade)" />

        {/* phone behind, tilted back a little */}
        <g transform="rotate(-5 118 150)">
          <rect x="70" y="62" width="96" height="182" rx="13" fill="var(--t2)" />
          <rect x="80" y="76" width="76" height="8" rx="4" fill="var(--t3)" />
          <rect x="80" y="96" width="76" height="46" rx="6" fill="var(--t1)" />
          <rect x="80" y="152" width="76" height="46" rx="6" fill="var(--t1)" />
        </g>

        {/* phone in front, with a review on it drawn as a review */}
        <g transform="rotate(4 196 158)">
          <rect x="146" y="66" width="106" height="196" rx="15" fill="var(--t3)" />
          <rect x="156" y="80" width="86" height="168" rx="8" fill="var(--ill-bg)" />

          <rect x="166" y="92" width="44" height="7" rx="3.5" fill="var(--t3)" />
          {stars(166, 104, 5, 13).map((p) => (
            <polygon points={p.slice(1)} fill={p[0] === 'W' ? 'var(--warm)' : 'var(--t2)'} />
          ))}
          <rect x="166" y="128" width="66" height="6" rx="3" fill="var(--t2)" />
          <rect x="166" y="140" width="52" height="6" rx="3" fill="var(--t2)" />

          <rect x="166" y="164" width="38" height="7" rx="3.5" fill="var(--t3)" />
          {stars(166, 176, 2, 13).map((p) => (
            <polygon points={p.slice(1)} fill={p[0] === 'W' ? 'var(--warm)' : 'var(--t2)'} />
          ))}
          <rect x="166" y="198" width="66" height="6" rx="3" fill="var(--t2)" />
          <rect x="166" y="210" width="44" height="6" rx="3" fill="var(--t2)" />
        </g>

        {/*
          The stream. Five cards on a shallow arc, each a step paler and a
          step smaller than the one before it, so the depth is in the tone
          rather than in a perspective grid.
        */}
        <g data-stream>
          <g transform="translate(286 176)">
            <rect width="96" height="52" rx="9" fill="var(--t3)" />
            <rect x="12" y="13" width="30" height="6" rx="3" fill="var(--ink)" />
            <rect x="12" y="27" width="66" height="5" rx="2.5" fill="var(--t4)" />
            <rect x="12" y="37" width="48" height="5" rx="2.5" fill="var(--t4)" />
          </g>

          <g transform="translate(300 116)">
            <rect width="88" height="48" rx="8" fill="var(--t2)" />
            <rect x="11" y="12" width="26" height="5" rx="2.5" fill="var(--t4)" />
            <rect x="11" y="25" width="60" height="5" rx="2.5" fill="var(--t3)" />
            <rect x="11" y="34" width="42" height="5" rx="2.5" fill="var(--t3)" />
          </g>

          <g transform="translate(330 66)">
            <rect width="78" height="42" rx="8" fill="var(--t2)" />
            <rect x="10" y="11" width="22" height="5" rx="2.5" fill="var(--t3)" />
            <rect x="10" y="23" width="52" height="4" rx="2" fill="var(--t3)" />
            <rect x="10" y="31" width="36" height="4" rx="2" fill="var(--t3)" />
          </g>

          <g transform="translate(384 128)">
            <rect width="66" height="36" rx="7" fill="var(--t1)" />
            <rect x="9" y="10" width="18" height="4" rx="2" fill="var(--t2)" />
            <rect x="9" y="20" width="44" height="4" rx="2" fill="var(--t2)" />
          </g>

          <g transform="translate(400 196)">
            <rect width="54" height="30" rx="6" fill="var(--t1)" />
            <rect x="8" y="9" width="16" height="4" rx="2" fill="var(--t2)" />
            <rect x="8" y="17" width="34" height="4" rx="2" fill="var(--t2)" />
          </g>
        </g>

        {/* three dots, the only thing saying "and it keeps coming" */}
        <circle cx="268" cy="150" r="4" fill="var(--t3)" />
        <circle cx="282" cy="150" r="3" fill="var(--t2)" />
        <circle cx="294" cy="150" r="2.5" fill="var(--t2)" />
      </>
    )
  }

  {
    scene === 'filter' && (
      <>
        {/* what arrives: a wide, loose crowd of cards */}
        <g>
          <rect x="24" y="36" width="58" height="30" rx="5" fill="var(--t2)" transform="rotate(-6 53 51)" />
          <rect x="96" y="28" width="58" height="30" rx="5" fill="var(--t2)" transform="rotate(3 125 43)" />
          <rect x="168" y="34" width="58" height="30" rx="5" fill="var(--t2)" transform="rotate(-4 197 49)" />
          <rect x="240" y="26" width="58" height="30" rx="5" fill="var(--t2)" transform="rotate(5 269 41)" />
          <rect x="312" y="36" width="58" height="30" rx="5" fill="var(--t2)" transform="rotate(-3 341 51)" />
          <rect x="60" y="76" width="58" height="30" rx="5" fill="var(--t3)" transform="rotate(4 89 91)" />
          <rect x="132" y="72" width="58" height="30" rx="5" fill="var(--t3)" transform="rotate(-5 161 87)" />
          <rect x="204" y="78" width="58" height="30" rx="5" fill="var(--t3)" transform="rotate(2 233 93)" />
          <rect x="276" y="74" width="58" height="30" rx="5" fill="var(--t3)" transform="rotate(-6 305 89)" />
        </g>

        {/* the funnel, with a lit face and a shaded one */}
        <path d="M118 124h244l-84 72v46h-76v-46z" fill="var(--t4)" />
        <path d="M118 124h122v192h-38v-46l-84-72z" fill="var(--ink)" opacity="0.14" />
        <rect x="118" y="120" width="244" height="8" rx="4" fill="var(--ink)" />

        {/* what survives, and the only colour in the scene */}
        <g>
          <rect x="196" y="252" width="88" height="34" rx="6" fill="var(--accent)" />
          <rect x="208" y="262" width="26" height="5" rx="2.5" fill="var(--ill-bg)" opacity="0.85" />
          <rect x="208" y="273" width="58" height="4" rx="2" fill="var(--ill-bg)" opacity="0.6" />
        </g>

        {/* what falls away, tumbling out of the sides */}
        <g opacity="0.85">
          <rect x="38" y="212" width="48" height="26" rx="5" fill="var(--t1)" transform="rotate(-22 62 225)" />
          <rect x="88" y="252" width="42" height="22" rx="4" fill="var(--t1)" transform="rotate(16 109 263)" />
          <rect x="384" y="204" width="48" height="26" rx="5" fill="var(--t1)" transform="rotate(24 408 217)" />
          <rect x="356" y="256" width="42" height="22" rx="4" fill="var(--t1)" transform="rotate(-14 377 267)" />
        </g>
      </>
    )
  }

  {
    scene === 'model' && (
      <>
        {/* the scattered ones, still coming in */}
        <g>
          <rect x="28" y="52" width="68" height="34" rx="6" fill="var(--t2)" transform="rotate(-11 62 69)" />
          <rect x="24" y="126" width="68" height="34" rx="6" fill="var(--t2)" transform="rotate(7 58 143)" />
          <rect x="46" y="200" width="68" height="34" rx="6" fill="var(--t2)" transform="rotate(-5 80 217)" />
        </g>

        {/* the stack they are gathered into */}
        <ellipse cx="197" cy="230" rx="72" ry="9" fill="var(--shade)" />
        <g>
          <rect x="134" y="182" width="126" height="40" rx="7" fill="var(--t3)" />
          <rect x="138" y="152" width="118" height="40" rx="7" fill="var(--t3)" />
          <rect x="142" y="122" width="110" height="40" rx="7" fill="var(--t4)" />
          <rect x="146" y="92" width="102" height="42" rx="7" fill="var(--accent)" />
          <rect x="158" y="104" width="34" height="6" rx="3" fill="var(--ill-bg)" opacity="0.85" />
          <rect x="158" y="116" width="66" height="5" rx="2.5" fill="var(--ill-bg)" opacity="0.6" />
        </g>

        {/*
          Beside it, the thing the model never produces: a column of figures,
          greyed out and struck through. It is the credibility claim, drawn.
        */}
        <g opacity="0.55">
          <rect x="316" y="86" width="116" height="152" rx="8" fill="var(--t1)" />
          <rect x="332" y="104" width="38" height="14" rx="3" fill="var(--t3)" />
          <rect x="332" y="128" width="52" height="14" rx="3" fill="var(--t3)" />
          <rect x="332" y="152" width="30" height="14" rx="3" fill="var(--t3)" />
          <rect x="332" y="176" width="60" height="14" rx="3" fill="var(--t3)" />
          <rect x="332" y="200" width="42" height="14" rx="3" fill="var(--t3)" />
        </g>
        <path d="M308 236L440 80" stroke="var(--ink)" stroke-width="5" stroke-linecap="round" />
      </>
    )
  }

  {
    scene === 'written' && (
      <>
        <ellipse cx="240" cy="258" rx="126" ry="11" fill="var(--shade)" />

        {/* one card, and the four lines on it */}
        <rect x="102" y="52" width="276" height="196" rx="12" fill="var(--t2)" />
        <rect x="114" y="64" width="252" height="172" rx="7" fill="var(--ill-bg)" />

        <rect x="136" y="92" width="190" height="9" rx="4.5" fill="var(--t3)" />
        <rect x="136" y="116" width="208" height="9" rx="4.5" fill="var(--t3)" />
        <rect x="136" y="140" width="156" height="9" rx="4.5" fill="var(--t3)" />

        {/*
          The fourth line is drawn rather than set: a stroked path with a
          hand's wobble in it, in the one colour on the card. Three printed
          lines and one that plainly is not.
        */}
        <path
          d="M136 178c18-7 26 6 42 1s22-9 38-4 24 9 40 3 26-8 40-2"
          fill="none"
          stroke="var(--accent)"
          stroke-width="4"
          stroke-linecap="round"
        />

        {/* the pen that made it */}
        <g transform="rotate(38 352 196)">
          <rect x="344" y="150" width="9" height="46" rx="4.5" fill="var(--t4)" />
          <path d="M344 196h9l-4.5 12z" fill="var(--ink)" />
        </g>

        {/* the label it always carries */}
        <rect x="136" y="200" width="58" height="18" rx="9" fill="var(--accent)" opacity="0.24" />
        <rect x="146" y="206" width="38" height="6" rx="3" fill="var(--accent)" />
      </>
    )
  }
</Scene>
