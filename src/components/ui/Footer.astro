---
/**
 * Ft5 · Statement.
 *
 * One display sentence closing the argument the page makes, and nothing else.
 * No provenance line, no link columns, no sitemap.
 */
---

<footer class="foot">
  <div class="foot-inner">
    <p class="line">
      A complaint is only worth acting on once it has happened to enough people, enough times, for
      long enough.
    </p>
  </div>
</footer>

<style>
  .foot {
    margin-top: var(--section-gap);
    background: var(--m-surface-container-lowest);
  }

  .foot-inner {
    padding: var(--space-3xl) var(--page-gutter) var(--space-2xl);
  }

  /* The closing sentence, at display size. Roman, never italic. */
  .line {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 4vw, 2.75rem);
    line-height: 1.14;
    letter-spacing: -0.028em;
    font-weight: 500;
    /* em, not ch: a ch measure is the width of the "0" glyph, which differs
       between Geist and any fallback, so it reflowed the instant the web font
       arrived. em tracks the same clamped display size without that. */
    max-width: 17.23em;
    text-wrap: balance;
  }
</style>
