---
/**
 * Search, on ⌘K or Ctrl+K.
 *
 * Twenty-five challenges across fifteen apps and no search anywhere on the site
 * — that is a gap, not a flourish. Everything is indexed at build time into a
 * small JSON payload; there is no network request and no search service.
 *
 * Built on the native <dialog>, which gives the modal focus trap, the Escape
 * handler and the inert background for free.
 */
import { getProblems, getProduct, getProductsWithProblems } from '../../lib/data';
import { url } from '../../lib/url';
import EmptyMark from './art/EmptyMark.astro';

interface Entry {
  title: string;
  /** Shown under the title: the app, the category, or the page's role. */
  meta: string;
  href: string;
  kind: 'Problem' | 'App' | 'Page';
  /** Everything matched against, lower-cased, joined. */
  haystack: string;
}

const problems: Entry[] = getProblems().map((p) => {
  const app = getProduct(p.productSlug)?.name ?? p.productSlug;
  return {
    title: p.title,
    meta: `${app} · ${p.category}`,
    href: url(`/challenges/${p.slug}`),
    kind: 'Problem',
    haystack: `${p.title} ${app} ${p.category} ${p.verdict}`.toLowerCase(),
  };
});

const apps: Entry[] = getProductsWithProblems().map((product) => ({
  title: product.name,
  meta: product.category,
  href: url(`/products/${product.slug}`),
  kind: 'App',
  haystack: `${product.name} ${product.category}`.toLowerCase(),
}));

const pages: Entry[] = [
  { title: 'Today', meta: 'The latest scan', href: url('/'), kind: 'Page', haystack: 'today home latest scan' },
  { title: 'Apps', meta: 'Every tracked app', href: url('/apps'), kind: 'Page', haystack: 'apps tracked index' },
  { title: 'Methodology', meta: 'How the score is computed', href: url('/how-it-works'), kind: 'Page', haystack: 'methodology score formula how it works threshold verdict' },
  { title: 'Every scan', meta: 'Inside How it works', href: url('/how-it-works#every-scan'), kind: 'Page', haystack: 'archive scans runs history funnel coverage' },
  { title: 'About', meta: 'What this is', href: url('/about'), kind: 'Page', haystack: 'about why store reviews' },
];

const index = [...problems, ...apps, ...pages];
---

<dialog class="palette" data-palette aria-label="Search">
  <form method="dialog" class="inner">
    <div class="field">
      <input
        type="search"
        data-palette-input
        placeholder="Search challenges, apps and pages"
        aria-label="Search challenges, apps and pages"
        autocomplete="off"
        spellcheck="false"
      />
      <kbd>Esc</kbd>
    </div>

    <p class="status num" data-palette-status aria-live="polite">{index.length} results</p>

    <ul class="results" data-palette-results role="listbox" aria-label="Results"></ul>

    <p class="empty" data-palette-empty hidden>
      <EmptyMark kind="search" size={22} />
      <span>Nothing matches that.</span>
    </p>
  </form>

  <script is:inline type="application/json" data-palette-index set:html={JSON.stringify(index)} />
</dialog>

<style>
  .palette {
    width: min(38rem, calc(100vw - 2 * var(--page-gutter)));
    max-height: min(32rem, 80vh);
    padding: 0;
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--r-card);
    background: var(--color-paper-2);
    color: var(--color-ink);
    /* Sits a little above centre: a palette pinned to the middle of a tall
       screen reads as a dialog, not as a tool. */
    margin: 12vh auto auto;
    overflow: hidden;
  }

  .palette::backdrop {
    background: color-mix(in oklch, var(--color-paper) 70%, transparent);
    backdrop-filter: blur(3px);
  }

  .inner {
    display: grid;
    grid-template-rows: auto auto minmax(0, 1fr);
    max-height: inherit;
  }

  .field {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md);
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }

  input {
    flex: 1 1 auto;
    min-width: 0;
    font: inherit;
    font-size: var(--text-md);
    color: var(--color-ink);
    background: none;
    border: 0;
    outline: none;
  }

  input::placeholder {
    color: var(--color-muted);
  }

  kbd {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--r-cell);
    padding: 1px var(--space-2xs);
  }

  .status {
    padding: var(--space-2xs) var(--space-md);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .results {
    list-style: none;
    margin: 0;
    padding: 0 0 var(--space-xs);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .results :global(li) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-sm);
    padding: var(--space-xs) var(--space-md);
    cursor: pointer;
  }

  .results :global(li[aria-selected='true']) {
    background: color-mix(in oklch, var(--color-ink) 9%, transparent);
  }

  .results :global(.r-title) {
    font-size: var(--text-sm);
    line-height: 1.3;
  }

  .results :global(.r-meta) {
    display: block;
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .results :global(.r-kind) {
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .empty {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-md);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  @media (prefers-reduced-motion: no-preference) {
    .palette[open] {
      /*
       * Two animations, not one. The scale is a size change and takes a
       * spring; the fade is a fade and must not overshoot, or the dialog
       * flashes past full opacity on the way in.
       */
      animation:
        palette-scale var(--dur-spatial-fast) var(--spatial-fast),
        palette-fade var(--dur-effects-fast) var(--effects-fast);
    }
  }

  @keyframes palette-scale {
    from {
      transform: scale(0.96);
    }
  }

  @keyframes palette-fade {
    from {
      opacity: 0;
    }
  }
</style>
