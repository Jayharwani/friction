---
/**
 * One of the four things you could do with a challenge.
 *
 * Four of these used to stand side by side with everything open: about
 * seventy words each, 280 at once, and nowhere for the eye to land. The card
 * is a door now, not a document. Collapsed it is a picture, a label, a
 * proposition and one link — about fifteen words — and the rest is one click
 * away.
 *
 * Not a word of the writing changed. The specifics and the limitation are
 * exactly as they were; they are behind a summary instead of above the fold.
 *
 * The accordion is `<details name>`, which the browser makes exclusive on its
 * own: opening one closes the others with no JavaScript at all. Where that is
 * not supported the four open independently, which is the old behaviour and a
 * perfectly good fallback.
 */
import LensScene, { type Lens } from './art/LensScene.astro';
import Chip from './Chip.astro';

interface Props {
  lens: Lens;
  proposition: string;
  specifics: string[];
  limitation: string;
  writtenBy: string;
  writtenAt: string;
  /** Cards sharing a group are mutually exclusive. One per page section. */
  group?: string;
}

const {
  lens,
  proposition,
  specifics,
  limitation,
  writtenBy,
  writtenAt,
  group = 'lens',
} = Astro.props;

const LABEL: Record<Lens, string> = {
  build: 'Build it',
  start: 'Start it',
  study: 'Study it',
  write: 'Write it',
};
---

<article class="lens written-text" data-lens={lens}>
  <div class="art">
    <LensScene lens={lens} />
    <span class="badge">
      <Chip kind="badge" title={`Written by ${writtenBy} on ${writtenAt}`}>written</Chip>
    </span>
  </div>

  <div class="body">
    <p class="label">{LABEL[lens].toUpperCase()}</p>
    <p class="prop">{proposition}</p>

    <details name={group} class="more">
      <summary>
        <span class="see">See how</span>
        <span class="n num">{specifics.length} points</span>
      </summary>

      <div class="inner">
        <ul class="specifics">
          {specifics.map((s) => <li>{s}</li>)}
        </ul>

        <p class="limit">
          <span class="l-label">Why it might not work</span>
          {limitation}
        </p>
      </div>
    </details>
  </div>
</article>

<style>
  .lens {
    display: grid;
    align-content: start;
    overflow: hidden;
    border-radius: var(--shape-xl);
    background: var(--m-surface-container-high);
  }

  /* The picture gets the top of the card, edge to edge. */
  .art {
    position: relative;
  }

  /*
   * Positioned by a wrapper this component owns rather than by a class
   * handed to the Chip: a scoped rule does not reliably reach the root of
   * another component, and the badge landed top-left instead of top-right.
   */
  .badge {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    display: inline-flex;
  }

  .body {
    display: grid;
    align-content: start;
    gap: var(--space-2xs);
    padding: var(--space-lg);
  }

  .label {
    font-size: var(--label-sm);
    letter-spacing: 0.08em;
    color: var(--m-on-surface-variant);
  }

  .prop {
    font-size: var(--title-md);
    font-weight: 500;
    line-height: var(--line-title);
    text-wrap: pretty;
  }

  /* ---- the door ---- */

  summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    min-height: var(--tap);
    margin-top: var(--space-2xs);
    font-size: var(--label-lg);
    font-weight: var(--weight-emphasis);
    letter-spacing: var(--track-emphasis);
    color: var(--m-primary);
    cursor: pointer;
    list-style: none;
    width: fit-content;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover .see {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  summary:focus-visible {
    outline: 3px solid var(--m-primary);
    outline-offset: 2px;
    border-radius: var(--shape-xs);
  }

  .n {
    font-weight: 400;
    color: var(--m-on-surface-variant);
  }

  .n::before {
    content: '· ';
  }

  .more[open] .see::after {
    content: ' less';
  }

  .more[open] .see {
    font-size: 0;
  }

  .more[open] .see::after {
    font-size: var(--label-lg);
  }

  .inner {
    display: grid;
    gap: var(--space-sm);
    padding-top: var(--space-sm);
  }

  .specifics {
    display: grid;
    gap: var(--space-2xs);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .specifics li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-xs);
    font-size: var(--body-md);
    line-height: var(--line-body);
    color: var(--m-on-surface-variant);
  }

  .specifics li::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--lens);
    translate: 0 0.55em;
  }

  /*
   * The honest half, on the brightest surface in the card. Brightest means
   * most important in this system, and on a card whose job is to propose
   * something, the reason it might not work is the most important thing on
   * it. Not a footnote and not smaller than what it qualifies.
   */
  .limit {
    padding: var(--space-md);
    border-radius: var(--shape-lg);
    background: var(--m-surface-container-highest);
    font-size: var(--body-md);
    line-height: var(--line-body);
    color: var(--m-on-surface-variant);
    text-wrap: pretty;
  }

  .l-label {
    display: block;
    margin-bottom: var(--space-2xs);
    font-size: var(--label-lg);
    font-weight: var(--weight-emphasis);
    letter-spacing: var(--track-emphasis);
    color: var(--m-tertiary);
  }

  @media (prefers-reduced-motion: no-preference) {
    .lens {
      transition: background-color var(--dur-effects-fast) var(--effects-fast);
    }

    .lens:hover {
      background: var(--m-surface-container-highest);
    }

    @supports (interpolate-size: allow-keywords) and (selector(::details-content)) {
      .more {
        interpolate-size: allow-keywords;
      }

      .more::details-content {
        block-size: 0;
        overflow: hidden;
        transition:
          block-size var(--dur-spatial-default) var(--spatial-default),
          content-visibility var(--dur-spatial-default) allow-discrete;
      }

      .more[open]::details-content {
        block-size: auto;
      }
    }
  }
</style>
