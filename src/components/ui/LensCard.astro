---
/**
 * One of the four things you could do with a challenge.
 *
 * Every card carries the same "written" badge the gap block uses, because
 * these four are the only written content on the site and the labelling is
 * the point rather than a disclaimer.
 *
 * The limitation is not a footnote. It sits on its own, under a rule, in the
 * same size as the rest — a card that names why it might fail is the one a
 * reader believes, and burying that line would waste the only thing that
 * separates these from every other generated idea list.
 */
import LensMark, { type Lens } from './art/LensMark.astro';

interface Props {
  lens: Lens;
  proposition: string;
  specifics: string[];
  limitation: string;
  writtenBy: string;
  writtenAt: string;
}

const { lens, proposition, specifics, limitation, writtenBy, writtenAt } = Astro.props;

const TITLE: Record<Lens, string> = {
  build: 'Build it',
  start: 'Start it',
  study: 'Study it',
  write: 'Write it',
};

const FOR: Record<Lens, string> = {
  build: 'For designers, PMs and engineers',
  start: 'For founders',
  study: 'For students and researchers',
  write: 'For writers',
};
---

<article class="lens written-text" data-lens={lens}>
  <header>
    <LensMark lens={lens} size={40} />
    <div>
      <h3>{TITLE[lens]}</h3>
      <p class="who">{FOR[lens]}</p>
    </div>
    <span class="written" title={`Written by ${writtenBy} on ${writtenAt}`}>written</span>
  </header>

  <p class="prop">{proposition}</p>

  <ul class="specifics">
    {specifics.map((s) => <li>{s}</li>)}
  </ul>

  <p class="limit">
    <span class="l-label">Why it might not work</span>
    {limitation}
  </p>
</article>

<style>
  .lens {
    display: grid;
    align-content: start;
    gap: var(--space-sm);
    padding: var(--space-xl);
    border-radius: var(--shape-xl);
    background: var(--m-surface-container-high);
  }

  header {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-sm);
  }

  h3 {
    font-size: var(--title-md);
    font-weight: var(--weight-emphasis);
    letter-spacing: var(--track-emphasis);
    line-height: var(--line-title);
  }

  .who {
    margin-top: 2px;
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  /* The same badge the gap block carries. Kept exactly as it is. */
  .written {
    align-self: start;
    font-size: var(--text-xs);
    font-weight: 500;
    line-height: 1;
    padding: 0.25em 0.5em;
    border-radius: var(--r-pill);
    border: var(--rule-hair) solid color-mix(in oklab, var(--lens) 55%, transparent);
    color: var(--color-muted);
    cursor: help;
  }

  .prop {
    font-size: var(--title-md);
    font-weight: 500;
    line-height: var(--line-title);
    text-wrap: pretty;
  }

  .specifics {
    display: grid;
    gap: var(--space-2xs);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .specifics li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-xs);
    font-size: var(--body-md);
    line-height: var(--line-body);
    color: var(--color-muted);
  }

  .specifics li::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--lens);
    translate: 0 0.55em;
  }

  /*
   * The honest half. On its own, above a rule, at full size — not a
   * footnote and not smaller than the proposition it qualifies.
   */
  /*
   * The honest half, on the brightest surface in the card. Brightest means
   * most important, and on a card whose job is to propose something, the
   * reason it might not work is the most important thing on it.
   */
  .limit {
    margin-top: var(--space-xs);
    padding: var(--space-md);
    border-radius: var(--shape-lg);
    background: var(--m-surface-container-highest);
    font-size: var(--text-sm);
    line-height: 1.45;
    color: var(--color-muted);
    text-wrap: pretty;
  }

  .l-label {
    display: block;
    margin-bottom: var(--space-2xs);
    font-size: var(--label-lg);
    font-weight: var(--weight-emphasis);
    letter-spacing: var(--track-emphasis);
    color: var(--m-tertiary);
  }

  @media (prefers-reduced-motion: no-preference) {
    .lens {
      transition:
        translate var(--dur-spatial-fast) var(--spatial-fast),
        background-color var(--dur-effects-fast) var(--effects-fast);
    }

    .lens:hover {
      translate: 0 -2px;
      background: var(--m-surface-container-highest);
    }
  }
</style>
