---
/**
 * One problem shown in full, on the homepage.
 *
 * Rather than explaining what a "problem" is, show one completely: title,
 * summary, the counts behind it, a real quote with its provenance, and the
 * verdict. A stranger learns the shape of the whole site from this block.
 *
 * Set apart by space and two hairlines. Not a card.
 */
import type { Problem } from '../../scripts/validate';
import { url } from '../lib/url';
import { formatDate, platformsLabel } from '../lib/data';
import { VERDICT_GLOSS } from '../lib/scoring';
import { weeklySeries } from '../lib/charts';
import Sparkline from './charts/Sparkline.astro';

interface Props {
  problem: Problem;
  productName: string;
}

const { problem, productName } = Astro.props;

// The freshest evidence: this block is about what is happening now.
const quote = [...problem.evidence].sort((a, b) => b.reviewedAt.localeCompare(a.reviewedAt))[0]!;

const reviews = problem.evidence.length;
const weeks = problem.inputs.weeksWithEvidence;
const reviewers = problem.inputs.uniqueReviewers;

const series = weeklySeries(problem.evidence);

const stats = [
  `${reviewers} distinct ${reviewers === 1 ? 'reviewer' : 'reviewers'}`,
  `${weeks} ${weeks === 1 ? 'week' : 'weeks'} running`,
  platformsLabel(problem.platforms),
];

const COUNTRY: Record<string, string> = {
  us: 'United States',
  gb: 'United Kingdom',
  ca: 'Canada',
  au: 'Australia',
  nz: 'New Zealand',
  ie: 'Ireland',
  sg: 'Singapore',
};
---

<section class="specimen bleed" aria-labelledby="specimen-heading">
  <h2 id="specimen-heading" class="teach-head">What one problem looks like</h2>

  <div class="annotated">
  <p class="label">The problem with the most evidence</p>

  <p class="app">
    <a href={url(`/products/${problem.productSlug}`)}>{productName}</a>
  </p>

  <h3 id="specimen-title" data-part="title">
    <a href={url(`/challenges/${problem.slug}`)}>{problem.title}</a>
    <span class="callout" data-for="title">A complaint many people made separately</span>
  </h3>

  <p class="summary">{problem.summary}</p>

  <div class="stat-row">
    <ul class="stats num">
      {stats.map((s) => <li>{s}</li>)}
    </ul>
    <Sparkline series={series} label={`${series.total} of these ${series.total === 1 ? 'review' : 'reviews'} arrived in the last twelve weeks.`} />
  </div>

  <figure class="quote-block" data-part="quote">
    <span class="callout" data-for="quote">Their own words, with the app version and date</span>
    <blockquote>{quote.quote}</blockquote>
    <figcaption class="num">
      {quote.platform === 'ios' ? 'iOS' : 'Android'},{' '}
      {quote.version ? `version ${quote.version}` : 'version not reported'},{' '}
      {quote.rating} {quote.rating === 1 ? 'star' : 'stars'},{' '}
      {COUNTRY[quote.country] ?? quote.country.toUpperCase()},{' '}
      <time datetime={quote.reviewedAt}>{formatDate(quote.reviewedAt)}</time>
    </figcaption>
  </figure>

  <p class="verdict" data-part="verdict">
    {problem.verdict}
    <span class="gloss"> — {VERDICT_GLOSS[problem.verdict]}</span>
    <span class="callout" data-for="verdict">Whether there is enough evidence to act on</span>
  </p>
  <p class="score num" data-part="score">
    evidence score {problem.score} of 100
    <span class="callout" data-for="score">How much evidence, out of 100</span>
  </p>

  <p class="more">
    <a href={url(`/challenges/${problem.slug}`)}>
      See all {reviews} {reviews === 1 ? 'review' : 'reviews'} and how this score was calculated
    </a>
  </p>
  </div>

  {/*
    The same four labels as a definition list, for narrow screens where the
    leader lines have nowhere to go, and for anyone reading the page linearly.
  */}
  <dl class="key">
    <div><dt>The title</dt><dd>A complaint many people made separately</dd></div>
    <div><dt>The quote</dt><dd>Their own words, with the app version and date</dd></div>
    <div><dt>The score</dt><dd>How much evidence, out of 100</dd></div>
    <div><dt>The verdict</dt><dd>Whether there is enough evidence to act on</dd></div>
  </dl>
</section>

<style>

  /* ---- the teaching layer ---- */

  .teach-head {
    font-size: var(--text-lg);
    font-weight: 600;
    margin-bottom: var(--space-lg);
  }

  /*
   * Callouts are visible by default, never on hover. Someone who does not
   * know what a verdict is does not know to hover over it.
   *
   * Below 60rem they are hidden and the definition list below carries the
   * same four labels, because a leader line needs a margin to live in.
   */
  .callout {
    display: none;
  }

  .key {
    margin: var(--space-lg) 0 0;
    display: grid;
    gap: var(--space-xs);
    font-size: var(--text-sm);
  }

  .key > div {
    display: grid;
    grid-template-columns: minmax(0, 7rem) minmax(0, 1fr);
    gap: var(--space-sm);
    padding-top: var(--space-xs);
    border-top: var(--rule-hair) solid var(--color-rule);
  }

  .key dt {
    color: var(--color-muted);
  }

  .key dd {
    margin: 0;
  }

  @media (min-width: 60rem) {
    /* The card keeps the measure; the callouts live in the margin beside it. */
    .annotated {
      position: relative;
      max-width: var(--measure);
    }

    .callout {
      display: block;
      position: absolute;
      left: calc(100% + var(--space-2xl));
      width: 13rem;
      font-size: var(--text-xs);
      color: var(--color-muted);
      text-wrap: pretty;
    }

    /* The leader: a hairline from the part to its label. */
    .callout::before {
      content: '';
      position: absolute;
      right: 100%;
      top: 0.5em;
      width: var(--space-2xl);
      height: var(--rule-hair);
      background: var(--color-rule);
    }

    [data-part] {
      position: static;
    }

    /* Each callout is placed against the part it names. */
    [data-part] {
      position: relative;
    }

    /*
     * The verdict and the score sit two lines apart, so their labels would
     * land on top of each other. Pull one up and push the other down, and
     * lengthen the leaders to match the diagonal they now travel.
     */
    [data-part='verdict'] .callout {
      top: -0.9em;
    }

    [data-part='score'] .callout {
      top: 1.1em;
    }

    .key {
      display: none;
    }
  }

  .specimen {
    border-top: var(--rule-hair) solid var(--color-rule);
    border-bottom: var(--rule-hair) solid var(--color-rule);
    padding-block: var(--space-lg) var(--space-xl);
  }

  /* Sentence case, normal tracking. Not a tracked-out all-caps eyebrow. */
  .label {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .app {
    margin-top: var(--space-sm);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  h3 {
    margin-top: var(--space-2xs);
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.2vw, 1.9rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.012em;
  }

  h3 a {
    text-decoration: none;
  }

  h3 a:hover {
    text-decoration: underline;
    text-underline-offset: 0.14em;
  }

  .summary {
    margin-top: var(--space-sm);
    color: var(--color-ink);
  }

  /* Plain figures separated by hairlines, not pills. */
  .stat-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-lg);
  }

  .stats {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    margin: var(--space-md) 0 0;
    padding: 0;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .stats li + li {
    margin-left: var(--space-sm);
    padding-left: var(--space-sm);
    border-left: var(--rule-hair) solid var(--color-rule);
  }

  .quote-block {
    margin: var(--space-lg) 0 0;
    border-left: 2px solid var(--color-rule);
    padding-left: var(--space-md);
  }

  blockquote {
    margin: 0;
    font-family: var(--font-quote);
    font-size: var(--text-lg);
    line-height: 1.5;
  }

  figcaption {
    margin-top: var(--space-xs);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .verdict {
    margin-top: var(--space-lg);
    font-size: var(--text-md);
    font-weight: 500;
  }

  .gloss {
    font-weight: 400;
    color: var(--color-muted);
  }

  .score {
    margin-top: var(--space-2xs);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  /* Standalone targets, not links in a sentence. */
  @media (pointer: coarse) {
    .app a,
    .more a {
      display: inline-flex;
      align-items: center;
      min-height: var(--tap);
    }
  }

  .more {
    margin-top: var(--space-md);
    font-size: var(--text-sm);
  }

  @media (max-width: 34rem) {
    .specimen {
      padding-block: var(--space-md) var(--space-lg);
    }

    .app {
      margin-top: var(--space-xs);
    }
  }
</style>
