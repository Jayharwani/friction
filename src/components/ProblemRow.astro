---
/**
 * One problem in a list. A ledger row separated by a hairline — no card, no
 * border, no shadow.
 *
 * No sparkline, no score and no verdict number: what a reader needs from a
 * row is which challenge it is and how widely it was reported. The rest is
 * on /how-it-works.
 *
 * The whole row is clickable via a stretched pseudo-element on the title link,
 * which keeps exactly one link per row in the accessibility tree.
 */
import type { Problem } from '../../scripts/validate';
import { url } from '../lib/url';
import { platformsLabel } from '../lib/data';
import { getChallenge, surfaceLabel } from '../lib/data';

interface Props {
  problem: Problem;
}

const { problem } = Astro.props;
const reviews = problem.evidence.length;
const title = getChallenge(problem.slug)?.humanTitle ?? problem.title;
---

<article class="row">
  <div class="body">
    <h3>
      <a href={url(`/challenges/${problem.slug}`)} transition:name={`title-${problem.slug}`}>
        {title}
      </a>
    </h3>
    <p class="meta num">
      {problem.category}, {platformsLabel(problem.platforms)}, {reviews}{' '}
      {reviews === 1 ? 'review' : 'reviews'}
    </p>
  </div>

  <div class="figures">
    <p class="reach meta">{surfaceLabel(problem)}</p>
  </div>
</article>

<style>
  .row {
    position: relative;
    border-top: var(--rule-hair) solid var(--color-rule);
    padding: var(--space-md) var(--space-sm);
    /* Cancel the gutter so text still aligns to the column edge. */
    margin-inline: calc(var(--space-sm) * -1);
    display: flex;
    gap: var(--space-lg);
    align-items: baseline;
    justify-content: space-between;
  }

  /* A surface shift, never a transform or a shadow. */
  .row:has(a:hover),
  .row:has(a:focus-visible) {
    background: color-mix(in oklch, var(--color-ink) 5%, transparent);
  }

  .body {
    min-width: 0;
    /* Takes the slack, so the label column stays a fixed width. */
    flex: 1 1 auto;
  }

  h3 {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.008em;
  }

  h3 a {
    text-decoration: none;
  }

  /* Stretches the link over the whole row without nesting interactive
     elements or duplicating the link for a screen reader. */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  h3 a:hover {
    text-decoration: underline;
    text-underline-offset: 0.16em;
  }

  .meta {
    margin-top: var(--space-2xs);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .figures {
    flex: none;
    text-align: right;
    /* Fixed, so "Early signal" and "Widely reported" do not move the column
       edge between one row and the next. */
    min-width: 9em;
  }

  /* The word the score became. Not a verdict — that name belongs to the
     pipeline's own four, which are on /how-it-works. */
  .reach {
    font-size: var(--text-md);
    font-weight: 500;
    white-space: nowrap;
  }

  @media (max-width: 34rem) {
    .row {
      flex-direction: column;
      gap: var(--space-xs);
    }

    .figures {
      text-align: left;
      display: flex;
      align-items: baseline;
      gap: var(--space-sm);
      min-width: 0;
    }

  }
</style>
