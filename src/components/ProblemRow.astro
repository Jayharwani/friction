---
/**
 * One problem in a list. A ledger row separated by a hairline, not a rounded
 * card with a soft grey shadow (spec 6.2 names those as a tell).
 *
 * The verdict is always a word and the platform is always set in type; neither
 * is ever carried by colour alone.
 */
import type { Problem } from '../../scripts/validate';
import { url } from '../lib/url';
import { platformsLabel } from '../lib/data';

interface Props {
  problem: Problem;
  /** Hide the score when the surrounding list is already ordered by it. */
  showScore?: boolean;
}

const { problem, showScore = true } = Astro.props;
---

<article class="row">
  <div class="body">
    <h3>
      <a href={url(`/problems/${problem.slug}`)}>{problem.title}</a>
    </h3>
    <p class="meta">
      {problem.category}, {platformsLabel(problem.platforms)}, {problem.evidence.length}{' '}
      {problem.evidence.length === 1 ? 'review' : 'reviews'}
    </p>
  </div>

  <div class="figures">
    {showScore && <p class="score num">{problem.score}</p>}
    <p class="verdict">{problem.verdict}</p>
  </div>
</article>

<style>
  .row {
    border-top: 1px solid var(--rule);
    padding-block: 0.95rem;
    display: flex;
    gap: 1.5rem;
    align-items: baseline;
    justify-content: space-between;
  }

  .body {
    min-width: 0;
  }

  h3 {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.008em;
  }

  h3 a {
    text-decoration: none;
  }

  h3 a:hover {
    text-decoration: underline;
    text-underline-offset: 0.16em;
  }

  .meta {
    margin-top: 0.25rem;
    color: var(--muted);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }

  .figures {
    flex: none;
    text-align: right;
  }

  .score {
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.1;
  }

  .verdict {
    font-size: var(--text-xs);
    color: var(--muted);
    margin-top: 0.1rem;
    white-space: nowrap;
  }
</style>
