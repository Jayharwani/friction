---
/**
 * One problem in a list. A ledger row separated by a hairline — no card, no
 * border, no shadow.
 *
 * The verdict carries the meaning for a first-time reader and the number does
 * not, so the word is set at body size and the score is secondary. Both are
 * words-first: the verdict is never carried by colour.
 *
 * The whole row is clickable via a stretched pseudo-element on the title link,
 * which keeps exactly one link per row in the accessibility tree.
 */
import type { Problem } from '../../scripts/validate';
import { url } from '../lib/url';
import { platformsLabel } from '../lib/data';
import { weeklySeries } from '../lib/charts';
import { TERMS } from '../lib/terms';
import Sparkline from './charts/Sparkline.astro';
import Term from './Term.astro';

interface Props {
  problem: Problem;
  /**
   * Mark the verdict and the score with their definitions. Set on the first
   * row of a list only: a page where all twenty-five rows carry a dotted
   * underline is noise.
   */
  teach?: boolean;
}

const { problem, teach = false } = Astro.props;
const reviews = problem.evidence.length;

// Twelve weeks of this problem's evidence, between the metadata and the
// verdict. It is what turns a list of titles into something scannable.
const series = weeklySeries(problem.evidence);
---

<article class="row">
  <div class="body">
    <h3>
      <a href={url(`/challenges/${problem.slug}`)} transition:name={`title-${problem.slug}`}>
        {problem.title}
      </a>
    </h3>
    <p class="meta num">
      {problem.category}, {platformsLabel(problem.platforms)}, {reviews}{' '}
      {reviews === 1 ? 'review' : 'reviews'}
    </p>
  </div>

  <div class="trend">
    <Sparkline series={series} />
  </div>

  <div class="figures">
    <p class="verdict">
      {
        teach ? (
          <Term label={problem.verdict} definition={TERMS[problem.verdict] ?? ''} />
        ) : (
          problem.verdict
        )
      }
    </p>
    <p class="score num">
      {teach ? <Term label="evidence score" definition={TERMS.score!} /> : 'evidence score'}
      {' '}{problem.score}
    </p>
  </div>
</article>

<style>
  .row {
    position: relative;
    border-top: var(--rule-hair) solid var(--color-rule);
    padding: var(--space-md) var(--space-sm);
    /* Cancel the gutter so text still aligns to the column edge. */
    margin-inline: calc(var(--space-sm) * -1);
    display: flex;
    gap: var(--space-lg);
    align-items: baseline;
    justify-content: space-between;
  }

  /* A surface shift, never a transform or a shadow. */
  .row:has(a:hover),
  .row:has(a:focus-visible) {
    background: color-mix(in oklch, var(--color-ink) 5%, transparent);
  }

  .body {
    min-width: 0;
    /* Takes the slack, so the sparkline and figures stay a fixed width. */
    flex: 1 1 auto;
  }

  /* Between the metadata and the verdict, aligned with the baseline of both. */
  .trend {
    flex: none;
    translate: 0 0.35em;
  }

  @media (max-width: 52rem) {
    .trend {
      display: none;
    }
  }

  h3 {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.008em;
  }

  h3 a {
    text-decoration: none;
  }

  /* Stretches the link over the whole row without nesting interactive
     elements or duplicating the link for a screen reader. */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  h3 a:hover {
    text-decoration: underline;
    text-underline-offset: 0.16em;
  }

  .meta {
    margin-top: var(--space-2xs);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .figures {
    flex: none;
    text-align: right;
    /* Fixed, so "Thin evidence" and "Recurring" do not move the sparkline
       column between one row and the next. */
    min-width: 7.5em;
  }

  /* The word first, at full opacity. */
  .verdict {
    font-size: var(--text-md);
    font-weight: 500;
    white-space: nowrap;
  }

  .score {
    margin-top: var(--space-2xs);
    font-size: var(--text-xs);
    color: var(--color-muted);
    white-space: nowrap;
  }

  @media (max-width: 34rem) {
    .row {
      flex-direction: column;
      gap: var(--space-xs);
    }

    .figures {
      text-align: left;
      display: flex;
      align-items: baseline;
      gap: var(--space-sm);
      min-width: 0;
    }

    /* Back on a phone, under the metadata where there is room for it. */
    .trend {
      display: block;
      translate: 0;
    }

    .score {
      margin-top: 0;
    }
  }
</style>
