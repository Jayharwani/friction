---
/**
 * The score, the verdict, and the full derivation.
 *
 * Spec 6.1 calls this the single most important interaction in the product, so
 * it is built on a native <details>: keyboard-operable with no JavaScript, and
 * it animates only its own opening.
 *
 * Every row states its raw input in words and its weight, and the rows sum to
 * the published score — so a reader can check the arithmetic on the page
 * rather than taking the number on trust.
 */
import type { Problem } from '../../scripts/validate';
import { componentRows } from '../lib/scoring';

interface Props {
  problem: Problem;
}

const { problem } = Astro.props;
const rows = componentRows(problem.components, problem.inputs);
const total = rows.reduce((sum, r) => sum + r.contribution, 0);

/** One hue: the bar fills from the surface toward the accent, in OKLCH. */
const mix = (value: number) =>
  `color-mix(in oklch, var(--accent) ${Math.round(15 + value * 85)}%, var(--surface))`

const verdictNote: Record<string, string> = {
  'Strong signal': `scored at or above the current threshold of ${problem.buildThreshold.toFixed(0)}`,
  Recurring: `below the current threshold of ${problem.buildThreshold.toFixed(0)}`,
  'Already solved': `${problem.existingSolutions.length} existing products already address this`,
  'Thin evidence': `only ${problem.inputs.uniqueReviewers} distinct ${problem.inputs.uniqueReviewers === 1 ? 'reviewer' : 'reviewers'}, fewer than the 4 required`,
};
---

<section class="panel" aria-labelledby="score-heading">
  <h2 id="score-heading" class="sr-only">Score</h2>

  <p class="score">{problem.score}</p>
  <p class="verdict">{problem.verdict}</p>
  <p class="verdict-note">{verdictNote[problem.verdict]}</p>

  <details class="disclosure">
    <summary>
      <span class="summary-label">How this score is calculated</span>
    </summary>

    <div class="disclosure-body">
      <p class="preamble">
        Seven components, each scored from 0 to 1 and multiplied by its weight. The model that
        reads the reviews never produces a number; every figure below is computed in code.
      </p>

      <ol class="components">
        {
          rows.map((row, i) => (
            <li>
              <div class="row-head">
                <span class="row-label">{row.label}</span>
                <span class="row-weight num">weight {Math.round(row.weight * 100)}%</span>
              </div>

              <div class="track" aria-hidden="true">
                <div class="fill" style={`width:${row.value * 100}%;background:${mix(row.value)};--row:${i}`} />
              </div>

              <p class="row-detail">{row.detail}</p>
              <p class="row-math num">
                {row.value.toFixed(2)} × {Math.round(row.weight * 100)} ={' '}
                {row.contribution.toFixed(1)} of {Math.round(row.weight * 100)} points
              </p>
            </li>
          ))
        }
      </ol>

      <p class="total num">
        Total {total.toFixed(1)}, rounded to <strong>{problem.score}</strong>
      </p>
    </div>
  </details>
</section>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .panel {
    border-top: 2px solid var(--text);
    padding-top: var(--space-4);
  }

  .score {
    font-size: var(--text-3xl);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .verdict {
    margin-top: var(--space-2);
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: -0.012em;
  }

  .verdict-note {
    margin-top: var(--space-1);
    color: var(--muted);
    font-size: var(--text-sm);
  }

  /* ---- disclosure ---- */

  .disclosure {
    margin-top: var(--space-4);
    border-top: 1px solid var(--rule);
  }

  summary {
    /* Replaced by a custom marker so the control reads as a button-like row. */
    list-style: none;
    cursor: pointer;
    padding-block: var(--space-3);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  /* A plus that becomes a minus. Not an arrow appended to link text. */
  summary::before {
    content: '';
    flex: none;
    width: 0.72rem;
    height: 0.72rem;
    background:
      linear-gradient(currentColor, currentColor) center / 100% 1.5px no-repeat,
      linear-gradient(currentColor, currentColor) center / 1.5px 100% no-repeat;
  }

  .disclosure[open] summary::before {
    background: linear-gradient(currentColor, currentColor) center / 100% 1.5px no-repeat;
  }

  .summary-label {
    text-decoration: underline;
    text-decoration-color: color-mix(in oklch, currentColor 30%, transparent);
    text-underline-offset: 0.18em;
  }

  summary:hover .summary-label {
    text-decoration-color: currentColor;
  }

  .disclosure-body {
    padding-bottom: var(--space-4);
  }

  /* ---- the third animated moment ----

     `interpolate-size: allow-keywords` lets height:auto transition natively,
     so the panel opens without measuring anything in JavaScript.

     It is Chromium-only and not Baseline, so everything here sits behind
     @supports. Without it the panel opens instantly, which is a perfectly
     good outcome and is what most browsers will do today. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (interpolate-size: allow-keywords) and (selector(::details-content)) {
      .disclosure {
        interpolate-size: allow-keywords;
      }

      .disclosure::details-content {
        block-size: 0;
        overflow: hidden;
        transition:
          block-size 240ms cubic-bezier(0.2, 0, 0, 1),
          content-visibility 240ms allow-discrete;
      }

      .disclosure[open]::details-content {
        block-size: auto;
      }

      /* Bars grow from zero as the panel opens, 30ms apart. */
      .disclosure[open] .fill {
        animation: grow 240ms cubic-bezier(0.2, 0, 0, 1) backwards;
        animation-delay: calc(var(--row) * 30ms);
        transform-origin: left center;
      }

      @keyframes grow {
        from {
          transform: scaleX(0);
        }
      }
    }
  }

  .preamble {
    color: var(--muted);
    font-size: var(--text-sm);
    margin-bottom: var(--space-4);
  }

  .components {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }

  .row-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
  }

  .row-label {
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .row-weight {
    font-size: var(--text-xs);
    color: var(--muted);
    white-space: nowrap;
  }

  .track {
    margin-top: var(--space-1);
    height: 6px;
    background: var(--surface);
  }

  .fill {
    height: 100%;
  }

  .row-detail {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--text);
  }

  /* An equation, read digit by digit, so it gets a real monospace. */
  .row-math {
    margin-top: var(--space-1);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .total {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--rule);
    font-size: var(--text-sm);
  }

  .total strong {
    font-weight: 600;
  }
</style>
