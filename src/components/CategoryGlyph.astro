---
/**
 * One drawn mark per family. Eight of them, no icon library.
 *
 * Rules they all follow, so the set reads as a set: a 24-unit box, a 1.5
 * stroke, round caps and joins, no fills, and nothing smaller than about
 * 3 units — detail below that dies at 16px and turns the mark into a smudge.
 *
 * Each one is an object, not an abstraction:
 *   stability     a bolt          speed         a gauge
 *   money         a price tag     data          a store
 *   access        a padlock       wayfinding    a pin
 *   interruption  a bell          support       a speech bubble
 *
 * They were abstractions first — a coin with a slice out of it, a question
 * that goes unanswered — and at 15px those read as typographic characters
 * rather than icons: the coin drew a currency symbol and the question mark
 * collapsed into a box. A glyph that looks like a missing character is worse
 * than no glyph, so every one of them is now a thing you can name.
 *
 * The stroke is `currentColor`, so a parent carrying --cat sets it by
 * writing `color: var(--cat)` once. The mark is aria-hidden by default:
 * the family's name is always set beside it in text.
 */
import { FAMILY_LABEL, type Family } from '../lib/categories';

interface Props {
  family: Family;
  size?: number;
  /** Give the mark a label when no text name sits next to it. */
  labelled?: boolean;
  class?: string;
}

const { family, size = 24, labelled = false, class: klass } = Astro.props;

/* One path set per family. Numbers, not a library. */
const PATHS: Record<Family, string[]> = {
  // A bolt. Not a lightning metaphor for speed — the thing that kills a session.
  stability: ['M13 2.5L5.5 13H11l-1 8.5L18.5 11H13z'],
  // A gauge with its needle down.
  speed: ['M3.5 18.5a9 9 0 1 1 17 0', 'M12 18.5l4.5-5.5', 'M3.5 18.5h2', 'M18.5 18.5h2'],
  // A price tag, hole and all.
  money: ['M3.5 11.5V4.5h7l9.5 9.5-7 7L3.5 11.5z', 'M7.5 8.5v.01'],
  // A store: the shape every sync and data-loss complaint is about.
  data: [
    'M4.5 6.5c0-1.7 3.4-3 7.5-3s7.5 1.3 7.5 3-3.4 3-7.5 3-7.5-1.3-7.5-3z',
    'M4.5 6.5v11c0 1.7 3.4 3 7.5 3s7.5-1.3 7.5-3v-11',
    'M4.5 12c0 1.7 3.4 3 7.5 3s7.5-1.3 7.5-3',
  ],
  // A padlock.
  access: ['M5.5 10.5h13v10h-13z', 'M8.5 10.5V7a3.5 3.5 0 0 1 7 0v3.5'],
  // A pin.
  wayfinding: ['M12 21.5s7-6.3 7-11a7 7 0 1 0-14 0c0 4.7 7 11 7 11z', 'M12 8.6a2 2 0 1 1 0 4 2 2 0 0 1 0-4z'],
  // A bell.
  interruption: ['M6 9.5a6 6 0 0 1 12 0c0 4.8 2 6 2 6H4s2-1.2 2-6z', 'M10 19a2 2 0 0 0 4 0'],
  // A speech bubble.
  support: ['M3.5 4.5h17v11h-9.5l-4.5 3.5v-3.5h-3z'],
};

const label = `${FAMILY_LABEL[family]} challenges`;
---

<svg
  class:list={['glyph', klass]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={labelled ? 'img' : undefined}
  aria-label={labelled ? label : undefined}
  aria-hidden={labelled ? undefined : 'true'}
>
  {/* pathLength normalises every path to 100 so one dash rule covers all eight. */}
  {PATHS[family].map((d) => <path d={d} pathLength="100" />)}
</svg>

<style>
  .glyph {
    display: block;
    flex: none;
  }

  /*
   * The draw-on. Each mark's paths are dashed to their own length and
   * the offset runs to zero, so the mark writes itself rather than
   * fading in. `pathLength` normalises every path to 100 units, which
   * is what lets one rule cover eight marks of different sizes.
   */
  /*
   * The resting state is a finished glyph. The dash lives only inside the
   * keyframe, played `backwards`, so a card whose reveal never fires still
   * shows its mark — holding the undrawn state in the base rule made the
   * glyph depend on an observer to exist at all.
   */
  @media (prefers-reduced-motion: no-preference) {
    :global([data-glyph-draw][data-drawn]) .glyph path {
      animation: glyph-draw var(--dur-spatial-slow) var(--spatial-slow) backwards;
    }

    :global([data-glyph-draw][data-drawn]) .glyph path:nth-child(2) {
      animation-delay: 60ms;
    }
    :global([data-glyph-draw][data-drawn]) .glyph path:nth-child(3) {
      animation-delay: 120ms;
    }
    :global([data-glyph-draw][data-drawn]) .glyph path:nth-child(4) {
      animation-delay: 180ms;
    }
    :global([data-glyph-draw][data-drawn]) .glyph path:nth-child(5) {
      animation-delay: 240ms;
    }
  }

  @keyframes glyph-draw {
    from {
      stroke-dasharray: 100;
      stroke-dashoffset: 100;
    }
  }
</style>
