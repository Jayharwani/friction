---
/**
 * The Friction Field — the signature element.
 *
 * A WebGL topography of the dataset: X is the last twelve weeks, Z is the
 * tracked problems, height is how many reviews reported that problem that
 * week. Ridges are clickable and navigate to the problem they describe, which
 * is what makes the 3D earn its place rather than decorate.
 *
 * Four paths, all of which must produce a complete page:
 *   reduced motion  → one static frame, hover still works
 *   no WebGL        → the 2D heat strip below, plus the list
 *   under 768px     → the 2D heat strip; Three.js never loads
 *   hidden/offscreen→ the frame loop cancels entirely
 */
import { buildField } from '../lib/field';
import { getActiveProblems, getProduct } from '../lib/data';
import HeatStrip from './HeatStrip.astro';

const field = buildField(getActiveProblems(), (slug) => getProduct(slug)?.name ?? slug);

// Serialised for the client: the heights are computed here, at build time.
const payload = JSON.stringify(field);
---

<section class="field" data-field aria-labelledby="field-heading">
  <div class="intro">
    <h2 id="field-heading">Twelve weeks of complaints, by problem</h2>
    {/* One caption per mode: "ridges" is a lie about the 2D strip, and the
        strip is what most visitors see first. */}
    <p class="caption cap-strip">
      Darker cells are problems more people reported that week.
    </p>
    <p class="caption cap-field">
      Taller ridges are problems more people reported that week. Hover one to see which.
    </p>
  </div>

  <div class="stage">
    {/* aria-hidden: the surface is fully duplicated by the problem list below. */}
    <canvas data-field-canvas aria-hidden="true"></canvas>

    {/* The 2D fallback. Shown under 768px and whenever WebGL is unavailable. */}
    <div class="strip" data-field-strip>
      <HeatStrip field={field} />
    </div>

    <div class="label" data-field-label hidden>
      <p class="l-title" data-f-title></p>
      <p class="l-meta num" data-f-meta></p>
    </div>

    {/* The axes, in words. Without them the surface is texture. */}
    <p class="axis axis-x num" aria-hidden="true">
      <span>{field.weekLabels[0]}</span>
      <span class="axis-name">twelve weeks</span>
      <span>{field.weekLabels.at(-1)}</span>
    </p>
    <p class="axis axis-z" aria-hidden="true">
      <span class="axis-name">{field.rows.length} problems</span>
    </p>
  </div>

  <script is:inline type="application/json" data-field-data set:html={payload} />
</section>

<script>
  import type { FieldHandle } from '../scripts/field';

  /*
   * Three.js does not load at all below this. The field is a wide-screen
   * summary; on a phone it is 133KB of JavaScript for something the heat
   * strip says better.
   */
  const MOBILE_MAX = 900;

  /*
   * Never call this on page load.
   *
   * Creating a WebGL context is synchronous and costs whatever the platform's
   * GL stack costs to spin up: measured at 161ms of blocked main thread on a
   * real GPU and 1,140ms under software rendering. The field sits five
   * screens down, so paying that on arrival blocks the page for a surface
   * nobody has scrolled to — and on a machine that has fallen back to
   * software GL it is long enough to read as a frozen tab.
   *
   * It is called from mount(), behind the same observer that gates the
   * import, so the cost lands only when the field is about to be used.
   */
  function hasWebGL(): boolean {
    try {
      const c = document.createElement('canvas');
      const gl = c.getContext('webgl2') ?? c.getContext('webgl');
      if (!gl) return false;

      /*
       * Refuse a software rasteriser.
       *
       * SwiftShader, llvmpipe and ANGLE's software backend all present a
       * working WebGL context and then render every frame on the CPU. On
       * this page that measured a 267ms median frame while scrolling — 2fps
       * — against 17ms on every page without the field. A machine that has
       * fallen back to software GL is exactly the machine that cannot
       * afford a 3D surface, and the heat strip says the same thing for
       * free. This is the likeliest cause of a page that "freezes".
       */
      const info = gl.getExtension('WEBGL_debug_renderer_info');
      const renderer = String(
        (info && gl.getParameter(info.UNMASKED_RENDERER_WEBGL)) || gl.getParameter(gl.RENDERER) || '',
      );
      if (/swiftshader|llvmpipe|softwarerasterizer|software|microsoft basic render/i.test(renderer)) {
        return false;
      }

      return true;
    } catch {
      return false;
    }
  }

  let handle: FieldHandle | null = null;

  async function mount(): Promise<void> {
    handle?.destroy();
    handle = null;

    const section = document.querySelector<HTMLElement>('[data-field]');
    const canvas = document.querySelector<HTMLCanvasElement>('[data-field-canvas]');
    const label = document.querySelector<HTMLElement>('[data-field-label]');
    const raw = document.querySelector<HTMLScriptElement>('[data-field-data]');
    if (!section || !canvas || !label || !raw) return;

    // Under 900px Three.js never loads at all — a phone gets a fast page,
    // not a degraded 3D one.
    if (window.innerWidth < MOBILE_MAX || !hasWebGL()) {
      section.dataset.mode = 'strip';
      return;
    }

    const data = JSON.parse(raw.textContent ?? '{}');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Dynamic: the Three bundle never blocks first paint.
    try {
      const { createField } = await import('../scripts/field');
      handle = createField({
        canvas,
        data,
        label,
        reducedMotion,
        onSelect(slug: string) {
          window.location.href = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/problems/${slug}`;
        },
      });
    } catch {
      // The bundle did not load. The strip is already on screen and stays there.
      return;
    }

    /*
     * Only now does the canvas replace the strip. Switching at arm() time
     * hid a working 2D chart behind an empty canvas for as long as the
     * import took — on this page that is a blank half-screen, which is the
     * single thing a reader is most likely to read as a broken page.
     *
     * Two frames: one for the scene's first render to be issued, one for it
     * to have been painted. The stage is a fixed height, so the swap moves
     * nothing.
     */
    await new Promise(requestAnimationFrame);
    await new Promise(requestAnimationFrame);
    if (handle) section.dataset.mode = 'field';
  }

  /**
   * Wait until the field is near the viewport before importing anything.
   *
   * The field sits below the whole problem list now, five screens down, but
   * the import still ran on arrival — measured as a 647ms long task on a page
   * the visitor had not scrolled. The IntersectionObserver was gating the
   * frame loop; it now gates the 133KB import as well.
   */
  let armed: IntersectionObserver | null = null;

  function arm(): void {
    armed?.disconnect();
    armed = null;

    const section = document.querySelector<HTMLElement>('[data-field]');
    if (!section) return;

    /*
     * The strip is the honest state until a 3D frame actually exists, so it
     * is what every visitor gets first. Narrow visitors keep it, and so does
     * anyone without WebGL — but that is not tested here, because testing it
     * costs a context. mount() decides, once the observer says it matters.
     */
    section.dataset.mode = 'strip';
    if (window.innerWidth < MOBILE_MAX) return;

    armed = new IntersectionObserver(
      (entries, io) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        armed = null;
        void mount();
      },
      // One viewport of warning, so it is ready by the time it is looked at.
      { rootMargin: '100% 0px' },
    );
    armed.observe(section);
  }

  document.addEventListener('astro:page-load', arm);

  // The ramp and the fog come from CSS tokens, so a theme change has to be
  // pushed into the scene. Repainting beats remounting: no reallocation, and
  // the settle does not replay.
  document.addEventListener('friction:themechange', () => handle?.refreshTheme());
  window
    .matchMedia('(prefers-color-scheme: dark)')
    .addEventListener('change', () => {
      if (!document.documentElement.dataset.theme) handle?.refreshTheme();
    });
  document.addEventListener('astro:before-swap', () => {
    armed?.disconnect();
    armed = null;
    handle?.destroy();
    handle = null;
  });
</script>

<style>
  .field {
    position: relative;
    margin-top: var(--section-gap);
  }

  .intro {
    padding: 0 var(--page-gutter);
    max-width: 52rem;
  }

  .intro h2 {
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .caption {
    margin-top: var(--space-2xs);
    color: var(--color-muted);
  }

  /* The strip's caption is the default, because the strip is the default —
     including with no JavaScript at all, where no mode is ever set. */
  .cap-field {
    display: none;
  }

  [data-mode='field'] .cap-strip {
    display: none;
  }

  [data-mode='field'] .cap-field {
    display: block;
  }

  .stage {
    position: relative;
    margin-top: var(--space-md);
    /* Sized before hydration so the field contributes zero layout shift. */
    height: 52vh;
    min-height: 22rem;
    max-height: 34rem;
    overflow: clip;
  }

  /*
   * Hidden until the client confirms WebGL and a wide enough viewport. It has
   * to be display:none rather than transparent: a percentage height against an
   * auto-height parent falls back to the 150px intrinsic canvas size, which
   * opened a band of dead space above the strip on a phone.
   */
  canvas {
    width: 100%;
    height: 100%;
    display: none;
  }

  [data-mode='field'] canvas {
    display: block;
  }

  .strip {
    position: absolute;
    inset: auto 0 0;
    padding: 0 var(--page-gutter) var(--space-2xl);
  }

  [data-mode='field'] .strip {
    display: none;
  }

  /* The horizon fades into the page so the canvas has no visible edge. */
  .stage::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(to bottom, var(--color-paper) 0%, transparent 22%),
      linear-gradient(to top, var(--color-paper) 6%, transparent 30%);
  }

  /* ---- axes ---- */

  .axis {
    position: absolute;
    z-index: var(--z-raise);
    pointer-events: none;
    font-size: var(--text-xs);
    color: var(--color-muted);
    margin: 0;
  }

  .axis-x {
    inset: auto var(--page-gutter) var(--space-sm);
    display: flex;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .axis-z {
    inset: 50% auto auto var(--space-sm);
    writing-mode: vertical-rl;
    rotate: 180deg;
    translate: 0 -50%;
  }

  .axis-name {
    color: var(--color-ink);
  }

  /* ---- hover label ---- */

  .label {
    position: absolute;
    top: 0;
    left: 0;
    z-index: var(--z-field);
    pointer-events: none;
    max-width: 22rem;
    padding: var(--space-xs) var(--space-sm);
    background: color-mix(in oklch, var(--color-paper) 88%, transparent);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: 6px;
    backdrop-filter: blur(8px);
    margin: var(--space-sm) 0 0 var(--space-sm);
  }

  .l-title {
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.25;
  }

  .l-meta {
    margin-top: var(--space-3xs);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  /*
   * The heat strip's layout, wherever the strip is what is showing: the stage
   * stops being a fixed-height stage and becomes whatever the strip needs.
   *
   * This is every visitor's first state now, not only a phone's — the canvas
   * only takes over once it has a frame to show. Keeping the 3D height while
   * the strip was on screen left a half-screen of empty stage above it, which
   * is the same void the swap was meant to remove.
   */
  @media (max-width: 899.98px) {
    .stage {
      height: auto;
      min-height: 0;
      max-height: none;
      overflow: visible;
    }

    .stage::after,
    .axis {
      display: none;
    }

    .strip {
      position: static;
      padding: 0 var(--page-gutter);
    }
  }

  [data-mode='strip'] .stage {
    height: auto;
    min-height: 0;
    max-height: none;
    overflow: visible;
  }

  [data-mode='strip'] .stage::after,
  [data-mode='strip'] .axis {
    display: none;
  }

  [data-mode='strip'] .strip {
    position: static;
    padding: 0 var(--page-gutter);
  }
</style>
