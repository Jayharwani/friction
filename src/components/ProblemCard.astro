---
/**
 * One problem as a card.
 *
 * A grid of cards with icons reads as a product; a list of text rows reads as
 * a directory. Same data as the row it replaces — app, title, trend, score,
 * verdict — arranged so the app is recognised before the sentence is read.
 */
import type { Problem } from '../../scripts/validate';
import { url } from '../lib/url';
import { getProduct } from '../lib/data';
import { weeklySeries } from '../lib/charts';
import Sparkline from './charts/Sparkline.astro';
import AppIcon from './AppIcon.astro';

interface Props {
  problem: Problem;
  /** Data attributes for the client-side filters. */
  filterable?: boolean;
}

const { problem, filterable = false } = Astro.props;

const product = getProduct(problem.productSlug);
const series = weeklySeries(problem.evidence);
const reviews = problem.evidence.length;
const platforms = [...new Set(problem.evidence.map((e) => e.platform))];
---

<article
  class="card"
  data-problem={filterable ? '' : undefined}
  data-app={problem.productSlug}
  data-category={problem.category}
  data-verdict={problem.verdict}
  data-platforms={platforms.join(' ')}
  data-score={problem.score}
  data-title={problem.title}
>
  <header>
    <AppIcon slug={problem.productSlug} name={product?.name ?? problem.productSlug} size={32} />
    <div class="who">
      <p class="app">{product?.name ?? problem.productSlug}</p>
      <p class="cat">{problem.category}</p>
    </div>
  </header>

  <h3>
    <a href={url(`/problems/${problem.slug}`)}>{problem.title}</a>
  </h3>

  <div class="trend">
    <Sparkline
      series={series}
      label={`${series.total} of ${reviews} reviews arrived in the last twelve weeks.`}
    />
    <span class="reviews num">{reviews} {reviews === 1 ? 'review' : 'reviews'}</span>
  </div>

  <footer>
    <p class="verdict">{problem.verdict}</p>
    <p class="score num">{problem.score}<span class="of"> / 100</span></p>
  </footer>
</article>

<style>
  .card {
    position: relative;
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: var(--space-sm);
    padding: var(--space-md);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: 10px;
    background: var(--color-paper-2);
  }

  /* One link in the tree; the whole card is its target. */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .card:has(a:hover),
  .card:has(a:focus-visible) {
    background: color-mix(in oklch, var(--color-accent) 6%, var(--color-paper-2));
    border-color: color-mix(in oklch, var(--color-accent) 30%, var(--color-rule));
  }

  @media (prefers-reduced-motion: no-preference) {
    .card {
      transition:
        background-color var(--dur-micro) var(--ease-out),
        border-color var(--dur-micro) var(--ease-out),
        translate var(--dur-micro) var(--ease-out);
    }

    .card:has(a:hover) {
      translate: 0 -2px;
    }
  }

  header {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .who {
    min-width: 0;
  }

  .app {
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.2;
  }

  .cat {
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  h3 {
    font-size: var(--text-md);
    font-weight: 500;
    line-height: 1.3;
  }

  h3 a {
    text-decoration: none;
  }

  .trend {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    align-self: end;
  }

  .reviews {
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  footer {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
    padding-top: var(--space-sm);
    border-top: var(--rule-hair) solid var(--color-rule);
  }

  .verdict {
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .score {
    font-size: var(--text-md);
    font-weight: 600;
  }

  .of {
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--color-muted);
  }
</style>
