---
/**
 * The product, in the hero.
 *
 * Every reference site puts an actual interface element in the first screen.
 * This is ours: three real problems, fully rendered, cycling. Not a mockup
 * and not an abstraction — the same card the rest of the site uses, with
 * real titles, real scores and real review counts.
 *
 * All three are in the DOM. The cycling only changes which is on top, so
 * with no JavaScript and no motion the first one is simply shown.
 */
import type { Problem } from '../../scripts/validate';
import { url } from '../lib/url';
import { getProduct } from '../lib/data';
import { weeklySeries } from '../lib/charts';
import Sparkline from './charts/Sparkline.astro';
import AppIcon from './AppIcon.astro';
import CategoryGlyph from './CategoryGlyph.astro';
import { familyOf } from '../lib/categories';

interface Props {
  problems: Problem[];
}

const { problems } = Astro.props;

const slides = problems.slice(0, 3).map((problem) => ({
  problem,
  family: familyOf(problem.category),
  product: getProduct(problem.productSlug),
  series: weeklySeries(problem.evidence),
  reviews: problem.evidence.length,
  quote: [...problem.evidence].sort((a, b) => b.reviewedAt.localeCompare(a.reviewedAt))[0],
}));
---

<div class="hero-card" data-hero-card>
  <p class="eyebrow num" aria-hidden="true">
    <span class="dot" /> live from this week's check
  </p>

  <div class="deck">
    {
      slides.map(({ problem, family, product, series, reviews, quote }, i) => (
        <article
          class="slide"
          data-family={family}
          data-slide
          data-active={i === 0 ? '' : undefined}
          aria-hidden={i === 0 ? undefined : 'true'}
        >
          <header>
            <AppIcon slug={problem.productSlug} name={product?.name ?? problem.productSlug} size={48} />
            <div>
              <p class="app">{product?.name ?? problem.productSlug}</p>
              <p class="cat">
                <CategoryGlyph family={family} size={15} />
                {problem.category}
              </p>
            </div>
            <p class="score num">
              {problem.score}
              <span class="of">/100</span>
            </p>
          </header>

          <h2>
            <a href={url(`/problems/${problem.slug}`)} tabindex={i === 0 ? undefined : -1}>
              {problem.title}
            </a>
          </h2>

          {quote && <p class="quote">“{quote.quote}”</p>}

          <footer>
            <Sparkline series={series} label={`${series.total} reviews in the last twelve weeks.`} />
            <span class="meta num">
              {reviews} {reviews === 1 ? 'review' : 'reviews'} · {problem.verdict}
            </span>
          </footer>
        </article>
      ))
    }
  </div>
</div>

<style>
  .hero-card {
    display: grid;
    gap: var(--space-sm);
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  /*
   * The slides stack. The deck's height is the tallest of them, so switching
   * slides never moves the page — the hero has to be the one thing on the
   * site that cannot shift.
   */
  .deck {
    display: grid;
  }

  .slide {
    position: relative;
    grid-area: 1 / 1;
    display: grid;
    gap: var(--space-sm);
    align-content: start;
    padding: calc(var(--space-lg) + 3px) var(--space-lg) var(--space-lg);
    border: var(--rule-hair) solid var(--cat-edge);
    border-radius: 12px;
    background: var(--color-paper-2);
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
  }

  /* Same 3px family edge the problem cards carry. */
  .slide::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: var(--cat);
  }

  .slide[data-active] {
    opacity: 1;
    visibility: visible;
  }

  @media (prefers-reduced-motion: no-preference) {
    .slide {
      transition:
        opacity var(--dur-long) var(--ease-out),
        translate var(--dur-long) var(--ease-out);
      translate: 0 4px;
    }

    .slide[data-active] {
      translate: 0 0;
    }
  }

  header {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .app {
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.2;
  }

  .cat {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .cat :global(.glyph) {
    color: var(--cat);
  }

  .score {
    margin-left: auto;
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: 1;
  }

  .of {
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--color-muted);
  }

  h2 {
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.25;
    text-wrap: balance;
  }

  h2 a {
    text-decoration: none;
  }

  /*
   * The title is the card's only link. At most widths it wraps to two lines
   * and clears the floor on its own; at 768 it fits one line and does not.
   */
  @media (pointer: coarse) {
    h2 a {
      display: flex;
      align-items: center;
      min-height: var(--tap);
    }
  }

  h2 a:hover,
  h2 a:focus-visible {
    color: var(--color-accent);
  }

  .quote {
    font-family: var(--font-quote);
    font-size: var(--text-md);
    line-height: 1.45;
    color: var(--color-muted);
    text-wrap: pretty;
  }

  footer {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding-top: var(--space-sm);
    border-top: var(--rule-hair) solid var(--color-rule);
  }

  .meta {
    font-size: var(--text-xs);
    color: var(--color-muted);
  }
</style>

<script>
  /**
   * Cycle the hero card every six seconds.
   *
   * Pauses on hover and on focus, and never starts at all under reduced
   * motion or when the tab is hidden — a card that keeps swapping behind a
   * background tab is work nobody is watching.
   */
  function initHeroCard(): void {
    const card = document.querySelector<HTMLElement>('[data-hero-card]');
    if (!card) return;

    const slides = [...card.querySelectorAll<HTMLElement>('[data-slide]')];
    if (slides.length < 2) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let at = 0;
    let timer = 0;

    function show(next: number): void {
      slides[at]!.removeAttribute('data-active');
      slides[at]!.setAttribute('aria-hidden', 'true');
      slides[at]!.querySelector('a')?.setAttribute('tabindex', '-1');
      at = next % slides.length;
      slides[at]!.setAttribute('data-active', '');
      slides[at]!.removeAttribute('aria-hidden');
      slides[at]!.querySelector('a')?.removeAttribute('tabindex');
    }

    const start = (): void => {
      window.clearInterval(timer);
      timer = window.setInterval(() => {
        if (!document.hidden) show(at + 1);
      }, 6000);
    };
    const stop = (): void => window.clearInterval(timer);

    card.addEventListener('pointerenter', stop);
    card.addEventListener('pointerleave', start);
    card.addEventListener('focusin', stop);
    card.addEventListener('focusout', start);
    document.addEventListener('astro:before-swap', stop, { once: true });

    start();
  }

  document.addEventListener('astro:page-load', initHeroCard);
</script>
