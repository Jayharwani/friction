---
/**
 * What people do instead, what already exists, and what nobody offers.
 *
 * Three panels rather than three columns of text. The first two are
 * extracted from reviews and are facts; the third is the only written
 * sentence on this site, and it is labelled as written every time it
 * appears — the labelling is not a disclaimer, it is the point. A site that
 * computes everything else has to be visibly honest about the one field it
 * does not.
 *
 * The treatments are deliberately unequal. The workarounds are set as chips
 * because they are fragments people typed, not sentences. The written panel
 * gets the family colour at full strength and the sentence at 20px, because
 * it is the payoff the other two set up.
 */
import EmptyMark from './ui/art/EmptyMark.astro';

interface Props {
  workarounds: string[];
  existing: string[];
  gap?: { line: string; writtenBy: string; writtenAt: string };
  /** What the block is about, for the empty states. */
  subject: string;
}

const { workarounds, existing, gap, subject } = Astro.props;
const hasAny = workarounds.length > 0 || existing.length > 0 || gap;

/* Panel marks. Not category glyphs — these label the three kinds of finding. */
const MARKS = {
  // A path that leaves the line and rejoins it: the detour people take.
  instead: ['M2 16h4', 'M6 16c4 0 3-8 7-8', 'M13 8h9', 'M19 5l3 3-3 3'],
  // A closed box: a product that exists.
  exists: ['M4 8.5l8-4 8 4v7l-8 4-8-4z', 'M4 8.5l8 4 8-4', 'M12 12.5v7'],
  // The same box, open and dashed: the shape of the thing nobody built.
  nobody: ['M4 8.5l8-4 8 4v7l-8 4-8-4z', 'M12 12.5v7'],
} as const;
---

{
  hasAny && (
    <div class="gap">
      <section class="panel">
        <p class="h">
          <svg class="pm" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            {MARKS.instead.map((d) => <path d={d} />)}
          </svg>
          What people do instead
        </p>

        {workarounds.length > 0 ? (
          <ul class="frags">
            {workarounds.map((w) => (
              <li>{w}</li>
            ))}
          </ul>
        ) : (
          <p class="none">
            <EmptyMark kind="quiet" size={24} />
            <span>No workaround was described.</span>
          </p>
        )}
      </section>

      <section class="panel">
        <p class="h">
          <svg class="pm" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            {MARKS.exists.map((d) => <path d={d} />)}
          </svg>
          What already exists
        </p>

        {existing.length > 0 ? (
          <ul class="frags">
            {existing.map((e) => (
              <li>{e}</li>
            ))}
          </ul>
        ) : (
          <p class="none">
            <EmptyMark kind="none" size={24} />
            <span>Nobody named a product that solves this.</span>
          </p>
        )}
      </section>

      {gap && (
        <section class="panel written">
          <p class="h">
            <svg class="pm" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="3 2.5" aria-hidden="true">
              {MARKS.nobody.map((d) => <path d={d} />)}
            </svg>
            What nobody offers
            <span class="mark" title={`Written by ${gap.writtenBy} on ${gap.writtenAt}`}>written</span>
          </p>

          <p class="line">{gap.line}</p>

          <p class="src">
            The one written line on this site. Everything else about {subject} is extracted or
            computed.
          </p>
        </section>
      )}
    </div>
  )
}

<style>
  .gap {
    display: grid;
    gap: var(--space-md);
    margin-top: var(--space-lg);
    padding-top: var(--space-lg);
    border-top: var(--rule-hair) solid var(--cat-edge, var(--color-rule));
  }

  /*
   * The written panel takes more room than the two that set it up: it is the
   * conclusion, and equal columns would say the three are equal findings.
   */
  @media (min-width: 46rem) {
    .gap {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1.25fr);
      gap: var(--space-md);
    }
  }

  .panel {
    padding: var(--space-md);
    border-radius: var(--r-card);
    background: var(--color-paper);
  }

  .h {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-muted);
    flex-wrap: wrap;
  }

  .pm {
    display: block;
    flex: none;
    color: var(--cat, var(--color-neutral));
  }

  /* ---- the two extracted panels ---- */

  /*
   * Chips, not list rows. These are fragments reviewers typed — "restart the
   * phone" — and setting them as sentences in a stack made them read as
   * prose the site had written.
   */
  .frags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
    list-style: none;
    margin: var(--space-sm) 0 0;
    padding: 0;
  }

  .frags li {
    padding: var(--space-3xs) var(--space-2xs);
    font-size: var(--text-xs);
    line-height: 1.35;
    border-radius: var(--r-cell);
    background: var(--cat-tint, var(--color-paper-2));
    border: var(--rule-hair) solid var(--cat-edge, var(--color-rule));
  }

  .none {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin-top: var(--space-sm);
    font-size: var(--text-xs);
    color: var(--color-muted);
    text-wrap: pretty;
  }

  /* ---- the written panel ---- */

  /*
   * Full-strength family colour. This is the one place on the site where a
   * category colour becomes a background band rather than a tint, and it is
   * reserved for the one sentence that was written rather than measured.
   */
  .written {
    background: var(--cat-solid, var(--color-ink));
    color: var(--color-paper);
  }

  /* Full paper, not a faded one: at 12px the faded version measured 3.5:1. */
  .written .h,
  .written .src {
    color: var(--color-paper);
  }

  .written .pm {
    color: var(--color-paper);
  }

  .mark {
    font-weight: 500;
    font-size: var(--text-xs);
    color: var(--color-paper);
    padding: 1px var(--space-2xs);
    border: var(--rule-hair) solid color-mix(in oklch, var(--color-paper) 55%, transparent);
    border-radius: var(--r-pill);
    cursor: help;
  }

  .line {
    margin-top: var(--space-sm);
    font-size: var(--text-lg);
    font-weight: 500;
    line-height: 1.32;
    letter-spacing: -0.012em;
    text-wrap: pretty;
    color: var(--color-paper);
  }

  .src {
    margin-top: var(--space-sm);
    font-size: var(--text-xs);
    line-height: 1.4;
  }
</style>
