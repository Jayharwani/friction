---
/**
 * What people do instead, what already exists, and what nobody offers.
 *
 * The first two are extracted from reviews and are facts. The third is the
 * only written sentence on this site, and it is labelled as written every
 * time it appears — the labelling is not a disclaimer, it is the point. A
 * site that computes everything else has to be visibly honest about the one
 * field it does not.
 */
interface Props {
  workarounds: string[];
  existing: string[];
  gap?: { line: string; writtenBy: string; writtenAt: string };
  /** What the block is about, for the empty states. */
  subject: string;
}

const { workarounds, existing, gap, subject } = Astro.props;
const hasAny = workarounds.length > 0 || existing.length > 0 || gap;
---

{
  hasAny && (
    <div class="gap">
      <div class="col">
        <p class="h">What people do instead</p>
        {workarounds.length > 0 ? (
          <ul>
            {workarounds.map((w) => (
              <li>{w}</li>
            ))}
          </ul>
        ) : (
          <p class="none">No workaround was described.</p>
        )}
      </div>

      <div class="col">
        <p class="h">What already exists</p>
        {existing.length > 0 ? (
          <ul>
            {existing.map((e) => (
              <li>{e}</li>
            ))}
          </ul>
        ) : (
          <p class="none">No reviewer named an existing product.</p>
        )}
      </div>

      {gap && (
        <div class="col written">
          <p class="h">
            What nobody offers
            <span class="mark" title={`Written by ${gap.writtenBy} on ${gap.writtenAt}`}>
              written
            </span>
          </p>
          <p class="line">{gap.line}</p>
          <p class="src">
            The one written line on this site. Everything else about {subject} is extracted or
            computed.
          </p>
        </div>
      )}
    </div>
  )
}

<style>
  .gap {
    display: grid;
    gap: var(--space-lg);
    margin-top: var(--space-lg);
    padding-top: var(--space-lg);
    border-top: var(--rule-hair) solid var(--color-rule);
  }

  @media (min-width: 46rem) {
    .gap {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-xl);
    }
  }

  .h {
    display: flex;
    align-items: baseline;
    gap: var(--space-xs);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-muted);
  }

  ul {
    list-style: none;
    margin: var(--space-xs) 0 0;
    padding: 0;
    font-size: var(--text-sm);
  }

  li {
    padding-block: var(--space-3xs);
  }

  li + li {
    border-top: var(--rule-hair) solid var(--color-rule);
  }

  .none {
    margin-top: var(--space-xs);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  /* The written column is marked out, so nobody mistakes it for the two
     beside it that are extracted. */
  .written {
    padding: var(--space-md);
    margin: calc(var(--space-md) * -1);
    border-radius: 6px;
    background: color-mix(in oklch, var(--color-accent) 7%, transparent);
  }

  .mark {
    font-weight: 500;
    font-size: var(--text-xs);
    color: var(--color-ink);
    padding: 1px var(--space-2xs);
    border: var(--rule-hair) solid color-mix(in oklch, var(--color-accent) 50%, transparent);
    border-radius: 999px;
    cursor: help;
  }

  .line {
    margin-top: var(--space-xs);
    font-size: var(--text-sm);
    line-height: 1.45;
    text-wrap: pretty;
  }

  .src {
    margin-top: var(--space-xs);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }
</style>
