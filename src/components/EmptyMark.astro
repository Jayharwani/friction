---
/**
 * Drawn marks for empty states.
 *
 * An empty state set as a grey sentence is the moment a site reads as
 * unfinished. Each of these is one small drawing plus one short line, in the
 * same language as the category glyphs: 24-unit box, 1.5 stroke, no fills.
 *
 *   none      an outline with nothing in it — nothing was named
 *   filter    a funnel that passes nothing — the filters match nothing
 *   single    one mark on a track with no second — only one scan so far
 *   quiet     a flat trace — no evidence in the window
 *   platform  a device with an empty screen — no quotes from this store
 *   search    a lens over nothing — the query found nothing
 */
interface Props {
  kind: 'none' | 'filter' | 'single' | 'quiet' | 'platform' | 'search';
  size?: number;
  class?: string;
}

const { kind, size = 28, class: klass } = Astro.props;

const PATHS: Record<Props['kind'], string[]> = {
  none: ['M4.5 6.5h15v11h-15z', 'M4.5 6.5l15 11', 'M19.5 6.5l-15 11'],
  filter: ['M3 4.5h18l-7 8v7l-4 2.5v-9.5z', 'M9 21.5h6'],
  single: ['M2 12h20', 'M8 8.5v7', 'M16 11.5v1'],
  quiet: ['M2 12h6', 'M8 12h2.5', 'M13 12h2.5', 'M17.5 12H22'],
  platform: ['M6.5 2.5h11v19h-11z', 'M10 18.5h4', 'M9 8h6', 'M9 11.5h3'],
  search: ['M10.5 3.5a7 7 0 1 1 0 14 7 7 0 0 1 0-14z', 'M15.5 15.5 21 21', 'M7.5 10.5h6'],
};

/* Dashes on the strokes that stand for absence, solid on the rest. */
const DASHED: Record<Props['kind'], boolean> = {
  none: false,
  filter: false,
  single: true,
  quiet: true,
  platform: true,
  search: true,
};
---

<svg
  class:list={['mark', klass]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {PATHS[kind].map((d, i) => <path d={d} stroke-dasharray={DASHED[kind] && i > 0 ? '2 3' : undefined} />)}
</svg>

<style>
  .mark {
    display: block;
    flex: none;
    color: var(--color-neutral);
    opacity: 0.85;
  }
</style>
