---
/**
 * The wall of voices.
 *
 * Twenty-seven real review quotes on a gently curved wall, lit from the left,
 * drifting a couple of degrees over a minute. The ones at the edges are
 * turned far enough away to be unreadable, which is the point: the first
 * thing the site says is that there are more of these than you will ever
 * read.
 *
 * It is CSS 3D, not WebGL, and that is a decision rather than a shortcut.
 * A WebGL hero has to create its GL context at load — measured elsewhere in
 * this project at 161ms of blocked main thread on a real GPU and 1,140ms
 * under a software rasteriser — and it would do that above the fold, where
 * the Friction Field gets to wait behind an IntersectionObserver five
 * screens down. Transforms cost none of that, the quotes stay real text
 * rather than a texture, and there is no fallback matrix to maintain.
 *
 * Every card is a real link to the challenge that quote belongs to, so
 * hovering brings one forward and clicking opens it. That means twenty-seven
 * tab stops, which is why the wall sits *after* the headline and the call to
 * action in the source: a keyboard reader gets the point and the way in
 * before the wall, and the wall is still reachable rather than hidden from
 * them. It is painted behind the text by z-index, not by source order.
 */
import type { Problem } from '../../scripts/validate';
import { getProduct } from '../lib/data';
import { url } from '../lib/url';

interface Props {
  problems: Problem[];
}

const { problems } = Astro.props;

/** Nine positions round the arc, three rows deep. */
const COLUMNS = 9;
const ROWS = 3;

/*
 * A hundred and fifty degrees. The first version used fifty-four, which put
 * every card inside a five-hundred-pixel band in the middle of the screen —
 * a huddle, not a wall. At this span the outer cards are turned almost
 * side-on, which is what makes the far ones unreadable by geometry rather
 * than by blurring them.
 */
const SPAN = 150;

/*
 * One quote per challenge first, so the wall is twenty-five different
 * struggles rather than six loud ones. Shortest first inside each, because a
 * short line survives being turned away from the reader.
 */
type Voice = { quote: string; slug: string; app: string };

const voice = (p: Problem, quote: string): Voice => ({
  quote,
  slug: p.slug,
  app: getProduct(p.productSlug)?.name ?? p.productSlug,
});

const byChallenge = problems.map((p) =>
  voice(p, [...p.evidence].sort((a, b) => a.quote.length - b.quote.length)[0]!.quote),
);
const taken = new Set(byChallenge.map((v) => v.quote));
const rest = problems
  .flatMap((p) => p.evidence.map((e) => voice(p, e.quote)))
  .filter((v) => !taken.has(v.quote))
  .sort((a, b) => a.quote.length - b.quote.length);

const picked = [...byChallenge, ...rest].slice(0, COLUMNS * ROWS);

/*
 * Interleaved rather than laid out in order, so two quotes from the same app
 * do not end up side by side. The stride is coprime with the column count,
 * which walks the whole set before it repeats a column.
 */
const cards = picked.map((v, i) => {
  const at = (i * 11) % picked.length;
  const column = at % COLUMNS;
  const row = Math.floor(at / COLUMNS) % ROWS;
  const angle = -SPAN / 2 + (column / (COLUMNS - 1)) * SPAN;
  return {
    ...v,
    angle,
    row: row - (ROWS - 1) / 2,
    /* 0 at the centre, 1 at either edge: how far the card is turned away. */
    away: Math.abs(angle) / (SPAN / 2),
    /* Light from the left, so the left face of the wall catches it. */
    lit: (1 - (angle + SPAN / 2) / SPAN) * 0.5 + 0.25,
    column,
  };
});
---

<div class="wall">
  <ul class="arc" aria-label="Recent complaints, and the challenge each one belongs to">
    {
      cards.map(({ quote, slug, app, angle, row, away, lit, column }) => (
        <li
          class="voice"
          data-col={column}
          style={`--a:${angle.toFixed(2)}deg; --row:${row}; --away:${away.toFixed(3)}; --lit:${lit.toFixed(3)}`}
        >
          <a href={url(`/challenges/${slug}`)}>
            <span class="quote">{quote}</span>
            <span class="src">{app}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <div class="scrim"></div>
</div>

<style>
  .wall {
    position: absolute;
    inset: 0;
    overflow: hidden;
    perspective: 1500px;
    perspective-origin: 52% 46%;
    /* Behind the headline, above the page background. */
    z-index: 0;
    pointer-events: none;
    /* The wall has no edges: it fades out before the hero's own do. */
    mask-image: linear-gradient(to bottom, transparent, #000 14%, #000 84%, transparent);
  }

  /*
   * The arc is pushed back by its own radius, so the card at the centre of
   * the wall lands at z = 0 rather than most of the way to the viewer.
   */
  .arc {
    --r: 44rem;
    position: absolute;
    inset: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    transform-style: preserve-3d;
    transform: translateZ(calc(var(--r) * -1));
  }

  .voice {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 17rem;
    margin: 0;
    /* The wall itself takes no pointer events; its cards do. */
    pointer-events: auto;
    border-radius: var(--r-card);
    border: var(--rule-hair) solid var(--color-rule);
    background: color-mix(in oklab, var(--color-paper-2) 88%, var(--color-paper-3));
    transform:
      translate(-50%, -50%)
      rotateY(calc(var(--a) * var(--turn, 1)))
      translateZ(calc(var(--r) + var(--pull, 0px)))
      translateY(calc(var(--row) * 13rem));

    /*
     * Turned away means dimmer. Not blurred: twenty-seven blurred layers on
     * a rotating parent re-rasterise every frame, and the foreshortening is
     * already doing the work — a card at seventy degrees is four characters
     * wide whatever its focus.
     */
    opacity: calc(1 - var(--away) * var(--away) * 0.55 * var(--turn, 1));
  }

  /*
   * Hover and keyboard focus both bring a card round to face the reader and
   * forward out of the wall. `--turn` scales its own angle toward zero, so
   * every card straightens by the same proportion whatever depth it sits at.
   */
  .voice:hover,
  .voice:focus-within {
    --turn: 0.25;
    --pull: 90px;
    z-index: 1;
    border-color: color-mix(in oklab, var(--color-accent) 55%, var(--color-rule));
  }

  .voice a {
    display: block;
    padding: var(--space-sm) var(--space-md);
    border-radius: inherit;
    color: inherit;
    text-decoration: none;
  }

  .voice a:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  /* One light, from the left. It only ever touches the card's own surface. */
  .voice::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: color-mix(in oklab, var(--color-ink) calc(var(--lit) * 14%), transparent);
    pointer-events: none;
  }

  .quote {
    display: block;
    font-family: var(--font-quote);
    font-size: var(--text-sm);
    line-height: 1.4;
    color: var(--color-ink);
    text-wrap: pretty;
  }

  .quote::before {
    content: '\201C';
  }

  .quote::after {
    content: '\201D';
  }

  .src {
    display: block;
    margin-top: var(--space-2xs);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  /*
   * The headline sits on the left, so the scrim is a one-sided wash rather
   * than a vignette. A radial scrim centred on the text put the heaviest
   * part of it exactly where the readable cards were, and wiped out the one
   * thing the wall is for.
   */
  .scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      var(--color-paper) 0%,
      color-mix(in oklab, var(--color-paper) 88%, transparent) 26%,
      color-mix(in oklab, var(--color-paper) 30%, transparent) 52%,
      transparent 74%
    );
  }

  /* A phone gets a tighter arc, smaller cards and six fewer to paint. */
  @media (max-width: 52rem) {
    .wall {
      perspective: 800px;
      perspective-origin: 50% 44%;
    }

    .arc {
      --r: 21rem;
    }

    .voice {
      width: 11rem;
      transform:
        translate(-50%, -50%)
        rotateY(calc(var(--a) * var(--turn, 1)))
        translateZ(calc(var(--r) + var(--pull, 0px)))
        translateY(calc(var(--row) * 8.5rem));

      /* The scrim sits over the wall on a phone, so the cards below it are
         decoration rather than targets. */
      pointer-events: none;
    }

    .voice a {
      padding: var(--space-2xs) var(--space-sm);
    }

    .voice[data-col='0'],
    .voice[data-col='8'] {
      display: none;
    }

    /* Under the text, not beside it: one wash from the top instead. */
    .scrim {
      background: linear-gradient(
        to bottom,
        color-mix(in oklab, var(--color-paper) 55%, transparent) 0%,
        color-mix(in oklab, var(--color-paper) 88%, transparent) 38%,
        var(--color-paper) 72%
      );
    }
  }

  /*
   * Six degrees over ninety-six seconds. It should read as the wall being
   * alive rather than as an animation, and it is the only thing moving on
   * the screen.
   */
  @media (prefers-reduced-motion: no-preference) {
    .arc {
      animation: drift 96s var(--ease-in-out, ease-in-out) infinite alternate;
    }

    .voice {
      transition:
        transform var(--dur-short) var(--ease-out),
        opacity var(--dur-short) var(--ease-out),
        border-color var(--dur-short) var(--ease-out);
    }
  }

  @keyframes drift {
    from {
      transform: translateZ(calc(var(--r) * -1)) rotateY(-3deg);
    }
    to {
      transform: translateZ(calc(var(--r) * -1)) rotateY(3deg);
    }
  }
</style>
