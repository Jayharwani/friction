---
/**
 * Twelve weekly bars and a baseline. Used inline in every list row, so it is
 * sized in ems and inherits its colour from the row.
 *
 * A week with no evidence draws no bar. The series is never smoothed and never
 * padded — a problem reported in one week looks like a problem reported in one
 * week.
 */
import type { WeeklySeries } from '../../lib/charts';

interface Props {
  series: WeeklySeries;
  /** 1 in a list row, 2 on a problem page where it carries the section. */
  scale?: 1 | 2;
  /** Announced to a screen reader in place of the bars. */
  label?: string;
}

const { series, scale = 1, label } = Astro.props;

const W = 64;
const H = 20;
const GAP = 1;
const BAR = (W - GAP * (series.counts.length - 1)) / series.counts.length;
const FLOOR = H - 1.5; // leaves room for the baseline hairline

const bars = series.counts.map((count, i) => ({
  i,
  count,
  x: i * (BAR + GAP),
  h: count === 0 ? 0 : Math.max(1.5, (count / series.max) * (FLOOR - 1)),
  week: series.labels[i]!,
}));

const busiest = bars.reduce((a, b) => (b.count > a.count ? b : a), bars[0]!);
const alt =
  label ??
  (series.total === 0
    ? `No evidence in the last ${series.counts.length} weeks.`
    : `${series.total} ${series.total === 1 ? 'review' : 'reviews'} over ${series.counts.length} weeks, busiest in the week of ${busiest.week} with ${busiest.count}.`);
---

<span class="spark" data-chart data-scale={scale}>
  <svg viewBox={`0 0 ${W} ${H}`} aria-hidden="true" focusable="false">
    <line
      x1="0"
      y1={H - 0.5}
      x2={W}
      y2={H - 0.5}
      class="ch-axis"
      shape-rendering="crispEdges"
    />
    {
      bars.map((b) =>
        b.h > 0 ? (
          <rect
            class="ch-rise bar"
            style={`--ch-i:${b.i}`}
            x={b.x}
            y={FLOOR - b.h}
            width={BAR}
            height={b.h}
          >
            <title>{b.count} in the week of {b.week}</title>
          </rect>
        ) : null,
      )
    }
  </svg>
  <span class="sr-only">{alt}</span>
</span>

<style>
  .spark {
    display: inline-block;
    width: 4rem;
    /* Reserved before paint; the SVG never changes the row's height. */
    height: 1.25rem;
    flex: none;
  }

  .spark[data-scale='2'] {
    width: 100%;
    height: 3.25rem;
  }

  .spark svg {
    width: 100%;
    height: 100%;
  }

  .bar {
    fill: var(--color-accent);
  }

  /* In a dense list the bars sit back until the row is the one being read. */
  .spark[data-scale='1'] .bar {
    fill: color-mix(in oklch, var(--color-accent) 62%, var(--color-paper-2));
  }

  :global(.row:hover) .spark[data-scale='1'] .bar,
  :global(.row:focus-within) .spark[data-scale='1'] .bar {
    fill: var(--color-accent);
  }
</style>
