---
/**
 * Which stores answered, for every app, in one scan.
 *
 * Two cells per app: Apple and Play. A filled cell means that store returned
 * data; an empty one means it did not, and the run continued without it. The
 * sentence "Play is an enhancement, not a dependency" is a claim; this is the
 * evidence for it.
 */
import type { Run } from '../../../scripts/validate';

interface Props {
  run: Run;
  names: (slug: string) => string;
}

const { run, names } = Astro.props;

const rows = run.products
  .map((p) => ({ slug: p.slug, name: names(p.slug), apple: p.appleOk, play: p.playOk }))
  .sort((a, b) => a.name.localeCompare(b.name));

const appleOk = rows.filter((r) => r.apple).length;
const playOk = rows.filter((r) => r.play).length;

const alt = `Of ${rows.length} apps, Apple returned data for ${appleOk} and Google Play for ${playOk}. ${rows
  .filter((r) => !r.apple || !r.play)
  .map((r) => `${r.name}: ${r.apple ? '' : 'no Apple data'}${!r.apple && !r.play ? ', ' : ''}${r.play ? '' : 'no Play data'}`)
  .join('; ') || 'Every app returned data from both stores.'}`;
---

<figure class="cov" data-chart>
  <div class="head num" aria-hidden="true">
    <span />
    <span>Apple</span>
    <span>Play</span>
  </div>

  <ol>
    {
      rows.map((r, i) => (
        <li class="ch-fade" style={`--ch-i:${i}; --ch-step:24ms`}>
          <span class="name">{r.name}</span>
          <span class="cell" data-ok={r.apple ? '' : undefined}>
            <span class="sr-only">Apple: {r.apple ? 'returned data' : 'no data'}</span>
          </span>
          <span class="cell" data-ok={r.play ? '' : undefined}>
            <span class="sr-only">Play: {r.play ? 'returned data' : 'no data'}</span>
          </span>
        </li>
      ))
    }
  </ol>

  <p class="ch-caption num">
    Apple {appleOk} of {rows.length}, Play {playOk} of {rows.length}. A missing cell is a gap the
    run recorded and carried on past.
  </p>
  <figcaption class="sr-only">{alt}</figcaption>
</figure>

<style>
  .cov {
    margin: var(--space-lg) 0 0;
    max-width: 22rem;
  }

  .head,
  li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 2.6rem 2.6rem;
    align-items: center;
    gap: var(--space-sm);
  }

  .head {
    font-size: var(--text-xs);
    color: var(--color-muted);
    padding-bottom: var(--space-2xs);
  }

  .head span + span {
    text-align: center;
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    padding-block: var(--space-3xs);
    font-size: var(--text-xs);
  }

  li + li {
    border-top: var(--rule-hair) solid var(--color-rule);
  }

  .name {
    color: var(--color-muted);
  }

  .cell {
    height: 0.75rem;
    border-radius: 2px;
    /* An empty cell is drawn, not omitted: the gap has to be visible. */
    background: var(--color-paper-2);
    box-shadow: inset 0 0 0 var(--rule-hair) var(--color-rule);
  }

  .cell[data-ok] {
    background: var(--color-accent);
    box-shadow: none;
  }
</style>
