---
/**
 * How the verdict is decided, as the three tests it actually runs, in order.
 *
 * The shape mirrors `decideVerdict` in scoring.ts exactly: three tests, each
 * with an exit, and whatever survives all three lands on the last branch. The
 * counts at each terminal are the live population, computed here at build time
 * — nothing on this diagram is a hardcoded example.
 *
 * Drawn as HTML rather than SVG. The content is text in boxes joined by rules,
 * which is what HTML is for, and it reflows on a phone where an SVG diagram
 * would have to scroll.
 */
import type { Verdict } from '../../../scripts/validate';

interface Step {
  /** The question, as the code asks it. */
  test: string;
  /** Where a "yes" lands. */
  verdict: Verdict;
  count: number;
}

interface Props {
  steps: Step[];
  /** The final branch: what everything that survives every test becomes. */
  fallthrough: { verdict: Verdict; count: number };
}

const { steps, fallthrough } = Astro.props;

const total = steps.reduce((s, x) => s + x.count, 0) + fallthrough.count;

const alt = `Of ${total} active problems: ${steps
  .map((s) => `${s.count} are ${s.verdict}, because ${s.test.toLowerCase()}`)
  .join('; ')}; the remaining ${fallthrough.count} are ${fallthrough.verdict}.`;
---

<figure class="flow" data-chart>
  <ol>
    {
      steps.map((s, i) => (
        <li class="ch-fade" style={`--ch-i:${i}; --ch-step:60ms`}>
          <p class="test">{s.test}</p>
          <div class="branch">
            <span class="edge" aria-hidden="true" />
            <p class="out">
              <span class="verdict">{s.verdict}</span>
              <span class="count num">
                {s.count}
                <span class="sr-only"> {s.count === 1 ? 'problem' : 'problems'}</span>
              </span>
            </p>
          </div>
        </li>
      ))
    }

    <li class="ch-fade last" style={`--ch-i:${steps.length}; --ch-step:60ms`}>
      <p class="test">Everything else</p>
      <div class="branch">
        <span class="edge" aria-hidden="true" />
        <p class="out">
          <span class="verdict">{fallthrough.verdict}</span>
          <span class="count num">
            {fallthrough.count}
            <span class="sr-only">
              {fallthrough.count === 1 ? 'problem' : 'problems'}
            </span>
          </span>
        </p>
      </div>
    </li>
  </ol>

  <figcaption class="sr-only">{alt}</figcaption>
</figure>

<style>
  .flow {
    margin: var(--space-lg) 0 0;
  }

  .flow ol {
    list-style: none;
    margin: 0;
    padding: 0;
    /* The spine: one rule down the left, which the tests hang off. */
    border-left: var(--rule-hair) solid var(--color-rule);
  }

  li {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2xs);
    padding: var(--space-sm) 0 var(--space-md) var(--space-lg);
  }

  /* The node on the spine. */
  li::before {
    content: '';
    position: absolute;
    left: calc(-1 * var(--space-3xs) - 2px);
    top: calc(var(--space-sm) + 0.55em);
    width: 5px;
    height: 5px;
    border-radius: 1px;
    background: var(--color-rule);
  }

  li.last::before {
    background: var(--color-accent);
  }

  .test {
    font-size: var(--text-sm);
  }

  .branch {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .edge {
    width: var(--space-lg);
    height: var(--rule-hair);
    background: var(--color-rule);
    flex: none;
  }

  .out {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    font-size: var(--text-sm);
  }

  .verdict {
    font-weight: 600;
  }

  .count {
    color: var(--color-muted);
    font-size: var(--text-xs);
  }

  @media (min-width: 34rem) {
    li {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: var(--space-md);
    }
  }
</style>
