---
/**
 * One app in the grid: what it is, how much has been found, and the shape of
 * that evidence over twelve weeks.
 *
 * The icon is used small and unaltered, to identify the app beside its name.
 * It is served from this origin, never hotlinked, and the page carries the
 * non-affiliation notice.
 */
import type { Problem, Product } from '../../scripts/validate';
import { url } from '../lib/url';
import { verdictMix, weeklySeries } from '../lib/charts';
import CategoryGlyph from './CategoryGlyph.astro';
import { FAMILIES, FAMILY_LABEL, familyOf } from '../lib/categories';
import Sparkline from './charts/Sparkline.astro';
import StackedBar from './charts/StackedBar.astro';

interface Props {
  product: Product;
  problems: Problem[];
}

const { product, problems } = Astro.props;

const reviewCount = problems.reduce((n, p) => n + p.evidence.length, 0);
const evidence = problems.flatMap((p) => p.evidence);
const series = weeklySeries(evidence);
const mix = verdictMix(problems);
const has = problems.length > 0;

const href = url(`/products/${product.slug}`);
const platforms = [...new Set(evidence.map((e) => e.platform))];

/*
 * Which families this app's problems fall into, in the ring's order so the
 * strip reads the same way on every card. This is the app-level view of the
 * system: two glances tell you Spotify is an ads-and-billing story and Zoom
 * is a stability one, without reading a single title.
 */
const familyMix = FAMILIES.map((family) => ({
  family,
  count: problems.filter((pr) => familyOf(pr.category) === family).length,
})).filter((f) => f.count > 0);
---

<article
  class="card"
  data-app
  data-name={product.name}
  data-category={product.category}
  data-problems={problems.length}
  data-reviews={reviewCount}
  data-platforms={platforms.join(' ')}
>
  <div class="head">
    <img
      src={url(`/icons/${product.slug}.jpg`)}
      alt=""
      width="48"
      height="48"
      loading="lazy"
      decoding="async"
      class="icon"
      transition:name={`icon-${product.slug}`}
    />
    <div class="names">
      <h2>
        {
          has ? (
            <a href={href}>{product.name}</a>
          ) : (
            /* No findings means no product page worth linking to. */
            <span>{product.name}</span>
          )
        }
      </h2>
      <p class="cat">{product.category}</p>
    </div>
  </div>

  {
    has ? (
      <>
        <dl class="figs num">
          <div>
            <dt>Problems</dt>
            <dd>{problems.length}</dd>
          </div>
          <div>
            <dt>Reviews recorded</dt>
            <dd>{reviewCount}</dd>
          </div>
        </dl>

        <div class="trend">
          <Sparkline
            series={series}
            label={`${series.total} of ${product.name}'s ${reviewCount} recorded reviews arrived in the last twelve weeks.`}
          />
          <span class="trend-label">last 12 weeks</span>
        </div>

        <ul class="fams" aria-label={`Problem families: ${familyMix.map((f) => `${f.count} ${FAMILY_LABEL[f.family]}`).join(', ')}`}>
          {familyMix.map(({ family, count }) => (
            <li data-family={family}>
              <CategoryGlyph family={family} size={15} />
              <span class="f-name">{FAMILY_LABEL[family]}</span>
              <span class="f-count num">{count}</span>
            </li>
          ))}
        </ul>

        <StackedBar segments={mix} of={`of ${product.name}'s problems`} />
      </>
    ) : (
      <p class="none">Nothing has cleared the filters for this app yet.</p>
    )
  }
</article>

<style>
  .card {
    display: grid;
    gap: var(--space-md);
    align-content: start;
    padding: var(--space-lg) 0;
    border-top: var(--rule-hair) solid var(--color-rule);
  }

  .head {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .icon {
    width: 3rem;
    height: 3rem;
    border-radius: 10px;
    flex: none;
    /* The artwork is the app's, not this site's: no filter, no overlay. */
    background: var(--color-paper-2);
  }

  .names {
    min-width: 0;
  }

  h2 {
    font-size: var(--text-md);
    font-weight: 600;
    line-height: 1.2;
  }

  h2 a {
    text-decoration: none;
  }

  /*
   * The whole card is the target, with one link in the tree.
   *
   * On a touch screen the overlay is raised above the card's own content,
   * because without that the charts below it paint over the hit area and the
   * real target shrinks to the title text — measured at 22px. On a mouse it
   * stays below, so the charts keep their per-segment tooltips.
   */
  h2 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  @media (pointer: coarse) {
    h2 a::after {
      z-index: var(--z-raise);
    }
  }

  .card:has(a) {
    position: relative;
  }

  .card:has(a:hover),
  .card:has(a:focus-visible) {
    background: color-mix(in oklch, var(--color-ink) 5%, transparent);
  }

  .cat {
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .figs {
    display: flex;
    gap: var(--space-lg);
    margin: 0;
  }

  .figs dt {
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .figs dd {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.1;
  }

  /* The family strip: glyph, name and count, so colour never carries it. */
  .fams {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .fams li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    padding: var(--space-3xs) var(--space-2xs);
    font-size: var(--text-xs);
    border-radius: 6px;
    background: var(--cat-tint);
    border: var(--rule-hair) solid var(--cat-edge);
  }

  .fams :global(.glyph) {
    color: var(--cat);
  }

  .f-count {
    font-weight: 600;
  }

  .trend {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .trend-label {
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .none {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
</style>
