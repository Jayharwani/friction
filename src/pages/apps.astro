---
/**
 * Every tracked app, with what has been found for it so far.
 *
 * The product pages existed and were good, but nothing on the site linked to
 * them. This is the way in.
 *
 * Apps with no problems recorded are listed but not linked: a product page
 * with nothing on it is a dead end, and saying so plainly is more useful than
 * a link that disappoints.
 */
import Layout from '../layouts/Layout.astro';
import AppCard from '../components/AppCard.astro';
import { url } from '../lib/url';
import { getProblems, getProducts } from '../lib/data';

const products = getProducts();
const problems = getProblems();

const rows = products
  .map((product) => {
    const mine = problems.filter((p) => p.productSlug === product.slug);
    return {
      product,
      problemCount: mine.length,
      reviewCount: mine.reduce((n, p) => n + p.evidence.length, 0),
    };
  })
  // Apps with findings first, then alphabetically.
  .sort((a, b) => b.problemCount - a.problemCount || a.product.name.localeCompare(b.product.name));

const tracked = products.length;
const withFindings = rows.filter((r) => r.problemCount > 0).length;

const categories = [...new Set(products.map((p) => p.category))].sort();
---

<Layout
  title="Apps"
  description="Every app Friction tracks, with the number of recurring problems found in its public store reviews."
>
  <div class="shell" data-apps data-view="grid">
    <header class="intro">
      <h1>Apps</h1>
      <p class="lede">
        Friction tracks {tracked} apps. {withFindings} of them currently have at least one recurring
        problem with enough evidence to record.
      </p>
    </header>

    <div class="controls bleed" role="group" aria-label="Sort, filter and view">
      <fieldset class="seg">
        <legend>Sort</legend>
        <label><input type="radio" name="apps-sort" value="problems" checked /><span>Problems</span></label>
        <label><input type="radio" name="apps-sort" value="reviews" /><span>Reviews</span></label>
        <label><input type="radio" name="apps-sort" value="name" /><span>A–Z</span></label>
      </fieldset>

      <p class="field">
        <label for="apps-platform">Platform</label>
        <select id="apps-platform" data-filter-platform>
          <option value="all">Both stores</option>
          <option value="ios">iOS</option>
          <option value="android">Android</option>
        </select>
      </p>

      <p class="field">
        <label for="apps-category">Category</label>
        <select id="apps-category" data-filter-category>
          <option value="all">All categories</option>
          {categories.map((c) => <option value={c}>{c}</option>)}
        </select>
      </p>

      <p class="count num" data-apps-count aria-live="polite">{tracked} apps</p>

      <fieldset class="seg view">
        <legend>View</legend>
        <label><input type="radio" name="apps-view" value="grid" checked /><span>Cards</span></label>
        <label><input type="radio" name="apps-view" value="table" /><span>Table</span></label>
      </fieldset>
    </div>

    <div class="grid bleed" data-apps-grid>
      {
        rows.map(({ product }) => (
          <AppCard product={product} problems={problems.filter((p) => p.productSlug === product.slug)} />
        ))
      }
    </div>

    <p class="ch-caption grid-note bleed">
      An app with nothing listed is not a clean bill of health — it means nothing cleared the
      filters in this week's checks so far. App icons are the property of their owners, shown here only to
      identify the app; Friction is not affiliated with any of them.
    </p>

    <table>
      <thead>
        <tr>
          <th scope="col">App</th>
          <th scope="col">Category</th>
          <th scope="col" class="n">Problems</th>
          <th scope="col" class="n">Reviews</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map(({ product, problemCount, reviewCount }) => (
            <tr>
              <th scope="row">
                {problemCount > 0 ? (
                  <a href={url(`/products/${product.slug}`)}>{product.name}</a>
                ) : (
                  <span>{product.name}</span>
                )}
              </th>
              <td class="cat">{product.category}</td>
              <td class="n num">{problemCount > 0 ? problemCount : '—'}</td>
              <td class="n num">{reviewCount > 0 ? reviewCount : '—'}</td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <p class="note table-note">
      "Reviews" counts stored evidence, not every review read —{' '}
      <a href={url('/how-it-works')}>how it works</a>.
    </p>
  </div>
</Layout>

<script>
  import { initAppsControls } from '../scripts/apps-controls';

  document.addEventListener('astro:page-load', initAppsControls);
</script>

<style>

  /* ---- controls ---- */

  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--space-md) var(--space-lg);
    margin-top: var(--space-xl);
    padding-bottom: var(--space-md);
  }

  fieldset {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }

  legend,
  .field label {
    display: block;
    font-size: var(--text-xs);
    color: var(--color-muted);
    margin-bottom: var(--space-2xs);
    padding: 0;
  }

  /* A segmented control built from radios, so it is keyboard-operable by
     default and works with no JavaScript at all. */
  .seg {
    display: flex;
    flex-direction: column;
  }

  .seg > label {
    display: inline-flex;
  }

  .seg label:has(input) {
    cursor: pointer;
  }

  .seg > label + label {
    margin-left: 0;
  }

  .seg :global(input) {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .seg span {
    display: block;
    padding: var(--space-2xs) var(--space-sm);
    font-size: var(--text-xs);
    color: var(--color-muted);
    border: var(--rule-hair) solid var(--color-rule);
    border-right-width: 0;
  }

  .seg label:last-of-type span {
    border-right-width: var(--rule-hair);
  }

  .seg label:hover span {
    color: var(--color-ink);
  }

  .seg input:checked + span {
    color: var(--color-ink);
    font-weight: 600;
    background: color-mix(in oklch, var(--color-ink) 8%, transparent);
  }

  .seg input:focus-visible + span {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  /* The radios sit in a row; the legend stacks above them. */
  .seg {
    display: grid;
    grid-template-columns: auto;
  }

  .seg > label {
    grid-row: 2;
  }

  .seg > label:nth-of-type(1) { grid-column: 1; }
  .seg > label:nth-of-type(2) { grid-column: 2; }
  .seg > label:nth-of-type(3) { grid-column: 3; }

  .seg legend {
    grid-row: 1;
    grid-column: 1 / -1;
  }

  select {
    font: inherit;
    font-size: var(--text-xs);
    color: var(--color-ink);
    background: var(--color-paper-2);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: 4px;
    padding: var(--space-2xs) var(--space-xs);
  }

  select:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .field {
    margin: 0;
  }

  .count {
    margin: 0 0 var(--space-2xs) auto;
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  /* ---- the grid ---- */

  /*
   * Three up on a wide screen, one on a phone. The track minimum is stated
   * explicitly rather than left as auto, so the cards' images cannot push a
   * track wider than the viewport.
   */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    column-gap: var(--space-2xl);
  }

  /* ---- view switch ---- */

  [data-view='grid'] table,
  [data-view='grid'] .table-note {
    display: none;
  }

  [data-view='table'] .grid,
  [data-view='table'] .grid-note {
    display: none;
  }

  .grid-note {
    margin-top: var(--space-xl);
    max-width: 48em;
  }

  .intro {
    padding-top: var(--space-xl);
  }

  h1 {
    font-size: var(--text-2xl);
    letter-spacing: -0.02em;
  }

  .lede {
    margin-top: var(--space-md);
    color: var(--color-muted);
    max-width: var(--measure);
  }

  table {
    margin-top: var(--space-xl);
    border-collapse: collapse;
    width: 100%;
    font-size: var(--text-sm);
    text-align: left;
  }

  th,
  td {
    padding: var(--space-sm) var(--space-sm) var(--space-sm) 0;
    border-top: var(--rule-hair) solid var(--color-rule);
    font-weight: 400;
  }

  thead th {
    border-top: 0;
    border-bottom: var(--rule-hair) solid var(--color-ink);
    font-weight: 600;
    padding-bottom: var(--space-xs);
  }

  tbody th {
    font-weight: 500;
    font-size: var(--text-md);
  }

  /* An app with no findings is present but not a link. */
  tbody th span {
    color: var(--color-muted);
    font-weight: 400;
  }

  /* ---- table craft (spec 4.4) ---- */

  /*
   * The header stays put while a long table scrolls. It needs its own
   * background or the rows would read straight through it.
   */
  thead th {
    position: sticky;
    top: var(--nav-h);
    z-index: var(--z-raise);
    background: var(--color-paper);
  }

  /* Whole-row hover, mixed off the page colour so it works in both themes. */
  tbody tr:hover {
    background: color-mix(in oklch, var(--color-ink) 5%, transparent);
  }

  tbody tr:has(a:focus-visible) {
    background: color-mix(in oklch, var(--color-accent) 10%, transparent);
  }

  .cat {
    color: var(--color-muted);
  }

  .n {
    text-align: right;
    padding-right: 0;
    width: 6rem;
  }

  .note {
    margin-top: var(--space-lg);
    font-size: var(--text-sm);
    color: var(--color-muted);
    max-width: var(--measure);
  }

  @media (max-width: 34rem) {
    .cat {
      display: none;
    }

    .n {
      width: 4.5rem;
    }
  }
</style>
