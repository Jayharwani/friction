---
/**
 * Methodology (spec 6.1). Plain English, not marketing copy.
 *
 * Every number here is read from the live data or from the scoring module
 * itself, so the page cannot drift out of step with what the site actually did.
 */
import Layout from '../layouts/Layout.astro';
import PageTexture from '../components/PageTexture.astro';
import BrandMark from '../components/BrandMark.astro';
import ScoreCalculator from '../components/ScoreCalculator.astro';
import Flow from '../components/charts/Flow.astro';
import Histogram from '../components/charts/Histogram.astro';
import Funnel from '../components/charts/Funnel.astro';
import SpecBento from '../components/table/SpecBento.astro';
import CompareRows from '../components/table/CompareRows.astro';
import RunCard from '../components/table/RunCard.astro';
import FrictionField from '../components/FrictionField.astro';
import ScoreDisclosure from '../components/ScoreDisclosure.astro';
import Sparkline from '../components/charts/Sparkline.astro';
import VersionTimeline from '../components/charts/VersionTimeline.astro';
import PlatformMarks from '../components/charts/PlatformMarks.astro';
import SignalGrid from '../components/charts/SignalGrid.astro';
import CoverageGrid from '../components/charts/CoverageGrid.astro';
import EmptyMark from '../components/EmptyMark.astro';
import { scoreBuckets, versionMarks, weeklySeries } from '../lib/charts';
import { url } from '../lib/url';
import {
  formatDate,
  getActiveProblems,
  getBuildThreshold,
  getGaps,
  getLatestRun,
  getPassRate,
  getChallenge,
  getProblems,
  getProduct,
  getProducts,
  getRuns,
} from '../lib/data';
import {
  COMPONENT_LABELS,
  COMPONENT_ORDER,
  EVIDENCE_WINDOW_DAYS,
  MIN_BUILD_THRESHOLD,
  STALE_AFTER_DAYS,
  THRESHOLD_PERCENTILE,
  WEIGHTS,
} from '../lib/scoring';
import {
  APP_DENYLIST,
  CANDIDATE_CAP,
  MAX_AGE_DAYS,
  MIN_TEXT_LENGTH,
} from '../../scripts/validate';

const problems = getProblems();
const active = getActiveProblems();
const threshold = getBuildThreshold();
const passRate = getPassRate();
const run = getLatestRun();
const products = getProducts();

const worthBuilding = active.filter((p) => p.verdict === 'Strong signal').length;

// The calculator starts from a real problem: the highest-scoring active one.
const seedProblem = active[0];
const seedProduct = seedProblem ? getProduct(seedProblem.productSlug) : undefined;

/*
 * The worked example below is the same challenge, so a reader who has just
 * dragged the calculator sees the real thing it was modelling rather than a
 * second, unrelated one.
 */
const seedChallenge = seedProblem ? getChallenge(seedProblem.slug) : undefined;
const seedSeries = seedProblem ? weeklySeries(seedProblem.evidence) : null;
const seedVersions = seedProblem ? versionMarks(seedProblem) : [];

/* Newest scan first. Folded in from /archive, which no longer has a page. */
const runs = getRuns();

/*
 * The live population at each branch of decideVerdict, in the order the
 * function tests them. Recomputed here so the diagram cannot go stale.
 */
const thin = active.filter((p) => p.inputs.uniqueReviewers < 4);
const solved = active.filter((p) => !thin.includes(p) && p.existingSolutions.length >= 3);
const strong = active.filter(
  (p) => !thin.includes(p) && !solved.includes(p) && p.score >= threshold,
);
const recurring = active.filter(
  (p) => !thin.includes(p) && !solved.includes(p) && p.score < threshold,
);

const buckets = scoreBuckets(active.map((p) => p.score));

/* The single generated field on the site, counted rather than asserted. */
const gapCount = Object.keys(getGaps()).length;

/*
 * One real review of each kind, used to show which fields each store supplies.
 * The quote is never shown here — only which slots the record carries.
 */
const everyEvidence = problems.flatMap((p) => p.evidence);
const appleSample = everyEvidence.find((e) => e.platform === 'ios' && e.version && e.title);
const playSample = everyEvidence.find((e) => e.platform === 'android');
const playWithVersion = everyEvidence.filter((e) => e.platform === 'android' && e.version).length;
const playTotal = everyEvidence.filter((e) => e.platform === 'android').length;
const COUNTRY: Record<string, string> = {
  us: 'United States', gb: 'United Kingdom', ca: 'Canada',
  au: 'Australia', nz: 'New Zealand', ie: 'Ireland', sg: 'Singapore',
};
const playGaps = run?.products.filter((p) => !p.playOk) ?? [];

// Storefront list is read from the tracked apps so it cannot drift.
const STOREFRONT_NAMES: Record<string, string> = {
  us: 'the United States', gb: 'the United Kingdom', ca: 'Canada',
  au: 'Australia', nz: 'New Zealand', ie: 'Ireland', sg: 'Singapore',
};
const storefronts = [...new Set(products.flatMap((p) => p.countries))];
const storefrontList = storefronts.map((c) => STOREFRONT_NAMES[c] ?? c.toUpperCase());
const storefrontSentence =
  storefrontList.length > 1
    ? `${storefrontList.slice(0, -1).join(', ')} and ${storefrontList.at(-1)}`
    : (storefrontList[0] ?? '');

const componentMeaning: Record<string, string> = {
  distinctUsers: 'How many different people reported it, counted by a salted hash of the reviewer name.',
  recurrence: 'How many separate weeks it appeared in, rather than all at once.',
  recency: 'How long ago it was last reported.',
  severity: 'The mean star rating of the reviews reporting it.',
  churnIntent: 'How many reviewers said they were leaving, deleting or cancelling.',
  versionPersistence: 'How many distinct app versions it survived.',
  crossPlatform: 'Whether it was reported on both iOS and Android.',
};
---

<Layout
  title="How it works"
  description="Where Friction's data comes from, exactly how each score is computed, and what this method cannot tell you."
>
  {/*
    The page opens the way the homepage does: a roman line, then a Newsreader
    italic line on a lit panel. One statement, centred, with air around it.
  */}
  <section class="page-hero full">
    <PageTexture seed="how-it-works" />
    <BrandMark variant="device" />

    <div class="hero-in">
      <h1>How it works</h1>
      <p class="hero-line">Reviews in, challenges out.</p>

      <dl class="proof num">
        <div><dt>Reviews read</dt><dd>{run ? run.funnel.fetched.total.toLocaleString('en-GB') : '—'}</dd></div>
        <div><dt>Carried forward</dt><dd>{run ? run.funnel.capped.total : '—'}</dd></div>
        <div><dt>Challenges tracked</dt><dd>{problems.length}</dd></div>
        <div><dt>Written by a model</dt><dd>{gapCount}</dd></div>
      </dl>
    </div>
  </section>

  {/* ---------- 1. where it comes from ---------- */}

  <section class="band band-quiet full" aria-labelledby="where-it-comes-from">
    <div class="band-in">
      <h2 id="where-it-comes-from">Where it comes from</h2>
      <p class="lede-c">Two public feeds. No credentials, no agreement.</p>

    <CompareRows
      columns={[
        { label: 'Apple App Store', figure: '5 of 5' },
        { label: 'Google Play', figure: '3 of 5' },
      ]}
      rows={[
        { label: 'Star rating', states: [
          { on: true, note: appleSample ? `${appleSample.rating} of 5` : '1 of 5' },
          { on: true, note: playSample ? `${playSample.rating} of 5` : '1 of 5' },
        ] },
        { label: 'App version', states: [
          { on: true, note: appleSample?.version ?? '1.7.338' },
          { on: false, note: `${playWithVersion} of ${playTotal} carry one` },
        ] },
        { label: 'Country', states: [
          { on: true, note: appleSample ? (COUNTRY[appleSample.country] ?? appleSample.country.toUpperCase()) : 'United States' },
          { on: false },
        ] },
        { label: 'Date', states: [
          { on: true, note: appleSample ? formatDate(appleSample.reviewedAt) : '—' },
          { on: true, note: playSample ? formatDate(playSample.reviewedAt) : '—' },
        ] },
        { label: 'Title', states: [{ on: true }, { on: false }] },
      ]}
      caption="Play is an enhancement, never a dependency."
    />

    </div>
  </section>

  {/* ---------- 2. what gets thrown away ---------- */}

  <section class="band full" aria-labelledby="what-gets-thrown-away">
    <div class="band-in">
      <h2 id="what-gets-thrown-away">What gets thrown away</h2>
      <p class="lede-c">Ten thousand in. A hundred and fifty out.</p>

    {
      run && (
        <Funnel
          compact
          stages={[
            { label: 'Read', value: run.funnel.fetched.total },
            { label: 'Screened', value: run.funnel.screened.total },
            { label: 'Complaints', value: run.funnel.filtered.total },
            { label: 'Carried', value: run.funnel.capped.total },
          ]}
        />
      )
    }

      <p class="num ch-caption">
        Every one of those cuts is code, running before any model sees anything.
      </p>
    </div>
  </section>

  {/* ---------- 3. what the model does, and never does ---------- */}

  <section class="band band-quiet full" aria-labelledby="what-the-model-does">
    <div class="band-in">
      <h2 id="what-the-model-does">What the model does, and never does</h2>
      <p class="lede-c">It groups and it quotes. Nothing else.</p>

    <CompareRows
      mode="lists"
      columns={[
        {
          label: 'The model does',
          mark: ['M3 6.5h7', 'M3 12h7', 'M3 17.5h7', 'M14 12h7', 'M18 8.5l3 3.5-3 3.5'],
          items: [
            'group reviews describing the same struggle',
            'copy a short verbatim quote from each',
          ],
        },
        {
          label: 'The model never',
          negated: true,
          mark: ['M12 3.5a8.5 8.5 0 1 1 0 17 8.5 8.5 0 0 1 0-17', 'M6 6l12 12'],
          items: ['produces a score', 'produces a rank', 'produces a priority'],
        },
      ]}
    />

    <p class="ch-caption">
      Every quote is checked character by character against the review it came from.
    </p>


    </div>
  </section>

  {/* ---------- 4. the one written field ---------- */}

  <section class="band full" aria-labelledby="the-one-written-field">
    <div class="band-in">
      <h2 id="the-one-written-field">The one written field</h2>

    <div class="written">
      <div class="w-col">
        <p class="w-head">Extracted or computed</p>
        <p class="w-body">
          Quotes, ratings, versions, dates, counts, scores, verdicts — copied from a review or
          calculated in TypeScript.
        </p>
      </div>
      <div class="w-col is-written">
        <p class="w-head"><span class="pill">written</span> What nobody offers</p>
        <p class="w-body">
          The four lenses, and one sentence per pattern. Each carries this badge and a date.
        </p>
        <p class="w-count num">
          {gapCount}
          <span>written {gapCount === 1 ? 'sentence' : 'sentences'}, site-wide</span>
        </p>
      </div>
    </div>

    <p class="ch-caption">
      Every lens also states why it might not work. Read them on{' '}
      <a href={url('/patterns')}>patterns</a>.
    </p>


    </div>
  </section>

  {/* ---------- the one door ---------- */}

  <section class="band band-quiet full" aria-labelledby="method-heading">
    <div class="band-in is-wide">
      <details class="method">
        <summary>
          <span class="sum-title" id="method-heading">Full method — for anyone who wants to check the arithmetic</span>
        </summary>

        <div class="method-in">
          <h3>How the score is computed</h3>
    {
      seedProblem && seedProduct && (
        <ScoreCalculator
          problem={seedProblem}
          productName={seedProduct.name}
          threshold={threshold}
        />
      )
    }

    {/*
      The same arithmetic the prose describes, set as an equation. The weights
      are read from scoring.ts, so this cannot drift out of step with the code.
    */}
    <figure class="equation" aria-label="The scoring formula">
      <pre><code>score = 100 × (
{
  COMPONENT_ORDER.map((key, i) => (
    <>{'  '}{i === 0 ? ' ' : '+'} {WEIGHTS[key].toFixed(2)} × {key}{'\n'}</>
  ))
})</code></pre>
    </figure>

    <SpecBento
      items={COMPONENT_ORDER.map((key) => ({
        key,
        label: COMPONENT_LABELS[key],
        weight: WEIGHTS[key],
        note: componentMeaning[key],
      }))}
      caption="Each component's weight, and what it counts."
    />


          <h3>The verdict</h3>
    <Flow
      steps={[
        { test: 'Fewer than four distinct reviewers', verdict: 'Thin evidence', count: thin.length },
        { test: 'Three or more existing products already solve it', verdict: 'Already solved', count: solved.length },
        { test: `Scores at or above the threshold of ${threshold.toFixed(1)}`, verdict: 'Strong signal', count: strong.length },
      ]}
      fallthrough={{ verdict: 'Recurring', count: recurring.length }}
    />
    <p class="ch-caption">
      Where the {active.length} active challenges currently sit, tested in this order.
    </p>

    <Histogram buckets={buckets} threshold={threshold} markScore={seedProblem?.score} />
    <p class="num ch-caption">
      Every active problem's score, in buckets of five. The threshold is the higher of{' '}
      {MIN_BUILD_THRESHOLD} and the {THRESHOLD_PERCENTILE}th percentile, so it moves with the field.
      It stands at {threshold.toFixed(1)}, and {worthBuilding} of {active.length} clear it — a pass
      rate of {passRate.toFixed(0)}%. A low one is the point.
    </p>


          <h3>One challenge, underneath</h3>
      {
        seedProblem && seedProduct ? (
          <div class="worked">
            <p class="w-which">
              <a href={url(`/challenges/${seedProblem.slug}`)}>
                {seedChallenge?.humanTitle ?? seedProblem.title}
              </a>{' '}
              <span class="w-app">in {seedProduct.name}</span>
            </p>

            <ScoreDisclosure problem={seedProblem} />

            <div class="w-grid">
              <figure>
                <figcaption>Evidence over twelve weeks</figcaption>
                {seedSeries && (
                  <Sparkline
                    series={seedSeries}
                    label={`${seedSeries.total} of ${seedProblem.evidence.length} reviews arrived in the last twelve weeks.`}
                  />
                )}
              </figure>

              <figure>
                <figcaption>Which releases it survived</figcaption>
                {seedVersions.length > 0 ? (
                  <VersionTimeline marks={seedVersions} />
                ) : (
                  <p class="w-none">
                    <EmptyMark kind="single" size={22} />
                    <span>One version only.</span>
                  </p>
                )}
              </figure>

              <figure>
                <figcaption>Which store it came from</figcaption>
                <PlatformMarks evidence={seedProblem.evidence} />
              </figure>

              <figure>
                <figcaption>What each review signalled</figcaption>
                <SignalGrid evidence={seedProblem.evidence} />
              </figure>
            </div>

            <p class="ch-caption">
              Every challenge carries all of this. On the challenge itself it is one sentence —
              {' '}<span class="quoted">{seedProblem.inputs.uniqueReviewers} people raised this</span>
              {' '}— because a person can read that and cannot read seven bars.
            </p>
          </div>
        ) : (
          <p class="w-none">
            <EmptyMark kind="none" size={24} />
            <span>No active challenge to work through yet.</span>
          </p>
        )
      }

          <h3>Twelve weeks, every challenge at once</h3>
          <FrictionField />

          <h3 id="every-scan">Every scan so far</h3>
      {
        runs.length === 0 ? (
          <p class="w-none">
            <EmptyMark kind="none" size={24} />
            <span>No scan has completed yet.</span>
          </p>
        ) : (
          <ol class="scans">
            {runs.map((run, i) => {
              const prev = runs[i + 1];
              return (
                <li>
                  <RunCard
                    date={run.date}
                    stages={[
                      { label: 'Read', value: run.funnel.fetched.total },
                      { label: 'Screened', value: run.funnel.screened.total },
                      { label: 'Complaints', value: run.funnel.filtered.total },
                      { label: 'Carried', value: run.funnel.capped.total },
                    ]}
                    problems={run.problemsTotal ?? 0}
                    fresh={run.problemsNew ?? 0}
                    coverage={{
                      ok: run.products.filter((x) => x.playOk).length,
                      of: run.products.length,
                    }}
                    delta={
                      prev
                        ? {
                            problems: (run.problemsTotal ?? 0) - (prev.problemsTotal ?? 0),
                            fetched: run.funnel.fetched.total - prev.funnel.fetched.total,
                          }
                        : undefined
                    }
                    connected={i < runs.length - 1}
                  />
                  <CoverageGrid run={run} names={(slug) => getProduct(slug)?.name ?? slug} />
                </li>
              );
            })}
          </ol>
        )
      }

        <h3>Where the data comes from</h3>


        <p>
          Two sources, both public, neither requiring credentials or an agreement.
        </p>

        <h4>Apple App Store</h4>
        <p>
          Apple publishes a customer reviews feed for each app in each storefront. Friction reads up to
          ten pages per app per storefront, at one request per second, from {storefrontSentence}. Each
          review carries a star rating, an app version, a country and a date. This is the backbone of
          the project.
        </p>

        <h4>Google Play</h4>
        <p>
          Google publishes no API for reading reviews of apps you do not own. Friction reads publicly
          visible review pages using the <code>google-play-scraper</code> package, at one request per
          second, taking the most recent English reviews from the United States storefront. Play
          reviews carry no title, and often no app version.
        </p>
        <p>
          Play is an enhancement, not a dependency. If it fails for an app, the run continues with
          Apple data alone and the gap is recorded.
          {
            playGaps.length === 0
              ? ' In the most recent scan every tracked app returned Play data.'
              : ` In the most recent scan ${playGaps.length} of ${products.length} apps returned no Play data: ${playGaps.map((p) => p.slug).join(', ')}.`
          }
        </p>
        <h3>How reviews become challenges</h3>


        <p>
          Most of the filtering is deterministic and happens before any model sees anything. A review is
          rejected outright if it has already been processed, if it is older than {MAX_AGE_DAYS} days, if
          the title and body together run under {MIN_TEXT_LENGTH} characters, or if it matches the
          crisis language screen below.
          What survives is kept only when it is rated three stars or lower and contains at least one of
          a fixed list of complaint markers. The survivors are ranked by marker count, then star rating,
          then recency, and capped at {CANDIDATE_CAP} per run.
        </p>

        <p>
          Those go to a language model with one job: group reviews that describe the same
          underlying problem, and copy a short verbatim quote from each. The model is explicitly
          forbidden from producing a score, a rank or a priority of any kind. Its output is then parsed
          against a strict schema and every quote is checked, character by character, against the review
          it claims to come from. If any check fails the run stops and nothing is published, leaving the
          previous week's data in place.
        </p>
        <h3>How the score is computed</h3>


        <p>
          Seven components, each normalised to a value between 0 and 1 over evidence from the last{' '}
          {EVIDENCE_WINDOW_DAYS} days, multiplied by the weights below, and scaled to 0–100.
        </p>

        <p>
          Open "How this score is calculated" on any problem page to see these seven values for that
          problem, with the raw counts behind each one and the arithmetic that produces the total.
        </p>
        <h3>The verdict, and why most challenges fail</h3>


        <p>
          The verdict is decided in a fixed order. Fewer than four distinct reviewers is
          <strong>Thin evidence</strong>, whatever the score. Three or more existing products that already
          solve it is <strong>Already solved</strong>. Otherwise a score at or above the build threshold
          is <strong>Strong signal</strong>, and anything else is <strong>Recurring</strong>.
        </p>

        <p class="num">
          The threshold is the higher of {MIN_BUILD_THRESHOLD} and the {THRESHOLD_PERCENTILE}th
          percentile of all active problem scores, computed by linear interpolation between the closest
          ranks. It currently stands at <strong>{threshold.toFixed(1)}</strong>.
          {
            active.length > 0 && (
              <>
                {' '}Of {active.length} active {active.length === 1 ? 'challenge' : 'challenges'},{' '}
                {worthBuilding} {worthBuilding === 1 ? 'carries' : 'carry'} the "Strong signal"
                verdict, a pass rate of {passRate.toFixed(0)}%.
              </>
            )
          }
        </p>

        <p>
          That low pass rate is deliberate. A site where everything looks promising is worth nothing to
          anyone deciding what to work on, so the bar moves with the field and never drops below{' '}
          {MIN_BUILD_THRESHOLD}. A problem with no new evidence for {STALE_AFTER_DAYS} days is marked
          stale; it stays readable but is left out of the homepage and out of the threshold calculation.
        </p>
        <h3>What this method cannot tell you</h3>


        <h4>Reviews have no permanent link</h4>
        <p>
          Neither store gives an individual review a stable public URL. This is the single biggest
          limitation of the whole project and it cannot be engineered away. Evidence therefore links to
          the app's review listing, not to the review itself, and every quote is labelled with the date
          the scan captured it. You cannot click through and re-read the original. What you can do is
          read the commit history in the repository, where every scan's output is recorded with a
          timestamp.
        </p>

        <h4>Coverage is narrow</h4>
        <p>
          English-language reviews, {storefronts.length} Apple storefronts, one Play storefront, mobile apps only, and
          only the {products.length} apps currently tracked. A quiet app produces a small sample, and a
          small sample produces an unreliable score. Treat a scored problem as a starting point for your
          own research, not as a conclusion.
        </p>
        <h3>Privacy</h3>


        <ul>
          <li>
            <strong>No reviewer name is ever stored.</strong> Names are hashed with a secret salt the
            moment they are read, truncated to sixteen characters, and discarded. The hash exists only
            to count distinct people and is never displayed.
          </li>
          <li>
            <strong>Quotes are capped at 25 words</strong> and must be verbatim. A quote that is not a
            character-for-character substring of the review it cites fails validation and stops the run.
          </li>
          <li>
            <strong>Raw review text is deleted after 30 days.</strong> Full review bodies exist only in
            the intermediate files for a single scan; the published records keep the capped quote and
            nothing more.
          </li>
        </ul>
        <h3>What is never tracked</h3>


        <p>
          Apps whose subject matter is personal distress or health are never tracked. The check runs
          before any request is made, against the app name, the developer name and the store category,
          and the tracked list is not exempt from it. An app matching any of these terms is excluded:
        </p>

        <ul class="chips struck" aria-label="Excluded app subjects">
          {APP_DENYLIST.map((term) => <li>{term}</li>)}
        </ul>

        <p>
          Separately, any individual review whose text matches crisis language is dropped before it
          enters the pipeline. Such a review is never stored, never quoted and never counted towards any
          score. The list of terms lives in the source rather than on this page.
        </p>

        <p>
          Both screens match inflected forms as well as the exact words. They are deliberately broad.
          Excluding something that belonged is a cost worth paying here.
        </p>
        <h3>Non-commercial</h3>


        <p>
          Friction has no ads, no payments, no signup, no paywall and no affiliate links, and it is not
          affiliated with any of the apps it tracks. It reads publicly visible reviews and publishes the
          analysis with the method attached. If you think something here is wrong, the data and the code
          are both <a href="https://github.com/Jayharwani/friction" rel="noopener noreferrer">in the
          repository</a> and you can check it yourself.
        </p>

        {
          problems.length === 0 && (
            <p class="empty-note">
              No challenges have been recorded yet, so the threshold and pass rate above are computed from
              an empty set.
            </p>
          )
        }

        </div>
      </details>
    </div>
  </section>
</Layout>

<style>

  /* ---- the model's job, as two columns ---- */

  .does {
    display: grid;
    gap: var(--space-md);
    margin: var(--space-lg) 0;
  }

  @media (min-width: 34rem) {
    .does {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .d-panel {
    padding: var(--space-md);
    border-radius: var(--r-card);
    border: var(--rule-hair) solid var(--color-rule);
    background: var(--color-paper-2);
  }

  /* The forbidden side is the one that matters, so it carries the accent. */
  .is-never {
    background: color-mix(in oklch, var(--color-accent) 8%, var(--color-paper));
    border-color: color-mix(in oklch, var(--color-accent) 30%, var(--color-rule));
  }

  .d-head {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    margin: 0 0 var(--space-xs);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .d-head svg {
    flex: none;
    color: var(--color-neutral);
  }

  .is-never .d-head svg {
    color: var(--color-accent);
  }

  .plain {
    list-style: none;
    margin: var(--space-sm) 0 0;
    padding: 0;
    font-size: var(--text-sm);
  }

