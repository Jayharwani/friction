<script>
  import { initCalculator } from '../scripts/calculator';

  /**
   * Marks the section being read in the margin contents. An
   * IntersectionObserver, never a scroll listener, and it only sets an
   * attribute — nothing here animates.
   */
  function watchSections(): void {
    const links = new Map<string, HTMLAnchorElement>();
    for (const a of document.querySelectorAll<HTMLAnchorElement>('[data-toc]')) {
      links.set(a.dataset.toc!, a);
    }
    if (links.size === 0) return;

    const seen = new Set<string>();
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) seen.add(e.target.id);
          else seen.delete(e.target.id);
        }
        // The topmost visible heading wins, so the mark never jumps backwards.
        let current: string | null = null;
        for (const id of links.keys()) {
          if (seen.has(id)) { current = id; break; }
        }
        for (const [id, a] of links) {
          if (id === current) a.setAttribute('aria-current', 'true');
          else a.removeAttribute('aria-current');
        }
      },
      { rootMargin: '-20% 0px -70% 0px' },
    );

    for (const id of links.keys()) {
      const el = document.getElementById(id);
      if (el) io.observe(el);
    }
    document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
  }

  document.addEventListener('astro:page-load', () => {
    watchSections();
    initCalculator();
  });
</script>

