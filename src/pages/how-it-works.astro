---
/**
 * How it works, on the pattern Google uses for the same job.
 *
 * A split hero with one animated diagram that replaces the page, a row of
 * sub-navigation tabs, and four illustrated cards. The arithmetic — the
 * weights, the calculator, the verdict logic, the twelve-week field, the
 * scan record and the full methodology prose — is at
 * /how-it-works/full-method, unchanged, reached by choice.
 *
 * The v4 cut got this page to 349 words, which was the right length and the
 * wrong page: at two illustrations it was seven times less visual per word
 * than the reference. The fix was never fewer words. It was pictures.
 *
 * Every card is Google's anatomy: illustration at roughly 60% of the card,
 * a small tracked label, a four-to-six-word headline, three lines of body.
 */
import Layout from '../layouts/Layout.astro';
import PageTexture from '../components/PageTexture.astro';
import BrandMark from '../components/BrandMark.astro';
import PipelineDiagram from '../components/ui/PipelineDiagram.astro';
import SubNav from '../components/ui/SubNav.astro';
import ExplainerScene, { type Explainer } from '../components/ui/art/ExplainerScene.astro';
import Button from '../components/ui/Button.astro';
import CompareRows from '../components/table/CompareRows.astro';
import { url } from '../lib/url';
import { getGaps, getLatestRun } from '../lib/data';
import { CANDIDATE_CAP } from '../../scripts/validate';

const run = getLatestRun();
const gapCount = Object.keys(getGaps()).length;

interface Card {
  id: string;
  scene: Explainer;
  label: string;
  tab: string;
  head: string;
  body: string;
}

/*
 * Four cards, thirty-five words of body each at most. The count is the point
 * of this page: four times thirty-five is 140 words carrying four
 * illustrations, where the version before carried 349 words and two.
 */
const CARDS: Card[] = [
  {
    id: 'sources',
    scene: 'sources',
    label: 'WHERE IT COMES FROM',
    tab: 'Where it comes from',
    head: 'Two public review feeds',
    body: `Both stores publish reviews without credentials or an agreement. Friction read ${run ? run.funnel.fetched.total.toLocaleString('en-GB') : 'ten thousand'} of them in its last scan.`,
  },
  {
    id: 'filter',
    scene: 'filter',
    label: 'WHAT GETS THROWN AWAY',
    tab: 'What gets thrown away',
    head: 'Ten thousand in, a hundred out',
    body: `Screened for age, for length and by the crisis check, then for a complaint, then capped at ${CANDIDATE_CAP}. All of it code, before any model sees anything.`,
  },
  {
    id: 'model',
    scene: 'model',
    label: 'WHAT THE MODEL DOES',
    tab: 'What the model does',
    head: 'It groups, and it quotes',
    body: 'It puts reviews describing the same struggle together and copies a short quote from each. It never produces a score, a rank or a priority.',
  },
  {
    id: 'written',
    scene: 'written',
    label: 'THE ONE WRITTEN FIELD',
    tab: 'The written field',
    head: 'One sentence is written',
    body: `Every value is copied from a review or calculated in TypeScript, except the four lenses and ${gapCount} sentences. Those carry a badge and a date.`,
  },
];

const TABS = [
  ...CARDS.map((c) => ({ id: c.id, label: c.tab })),
  { id: 'method', label: 'Full method', href: url('/how-it-works/full-method') },
];
---

<Layout
  title="How it works"
  description="Where Friction's data comes from, what it throws away, what the model does and never does, and the one field that is written."
>
  {/* ---------- the split hero ---------- */}
  <section class="page-hero full">
    <PageTexture seed="how-it-works" />
    <BrandMark variant="device" />

    <div class="hero-in">
      <div class="say">
        <h1>How Friction finds what people struggle with</h1>
        <p class="lede">
          Ten thousand public reviews a week, filtered in code, grouped by what repeats, and
          quoted. Every number here is calculated; almost nothing is written.
        </p>
        <Button variant="tonal" to="/how-it-works/full-method">Check the arithmetic</Button>
      </div>

      <PipelineDiagram />
    </div>
  </section>

  <div class="shell sticky-nav">
    <div class="bleed">
      <SubNav items={TABS} label="Sections of this page" />
    </div>
  </div>

  {/* ---------- four cards, one per tab ---------- */}
  <div class="shell">
    <div class="cards bleed">
      {
        CARDS.map((card) => (
          <article class="card" id={card.id}>
            <ExplainerScene scene={card.scene} />
            <div class="body">
              <p class="label">{card.label}</p>
              <h2>{card.head}</h2>
              <p class="note">{card.body}</p>
            </div>
          </article>
        ))
      }
    </div>

    {/*
      The credibility claim stays on this page rather than behind a click.
      It is the one thing a sceptic came for.
    */}
    <section class="claim bleed" aria-labelledby="claim-heading">
      <h2 id="claim-heading" class="sr-only">What the model does, and never does</h2>
      <CompareRows
        mode="lists"
        columns={[
          {
            label: 'The model does',
            mark: ['M3 6.5h7', 'M3 12h7', 'M3 17.5h7', 'M14 12h7', 'M18 8.5l3 3.5-3 3.5'],
            items: [
              'group reviews describing the same struggle',
              'copy a short verbatim quote from each',
            ],
          },
          {
            label: 'The model never',
            negated: true,
            mark: ['M12 3.5a8.5 8.5 0 1 1 0 17 8.5 8.5 0 0 1 0-17', 'M6 6l12 12'],
            items: ['produces a score', 'produces a rank', 'produces a priority'],
          },
        ]}
      />
      <p class="ch-caption">
        Every quote is checked character by character against the review it came from.
      </p>
    </section>

    <p class="onward bleed">
      <Button variant="filled" to="/how-it-works/full-method">See the full method</Button>
    </p>
  </div>
</Layout>

<style>
  /* ---- the split hero ---- */

  .page-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: var(--space-3xl);
  }

  .hero-in {
    position: relative;
    z-index: var(--z-raise);
    display: grid;
    gap: var(--space-2xl);
    align-items: center;
    width: min(76rem, 100% - (var(--page-gutter) * 2));
    margin-inline: auto;
  }

  @media (min-width: 62rem) {
    .hero-in {
      grid-template-columns: minmax(0, 1fr) minmax(0, 26rem);
      gap: var(--space-3xl);
    }
  }

  h1 {
    font-size: var(--display-sm);
    font-weight: 300;
    line-height: var(--line-display);
    letter-spacing: -0.03em;
    text-wrap: balance;
    max-width: 16em;
  }

  .lede {
    margin-block: var(--space-md) var(--space-lg);
    max-width: 34em;
    font-size: var(--body-lg);
    line-height: var(--line-body);
    color: var(--m-on-surface-variant);
    text-wrap: pretty;
  }

  /* ---- the tabs ---- */

  .sticky-nav {
    position: sticky;
    top: var(--nav-h);
    z-index: var(--z-raise);
    background: var(--m-surface);
    padding-block: var(--space-2xs);
  }

  /* ---- the cards ---- */

  /* Two by two, the way the reference does it: each card needs the width
     for its illustration to be read, not to be fitted in. */
  .cards {
    display: grid;
    gap: var(--space-lg);
    padding-top: var(--space-2xl);
    max-width: 62rem;
  }

  @media (min-width: 52rem) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .card {
    display: grid;
    align-content: start;
    overflow: hidden;
    border-radius: var(--shape-lg);
    background: var(--m-surface-container);
    /* The tabs scroll it into view; leave room for them above it. */
    scroll-margin-top: calc(var(--nav-h) + 4rem);
  }

  .body {
    padding: var(--space-lg);
  }

  .label {
    font-size: var(--label-sm);
    letter-spacing: 0.08em;
    color: var(--m-on-surface-variant);
  }

  .card h2 {
    margin-top: var(--space-2xs);
    font-size: var(--title-lg);
    font-weight: 500;
    text-wrap: balance;
  }

  .note {
    margin-top: var(--space-xs);
    font-size: var(--body-md);
    line-height: var(--line-body);
    color: var(--m-on-surface-variant);
    text-wrap: pretty;
  }

  /* ---- the claim ---- */

  .claim {
    max-width: 62rem;
    margin-top: var(--space-2xl);
    padding: var(--space-lg);
    border-radius: var(--shape-lg);
    background: var(--m-surface-container);
  }

  .onward {
    padding-block: var(--space-2xl) var(--space-4xl);
  }
</style>
