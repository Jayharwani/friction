---
/**
 * Scratch page: every chart in the kit, against real data, on one screen.
 *
 * TEMPORARY ROUTE. Astro does not serve underscore-prefixed pages even in dev,
 * so this has to be a real route to be looked at. Delete before deploying.
 */
import Layout from '../layouts/Layout.astro';
import Sparkline from '../components/charts/Sparkline.astro';
import StackedBar from '../components/charts/StackedBar.astro';
import Histogram from '../components/charts/Histogram.astro';
import Funnel from '../components/charts/Funnel.astro';
import VersionTimeline from '../components/charts/VersionTimeline.astro';
import Flow from '../components/charts/Flow.astro';
import {
  categoryMix,
  platformSplit,
  scoreBuckets,
  verdictMix,
  versionMarks,
  weeklySeries,
} from '../lib/charts';
import { getActiveProblems, getBuildThreshold, getLatestRun, getProblems } from '../lib/data';
import { MIN_BUILD_THRESHOLD } from '../lib/scoring';

const all = getProblems();
const active = getActiveProblems();
const run = getLatestRun()!;
const threshold = getBuildThreshold();

const top = all[0]!;
const topSeries = weeklySeries(top.evidence);
const sparse = all.reduce((a, b) => (b.evidence.length < a.evidence.length ? b : a), all[0]!);

const thin = active.filter((p) => new Set(p.evidence.map((e) => e.reviewerHash)).size < 4);
const solved = active.filter(
  (p) => !thin.includes(p) && p.existingSolutions.length >= 3,
);
const strong = active.filter(
  (p) => !thin.includes(p) && !solved.includes(p) && p.score >= threshold,
);
const recurring = active.filter(
  (p) => !thin.includes(p) && !solved.includes(p) && p.score < threshold,
);
---

<Layout title="Chart kit">
  <div class="shell kit">
    <h1>Chart kit</h1>
    <p class="note">
      Every component against live data. Not a route — this page is not built into the site.
    </p>

    <section>
      <h2>Sparkline — {top.title}</h2>
      <div class="inline-demo">
        <span>In a row:</span>
        <Sparkline series={topSeries} />
        <span class="num">{topSeries.total} reviews</span>
      </div>
      <div class="wide">
        <Sparkline series={topSeries} scale={2} />
      </div>
      <h3>The sparse case — {sparse.title}</h3>
      <div class="wide">
        <Sparkline series={weeklySeries(sparse.evidence)} scale={2} />
      </div>
    </section>

    <section>
      <h2>StackedBar</h2>
      <h3>Verdict mix, all {all.length} problems</h3>
      <StackedBar segments={verdictMix(all)} of="of all problems" />
      <h3>Platform split, {top.title}</h3>
      <StackedBar segments={platformSplit(top.evidence)} of="of this problem's evidence" />
      <h3>Category mix</h3>
      <StackedBar segments={categoryMix(all)} of="of all problems" />
    </section>

    <section>
      <h2>Histogram — {active.length} active scores</h2>
      <Histogram buckets={scoreBuckets(active.map((p) => p.score))} threshold={threshold} markScore={top.score} />
    </section>

    <section>
      <h2>Funnel — scan of {run.date}</h2>
      <Funnel
        stages={[
          { label: 'Read', value: run.funnel.fetched.total, note: 'Every review pulled from both stores, including ones already processed in an earlier scan.' },
          { label: 'Screened', value: run.funnel.screened.total, note: 'Survived deduplication, the age limit, the length floor and the crisis screen.' },
          { label: 'Complaints', value: run.funnel.filtered.total, note: 'Rated three stars or lower and carrying at least one complaint marker.' },
          { label: 'Carried', value: run.funnel.capped.total, note: 'Ranked and capped, then grouped into problems.' },
        ]}
      />
      <h3>Compact</h3>
      <Funnel
        compact
        stages={[
          { label: 'Read', value: run.funnel.fetched.total },
          { label: 'Screened', value: run.funnel.screened.total },
          { label: 'Complaints', value: run.funnel.filtered.total },
          { label: 'Carried', value: run.funnel.capped.total },
        ]}
      />
    </section>

    <section>
      <h2>VersionTimeline — {top.title}</h2>
      <div class="panel-demo">
        <VersionTimeline marks={versionMarks(top)} />
      </div>
    </section>

    <section>
      <h2>Flow — live verdict populations</h2>
      <Flow
        steps={[
          { test: 'Fewer than four distinct reviewers', verdict: 'Thin evidence', count: thin.length },
          { test: 'Three or more existing products already solve it', verdict: 'Already solved', count: solved.length },
          { test: `Scores at or above the threshold of ${threshold.toFixed(1)}`, verdict: 'Strong signal', count: strong.length },
        ]}
        fallthrough={{ verdict: 'Recurring', count: recurring.length }}
      />
      <p class="note num">
        Threshold floor is {MIN_BUILD_THRESHOLD}; it currently stands at {threshold.toFixed(1)}.
      </p>
    </section>
  </div>
</Layout>

<style>
  .kit {
    padding-block: var(--space-2xl);
  }

  section {
    margin-top: var(--space-2xl);
    padding-top: var(--space-lg);
    border-top: var(--rule-hair) solid var(--color-rule);
  }

  h2 {
    font-size: var(--text-lg);
  }

  h3 {
    margin-top: var(--space-lg);
    font-size: var(--text-sm);
    color: var(--color-muted);
    font-weight: 400;
  }

  .note {
    margin-top: var(--space-xs);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .inline-demo {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-top: var(--space-sm);
    font-size: var(--text-sm);
  }

  .wide,
  .panel-demo {
    margin-top: var(--space-sm);
  }

  /* The timeline lives in a 20rem panel on problem pages; test it at that width. */
  .panel-demo {
    width: 20rem;
    container-type: inline-size;
    padding: var(--space-md);
    background: var(--color-paper-2);
    border-radius: 6px;
  }
</style>
