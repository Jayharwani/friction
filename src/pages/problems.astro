---
/**
 * Every problem, filterable.
 *
 * This used to be the bottom two thirds of the homepage. Splitting it out is
 * what lets the homepage be a pitch and lets this be an index.
 */
import Layout from '../layouts/Layout.astro';
import PageTexture from '../components/PageTexture.astro';
import BrandMark from '../components/BrandMark.astro';
import ProblemCard from '../components/ProblemCard.astro';
import CategoryGlyph from '../components/CategoryGlyph.astro';
import { getProblems, getProduct } from '../lib/data';
import { FAMILIES, FAMILY_LABEL, FAMILY_NOTE, familyOf } from '../lib/categories';
import { VERDICTS } from '../../scripts/validate';

const problems = getProblems();

const apps = [...new Set(problems.map((p) => p.productSlug))]
  .map((slug) => ({ slug, name: getProduct(slug)?.name ?? slug }))
  .sort((a, b) => a.name.localeCompare(b.name));

const verdicts = VERDICTS.filter((v) => problems.some((p) => p.verdict === v));

/* Families that actually have problems, with their counts. Filtering by a
   family that would return nothing is a dead control. */
const families = FAMILIES.map((family) => ({
  family,
  count: problems.filter((p) => familyOf(p.category) === family).length,
})).filter((f) => f.count > 0);
---

<Layout
  title="Problems"
  description="Every recurring complaint Friction has recorded, with the evidence behind each one."
>
  <div class="band">
    <PageTexture seed="problems" />
    <BrandMark variant="device" />
    <div class="shell">
      <h1 class="bleed">Every problem found so far.</h1>
      <p class="sub bleed">{problems.length} complaints, each reported by several people over several weeks.</p>
    </div>
  </div>

  <div class="shell" data-problems>
    {/*
      Families as chips rather than a select: each carries its own glyph and
      colour, so the control teaches the encoding used on every card below it.
    */}
    <div class="chips bleed" role="group" aria-label="Filter by family">
      <button type="button" class="chip" data-family-chip="all" aria-pressed="true">
        <span class="c-label">All</span>
        <span class="c-count num">{problems.length}</span>
      </button>
      {
        families.map(({ family, count }) => (
          <button
            type="button"
            class="chip"
            data-family={family}
            data-family-chip={family}
            aria-pressed="false"
            title={FAMILY_NOTE[family]}
          >
            <CategoryGlyph family={family} size={16} />
            <span class="c-label">{FAMILY_LABEL[family]}</span>
            <span class="c-count num">{count}</span>
          </button>
        ))
      }
    </div>

    <div class="controls bleed" role="group" aria-label="Filter problems">
      <p class="field">
        <label for="f-app">App</label>
        <select id="f-app" data-filter="app">
          <option value="all">All apps</option>
          {apps.map((a) => <option value={a.slug}>{a.name}</option>)}
        </select>
      </p>

      <p class="field">
        <label for="f-verdict">Verdict</label>
        <select id="f-verdict" data-filter="verdict">
          <option value="all">Any verdict</option>
          {verdicts.map((v) => <option value={v}>{v}</option>)}
        </select>
      </p>

      <p class="field">
        <label for="f-platform">Platform</label>
        <select id="f-platform" data-filter="platforms">
          <option value="all">Both stores</option>
          <option value="ios">iOS</option>
          <option value="android">Android</option>
        </select>
      </p>

      <p class="count num" data-problems-count aria-live="polite">{problems.length} problems</p>
    </div>

    <section class="grid bleed" data-problems-grid aria-label="Problems">
      {problems.map((problem) => <ProblemCard problem={problem} filterable />)}
    </section>

    <p class="empty" data-problems-empty hidden>
      Nothing matches those filters.
    </p>
  </div>
</Layout>

<script>
  import { initProblemFilters } from '../scripts/problem-filters';

  document.addEventListener('astro:page-load', initProblemFilters);
</script>

<style>
  .band {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: var(--space-2xl);
    background: var(--color-paper-2);
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }

  /* The heading sits above its own texture. */
  .band > .shell {
    position: relative;
    z-index: 1;
  }

  h1 {
    font-size: clamp(1.7rem, 1rem + 2.2vw, 2.6rem);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -0.028em;
    text-wrap: balance;
  }

  .sub {
    margin-top: var(--space-sm);
    color: var(--color-muted);
    max-width: 42em;
  }

  /* ---- family chips ---- */

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    padding-top: var(--space-xl);
  }

  /*
   * A chip carries its family three ways at once — glyph, name and colour —
   * so the colour is never doing the work on its own, and the control
   * teaches the encoding used by every card below it.
   */
  .chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    min-height: var(--tap);
    padding: var(--space-2xs) var(--space-sm);
    font: inherit;
    font-size: var(--text-xs);
    color: var(--color-ink);
    background: var(--color-paper-2);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: 999px;
    cursor: pointer;
  }

  .chip :global(.glyph) {
    color: var(--cat);
  }

  .chip:hover {
    border-color: var(--cat-edge, var(--color-rule));
    background: var(--cat-tint, var(--color-paper-3));
  }

  .chip[aria-pressed='true'] {
    background: var(--cat-tint-2, var(--color-paper-3));
    border-color: var(--cat, var(--color-ink));
    font-weight: 500;
  }

  .c-count {
    color: var(--color-muted);
  }

  .chip[aria-pressed='true'] .c-count {
    color: var(--color-ink);
  }

  @media (prefers-reduced-motion: no-preference) {
    .chip {
      transition:
        background-color var(--dur-micro) var(--ease-out),
        border-color var(--dur-micro) var(--ease-out);
    }
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--space-md) var(--space-lg);
    padding-block: var(--space-xl) var(--space-lg);
  }

  .field {
    margin: 0;
  }

  label {
    display: block;
    font-size: var(--text-xs);
    color: var(--color-muted);
    margin-bottom: var(--space-2xs);
  }

  select {
    font: inherit;
    font-size: var(--text-xs);
    color: var(--color-ink);
    background: var(--color-paper-2);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: 4px;
    padding: var(--space-2xs) var(--space-xs);
  }

  select:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .count {
    margin: 0 0 var(--space-2xs) auto;
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: var(--space-md);
    padding-bottom: var(--space-3xl);
  }

  .empty {
    padding-block: var(--space-2xl) var(--space-3xl);
    color: var(--color-muted);
  }
</style>
