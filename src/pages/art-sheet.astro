---
/** Scratch sheet for judging the illustration set. Not linked, noindex. */
import Layout from '../layouts/Layout.astro';
import CategoryScene from '../components/art/CategoryScene.astro';
import LensMark from '../components/art/LensMark.astro';
import EmptyMark from '../components/EmptyMark.astro';
import { FAMILIES, FAMILY_LABEL } from '../lib/categories';

const LENSES = ['build', 'start', 'study', 'write'] as const;
const EMPTIES = ['none', 'filter', 'single', 'quiet', 'platform', 'search'] as const;
---

<Layout title="Art sheet" description="Scratch">
  <div class="shell">
    <div class="bleed sheet">
      <h1>Eight scenes</h1>
      <div class="scenes">
        {FAMILIES.map((f) => (
          <figure data-family={f}>
            <CategoryScene family={f} />
            <figcaption>{FAMILY_LABEL[f]}</figcaption>
          </figure>
        ))}
      </div>

      <h2>Four lens marks</h2>
      <div class="marks">
        {LENSES.map((l) => (
          <figure data-lens={l}>
            <LensMark lens={l} size={48} />
            <figcaption>{l}</figcaption>
          </figure>
        ))}
      </div>

      <h2>Six empty states</h2>
      <div class="marks">
        {EMPTIES.map((k) => (
          <figure><EmptyMark kind={k} size={34} /><figcaption>{k}</figcaption></figure>
        ))}
      </div>
    </div>
  </div>
</Layout>

<style>
  .sheet { padding-block: var(--space-2xl); }
  h1, h2 { font-size: var(--text-lg); font-weight: 600; margin-block: var(--space-2xl) var(--space-md); }
  .scenes { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: var(--space-lg); }
  .marks { display: flex; gap: var(--space-2xl); flex-wrap: wrap; }
  figure { margin: 0; display: grid; justify-items: center; gap: var(--space-2xs); }
  figcaption { font-size: var(--text-xs); color: var(--color-muted); }
  [data-lens='build'] { --lens: var(--cat-stability); }
  [data-lens='start'] { --lens: var(--cat-money); }
  [data-lens='study'] { --lens: var(--cat-access); }
  [data-lens='write'] { --lens: var(--cat-support); }
</style>
