---
/**
 * The source for the social card.
 *
 * Not a page anyone navigates to — it is a 1200x630 board that gets captured
 * once to `public/og.png`, which is what `og:image` actually points at.
 * Platforms will not render an SVG and most will not run JavaScript, so a
 * committed raster is the only thing that reliably previews.
 *
 * It is built from the live data rather than drawn by hand, so regenerating
 * it after a scan keeps the numbers honest:
 *
 *   npm run build && npx astro preview --port 4331
 *   node <harness>/full.mjs http://localhost:4331/friction/og public/og.png 1200 630
 *
 * noindex, and excluded from the sitemap.
 */
import { formatDate, getLatestRun, getProblems, getProducts } from '../lib/data';
import { familyOf } from '../lib/categories';
import AppIcon from '../components/AppIcon.astro';

const run = getLatestRun();
const problems = getProblems();
const products = getProducts();

const reviewsRead = run?.funnel.fetched.total ?? 0;
/* The board takes the top problem's family tint, so the card is coloured by
   whatever the site is actually leading with that week. */
const leadFamily = problems[0] ? familyOf(problems[0].category) : 'stability';
---

<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <title>Friction — social card</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body>
    <div class="board" data-family={leadFamily}>
      <header>
        <p class="mark">
          <span class="cells" aria-hidden="true">
            <i></i><i class="hot"></i><i></i>
            <i></i><i class="warm"></i><i></i>
            <i></i><i></i><i></i>
          </span>
          Friction
        </p>
        <p class="url">jayharwani.github.io/friction</p>
      </header>

      <h1>See what's broken in the apps everyone uses.</h1>

      <p class="sub">
        Public App Store and Google Play reviews, read every week. The complaints that keep
        repeating, scored by how much evidence there is.
      </p>

      <ul class="wall">
        {products.slice(0, 12).map((p) => <li><AppIcon slug={p.slug} name={p.name} size={64} /></li>)}
      </ul>

      <dl class="stats">
        <div>
          <dt>Reviews read</dt>
          <dd>{reviewsRead.toLocaleString('en-GB')}</dd>
        </div>
        <div>
          <dt>Problems tracked</dt>
          <dd>{problems.length}</dd>
        </div>
        <div>
          <dt>Apps</dt>
          <dd>{products.length}</dd>
        </div>
        <div>
          <dt>Last checked</dt>
          <dd>{run ? formatDate(run.date) : '—'}</dd>
        </div>
      </dl>

    </div>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';

  body {
    margin: 0;
  }

  .board {
    width: 1200px;
    height: 630px;
    padding: 64px 72px;
    display: grid;
    grid-template-rows: auto auto auto 1fr auto;
    gap: 0;
    align-content: start;
    background: var(--color-paper);
    color: var(--color-ink);
    overflow: hidden;
  }

  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .mark {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0;
    font-family: var(--font-display);
    font-size: 30px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .cells {
    display: grid;
    grid-template-columns: repeat(3, 10px);
    gap: 3px;
  }

  .cells i {
    width: 10px;
    height: 10px;
    border-radius: var(--r-cell);
    background: var(--color-rule);
  }

  .cells .warm {
    background: color-mix(in oklch, var(--color-accent) 45%, var(--color-paper));
  }

  .cells .hot {
    background: var(--color-accent);
  }

  .url {
    margin: 0;
    font-size: 19px;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  h1 {
    margin: 52px 0 0;
    font-size: 68px;
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.035em;
    max-width: 16em;
  }

  .sub {
    margin: 22px 0 0;
    font-size: 23px;
    line-height: 1.45;
    color: var(--color-muted);
    max-width: 34em;
  }

  .wall {
    display: flex;
    align-self: end;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .wall li {
    margin-left: -11px;
    line-height: 0;
    border: 4px solid var(--color-paper);
    border-radius: var(--r-icon);
  }

  .wall li:first-child {
    margin-left: 0;
  }

  .stats {
    display: flex;
    gap: 56px;
    margin: 34px 0 0;
    padding-top: 26px;
    border-top: 1px solid var(--color-rule);
  }

  .stats dt {
    font-size: 17px;
    color: var(--color-muted);
  }

  .stats dd {
    margin: 4px 0 0;
    font-size: 34px;
    font-weight: 600;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  /* The board must total exactly 630 or the page scrolls and the capture
     loses 15px of width to a scrollbar. */
  html,
  body {
    overflow: hidden;
  }
</style>
