---
/**
 * Patterns — the layer the site was missing.
 *
 * Every other page shows challenges one at a time. This one shows what
 * happens when you look across them: a complaint in one app is a bug, the
 * same complaint in seven is something else.
 *
 * The counting is unchanged — committed challenges, grouped by category. The
 * lenses are not: they are written for the pattern rather than assembled
 * from its members, because the thing to do about seven apps failing the
 * same way is not the thing to do about any one of them.
 */
import Layout from '../layouts/Layout.astro';
import PageTexture from '../components/PageTexture.astro';
import BrandMark from '../components/BrandMark.astro';
import PatternCard from '../components/PatternCard.astro';
import LensCard from '../components/LensCard.astro';
import EmptyMark from '../components/EmptyMark.astro';
import { buildPatterns, PATTERN_MIN_APPS } from '../lib/patterns';
import { getActiveProblems, getGaps, getPatternLenses, getProducts } from '../lib/data';
import { LENSES, LENS_HUE } from '../lib/lenses';

const tracked = getProducts().length;
const patterns = buildPatterns(getActiveProblems(), tracked, getGaps());
const top = patterns[0];
const written = getPatternLenses();
---

<Layout
  title="Patterns"
  description="Complaint categories that appear across several different apps, counted from public store reviews."
>
  <div class="band">
    <PageTexture seed="patterns" />
    <BrandMark variant="device" />
    <div class="shell">
      <h1>The same complaints show up across different apps.</h1>
      <p class="sub">
        A complaint in one app is a bug. The same complaint in {top?.apps.length ?? PATTERN_MIN_APPS} is
        a better place to start than any one of them.
      </p>
    </div>
  </div>

  <div class="shell">
    {/*
      The lead block used to sit here, showing the top pattern's icons, app
      count and reviewer count. The first card below now carries all three at
      display size, so it was the same data twice — see the hierarchy rules.
    */}

    {
      patterns.length > 0 ? (
        <div class="stack bleed">
          {patterns.map((pattern, i) => (
            <section class="block" aria-label={pattern.category} data-first={i === 0 ? '' : undefined}>
              <PatternCard pattern={pattern} trackedApps={tracked} />

              {written[pattern.category] && (
                <div class="lens-grid">
                  {LENSES.map((lens) => (
                    <div style={`--lens:${LENS_HUE[lens]}`}>
                      <LensCard
                        lens={lens}
                        proposition={written[pattern.category]!.lenses[lens].proposition}
                        specifics={written[pattern.category]!.lenses[lens].specifics}
                        limitation={written[pattern.category]!.lenses[lens].limitation}
                        writtenBy={written[pattern.category]!.writtenBy}
                        writtenAt={written[pattern.category]!.writtenAt}
                      />
                    </div>
                  ))}
                </div>
              )}
            </section>
          ))}
        </div>
      ) : (
        <p class="empty">
          <EmptyMark kind="single" size={26} />
          <span>
            No category has reached {PATTERN_MIN_APPS} apps yet. Patterns appear here as coverage
            grows.
          </span>
        </p>
      )
    }
  
    {/*
      The field belongs here rather than on the homepage. It is a view of the
      whole dataset at once, which is exactly what this page argues about —
      on a pitch it was a picture, and here it is the evidence.
    */}
  </div>
</Layout>

<style>
  /* ---- band ---- */

  .band {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: var(--space-2xl);
    background: var(--color-paper-2);
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }

  /* The heading sits above its own texture. */
  .band > .shell {
    position: relative;
    z-index: var(--z-raise);
  }

  h1 {
    font-size: clamp(1.7rem, 1rem + 2.2vw, 2.6rem);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -0.028em;
    max-width: 18em;
    text-wrap: balance;
  }

  .sub {
    margin-top: var(--space-sm);
    color: var(--color-muted);
    max-width: 42em;
  }

  /* ---- the lead pattern: the visual, before any data ---- */

  .lead {
    padding-block: var(--space-2xl);
    text-align: center;
  }

  .lead-cat {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .lead-icons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-sm);
    list-style: none;
    margin: var(--space-md) 0 0;
    padding: 0;
  }

  .lead-fig {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-lg);
    margin-top: var(--space-md);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  /* ---- one block per pattern ---- */

  /*
   * A stack, not a grid. Each pattern now carries four lens cards beneath
   * its own claim, and side by side they read as eight unrelated cards
   * rather than two patterns.
   */
  .stack {
    display: grid;
    gap: var(--space-4xl);
    padding-block: var(--space-xl) var(--space-3xl);
  }

  .block {
    display: grid;
    gap: var(--space-lg);
  }

  /*
   * The page's one hero container, and its only 48px corner: the pattern
   * that reaches the most apps. Breaking from the shape the other cards
   * share is what makes it read as the one to look at.
   */
  .block[data-first] :global(.pattern) {
    border-radius: var(--shape-xxl);
    background: var(--m-surface-container-highest);
  }

  .lens-grid {
    display: grid;
    gap: var(--space-md);
  }

  /* The hue wrapper stretches to the row; the card stretches with it. */
  .lens-grid > div {
    display: grid;
  }

  @media (min-width: 46rem) {
    .lens-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 80rem) {
    .lens-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .empty {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding-block: var(--space-2xl);
    color: var(--color-muted);
  }
</style>
