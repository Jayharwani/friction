---
/**
 * Problem detail — the most important screen in the project (spec 6.1).
 *
 * Two columns at 1024px and above, single column below. The left column is the
 * evidence stream in reverse chronological order; the right column is the
 * computed panel, sticky on wide viewports.
 */
import Layout from '../../layouts/Layout.astro';
import ScoreDisclosure from '../../components/ScoreDisclosure.astro';
import Sparkline from '../../components/Sparkline.astro';
import EvidenceItem from '../../components/EvidenceItem.astro';
import { url } from '../../lib/url';
import { formatDate, getProblems, getProduct, platformsLabel } from '../../lib/data';
import type { Problem } from '../../../scripts/validate';

export function getStaticPaths() {
  return getProblems().map((problem) => ({
    params: { slug: problem.slug },
    props: { problem },
  }));
}

interface Props {
  problem: Problem;
}

const { problem } = Astro.props;
const product = getProduct(problem.productSlug);

// Reverse chronological: the newest report of the problem reads first.
const evidence = [...problem.evidence].sort((a, b) => b.reviewedAt.localeCompare(a.reviewedAt));

/*
 * The version timeline. A comma list of build numbers says nothing; ordered by
 * when each build was first complained about, with how many reviews named it,
 * it shows whether a problem is one bad release or a run of them.
 *
 * Ordered by first report rather than by version number on purpose: the two
 * stores number independently, so 0.6.4100 and 1.7.338 do not sort together.
 */
const versionTimeline = problem.versions
  .map((version) => {
    const dates = problem.evidence
      .filter((e) => e.version === version)
      .map((e) => e.reviewedAt)
      .sort();
    return { version, count: dates.length, first: dates[0] ?? null, last: dates.at(-1) ?? null };
  })
  .filter((row) => row.first !== null)
  .sort((a, b) => a.first!.localeCompare(b.first!));

const versionPeak = Math.max(1, ...versionTimeline.map((r) => r.count));
/** Five steps, the same ramp the field and the heat strip use. */
const heatStep = (n: number) => Math.min(4, Math.max(1, Math.ceil((n / versionPeak) * 4)));

const description = `${problem.summary.slice(0, 150)} Scored ${problem.score} from ${problem.evidence.length} app store reviews.`;
---

<Layout title={problem.title} description={description}>
  <div class="shell">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href={url(`/products/${problem.productSlug}`)}>{product?.name ?? problem.productSlug}</a>
    </nav>

    <!--
      DOM order is header, computed panel, evidence stream. Grid areas put the
      panel on the right at wide widths. Ordering it after the stream would bury
      the score below every quote on mobile, and put the score disclosure after
      all the evidence links in the tab order.
    -->
    <div class="detail bleed">
      <div class="columns">
      <header class="intro">
        <h1 transition:name={`title-${problem.slug}`}>{problem.title}</h1>
        <p class="summary">{problem.summary}</p>
        <p class="meta">
          {problem.category}, {platformsLabel(problem.platforms)}, {problem.evidence.length}{' '}
          {problem.evidence.length === 1 ? 'review' : 'reviews'}
          {problem.status === 'stale' && <span class="stale">, no new evidence in 120 days</span>}
        </p>
      </header>

      <!-- ---------- right: the computed panel ---------- -->
      <aside class="panel-column">
        <div class="sticky">
          <ScoreDisclosure problem={problem} />

          <Sparkline history={problem.history} />

          <section class="block">
            <h3>App versions</h3>
            {
              versionTimeline.length > 0 ? (
                <ol class="timeline num">
                  {versionTimeline.map((row) => (
                    <li>
                      <span class="tick" data-heat={heatStep(row.count)} aria-hidden="true" />
                      <span class="v">{row.version}</span>
                      <span class="when">
                        <time datetime={row.first!}>{formatDate(row.first!)}</time>
                      </span>
                      <span class="n">
                        {row.count}
                        <span class="sr-only"> {row.count === 1 ? 'review' : 'reviews'}</span>
                      </span>
                    </li>
                  ))}
                </ol>
              ) : (
                <p class="muted-note">No version was reported with these reviews.</p>
              )
            }
          </section>

          <section class="block">
            <h3>Platform</h3>
            <p>{platformsLabel(problem.platforms)}</p>
          </section>

          <section class="block">
            <h3>What people do instead</h3>
            {
              problem.workarounds.length > 0 ? (
                <ul class="listing">
                  {problem.workarounds.map((w) => (
                    <li>{w}</li>
                  ))}
                </ul>
              ) : (
                <p class="muted-note">No workaround was described in these reviews.</p>
              )
            }
          </section>

          <section class="block">
            <h3>What already exists</h3>
            {
              problem.existingSolutions.length > 0 ? (
                <ul class="listing">
                  {problem.existingSolutions.map((s) => (
                    <li>{s}</li>
                  ))}
                </ul>
              ) : (
                <p class="muted-note">No existing product was named in these reviews.</p>
              )
            }
          </section>

          <section class="block">
            <h3>Seen</h3>
            <p class="num dates">
              First reported <time datetime={problem.firstSeen}>{formatDate(problem.firstSeen)}</time
              >, last reported <time datetime={problem.lastSeen}>{formatDate(problem.lastSeen)}</time
              >.
            </p>
          </section>
        </div>
      </aside>

      <!-- ---------- left: the evidence stream ---------- -->
      <div class="stream">
        <h2 class="stream-heading">Evidence</h2>

        <p class="standing-note">
          Neither app store gives an individual review a permanent public link, so each entry below
          is a snapshot taken on the date shown, and the link goes to the app's review listing
          rather than to the review itself. The repository's git history is the audit trail.
        </p>

        {evidence.map((e) => <EvidenceItem evidence={e} />)}
      </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .crumb {
    padding-block: var(--space-lg) 0;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .columns {
    display: grid;
    gap: var(--space-xl);
    padding-block: var(--space-lg) var(--space-xl);
  }

  /* A container query, not a viewport query: the split responds to the space
     this block actually has. Without container-query support the rules simply
     do not apply and the single-column layout stands, which is a fine result. */
  .detail {
    container-type: inline-size;
  }

  /* Two columns only where there is room for both to stay legible. Grid areas
     place the panel on the right while it stays second in the DOM. */
  @container (min-width: 64rem) {
    .columns {
      grid-template-columns: minmax(0, 1fr) 20rem;
      grid-template-areas:
        'head  panel'
        'stream panel';
      grid-template-rows: auto 1fr;
      column-gap: var(--space-3xl);
      row-gap: 0;
      align-items: start;
    }

    .intro {
      grid-area: head;
    }

    .stream {
      grid-area: stream;
    }

    /* Stretched rather than content-height, otherwise the sticky child has no
       room to travel and never actually sticks. */
    .panel-column {
      grid-area: panel;
      align-self: stretch;
      height: 100%;
    }
  }

  .stream {
    min-width: 0;
  }

  .intro {
    max-width: var(--measure);
  }

  h1 {
    /* Problem titles get the serif, like the quotes they summarise. */
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 500;
    letter-spacing: -0.014em;
    line-height: 1.18;
  }

  .summary {
    margin-top: var(--space-md);
    max-width: var(--measure);
  }

  .meta {
    margin-top: var(--space-sm);
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }

  .stale {
    color: var(--color-muted);
  }

  .stream-heading {
    margin-top: var(--space-xl);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  /* A hairline aside, not a tinted panel: the site carries no cards. */
  .standing-note {
    margin-top: var(--space-sm);
    max-width: var(--measure);
    font-size: var(--text-sm);
    color: var(--color-muted);
    border-left: 2px solid var(--color-rule);
    padding-left: var(--space-md);
  }

  .stream :global(.evidence) {
    max-width: var(--measure);
  }

  /* ---- right column ---- */

  @container (min-width: 64rem) {
    .sticky {
      position: sticky;
      top: 1.5rem;
    }
  }

  .block {
    margin-top: var(--space-lg);
  }

  .block h3 {
    font-size: var(--text-sm);
    font-weight: 600;
    margin-bottom: var(--space-xs);
  }

  .block p {
    font-size: var(--text-sm);
  }

  /*
   * A run of releases read top to bottom. One hairline down the left, a tick
   * per release heated by how many reviews named it, the date it was first
   * reported and the count. No chips, no cards.
   */
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0 0 0 var(--space-sm);
    border-left: var(--rule-hair) solid var(--color-rule);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .timeline li {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: baseline;
    column-gap: var(--space-sm);
    padding-block: 3px;
  }

  .tick {
    position: absolute;
    left: calc(-1 * var(--space-sm) - 2px);
    top: 0.62em;
    width: 5px;
    height: 5px;
    border-radius: 1px;
  }

  .tick[data-heat='1'] { background: var(--heat-1); }
  .tick[data-heat='2'] { background: var(--heat-2); }
  .tick[data-heat='3'] { background: var(--heat-3); }
  .tick[data-heat='4'] { background: var(--heat-4); }

  .timeline .v {
    color: var(--color-ink);
  }

  .timeline .n {
    /* Right-aligned so the counts form a column to read down. */
    min-width: 1rem;
    text-align: right;
  }

  .listing {
    margin: 0;
    padding-left: var(--space-md);
    font-size: var(--text-sm);
    display: grid;
    gap: var(--space-2xs);
  }

  .muted-note,
  .dates {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
</style>
