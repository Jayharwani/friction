---
/**
 * Every v1 link, still resolving.
 *
 * This is not in astro.config's `redirects` for the reason the note there
 * gives: a dynamic redirect destination is validated against the route table
 * and emitted *without* `base`, so it points at jayharwani.github.io/challenges
 * rather than /friction/challenges — a 404 on a project page. Verified against
 * the built output. Written out here instead, through url(), which is the one
 * place base is applied.
 */
import { url } from '../../lib/url';
import { getProblems } from '../../lib/data';

export function getStaticPaths() {
  return getProblems().map((problem) => ({ params: { slug: problem.slug } }));
}

const { slug } = Astro.params;
const to = url(`/challenges/${slug}`);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Moved to Challenges</title>
    <meta http-equiv="refresh" content={`0;url=${to}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(to, 'https://jayharwani.github.io').href} />
  </head>
  <body>
    <p><a href={to}>This page is now a challenge. Continue.</a></p>
  </body>
</html>
