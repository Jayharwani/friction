---
/**
 * Problem detail — the most important screen in the project (spec 6.1).
 *
 * Two columns at 1024px and above, single column below. The left column is the
 * evidence stream in reverse chronological order; the right column is the
 * computed panel, sticky on wide viewports.
 */
import Layout from '../../layouts/Layout.astro';
import ScoreDisclosure from '../../components/ScoreDisclosure.astro';
import EvidenceItem from '../../components/EvidenceItem.astro';
import RelatedStrip from '../../components/RelatedStrip.astro';
import GapBlock from '../../components/GapBlock.astro';
import Sparkline from '../../components/charts/Sparkline.astro';
import StackedBar from '../../components/charts/StackedBar.astro';
import VersionTimeline from '../../components/charts/VersionTimeline.astro';
import { url } from '../../lib/url';
import { formatDate, getGaps, getProblems, getProduct, platformsLabel } from '../../lib/data';
import { platformSplit, signalCounts, versionMarks, weeklySeries } from '../../lib/charts';
import type { Problem } from '../../../scripts/validate';

export function getStaticPaths() {
  return getProblems().map((problem) => ({
    params: { slug: problem.slug },
    props: { problem },
  }));
}

interface Props {
  problem: Problem;
}

const { problem } = Astro.props;
const product = getProduct(problem.productSlug);

// Reverse chronological: the newest report of the problem reads first.
const evidence = [...problem.evidence].sort((a, b) => b.reviewedAt.localeCompare(a.reviewedAt));

const marks = versionMarks(problem);
const series = weeklySeries(problem.evidence);
const split = platformSplit(problem.evidence);
const signals = signalCounts(problem.evidence).filter((sig) => sig.count > 0);

/*
 * The written gap line, shown only where the evidence carries it: a problem
 * with a Strong signal verdict in a category that has one. Anywhere else the
 * sentence would be doing more work than the data underneath it supports.
 */
const gap = problem.verdict === 'Strong signal' ? getGaps()[problem.category] : undefined;

const description = `${problem.summary.slice(0, 150)} Scored ${problem.score} from ${problem.evidence.length} app store reviews.`;
---

<Layout title={problem.title} description={description}>
  <div class="shell">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href={url(`/products/${problem.productSlug}`)}>{product?.name ?? problem.productSlug}</a>
    </nav>

    <!--
      DOM order is header, computed panel, evidence stream. Grid areas put the
      panel on the right at wide widths. Ordering it after the stream would bury
      the score below every quote on mobile, and put the score disclosure after
      all the evidence links in the tab order.
    -->
    <div class="detail bleed">
      <div class="columns">
      <header class="intro">
        <h1 transition:name={`title-${problem.slug}`}>{problem.title}</h1>
        <p class="summary">{problem.summary}</p>
        <p class="meta">
          {problem.category}, {platformsLabel(problem.platforms)}, {problem.evidence.length}{' '}
          {problem.evidence.length === 1 ? 'review' : 'reviews'}
          {problem.status === 'stale' && <span class="stale">, no new evidence in 120 days</span>}
        </p>
      </header>

      <!-- ---------- right: the computed panel ---------- -->
      <aside class="panel-column">
        <div class="sticky">
          <ScoreDisclosure problem={problem} />

          <section class="block">
            <h3>Evidence over time</h3>
            <Sparkline
              series={series}
              scale={2}
              label={`${series.total} of these ${problem.evidence.length} reviews arrived in the last twelve weeks.`}
            />
            <p class="ch-caption">Reviews per week, last twelve weeks.</p>
          </section>

          <section class="block">
            <h3>App versions</h3>
            {
              marks.length > 0 ? (
                <VersionTimeline marks={marks} />
              ) : (
                <p class="muted-note">No version was reported with these reviews.</p>
              )
            }
          </section>

          <section class="block">
            <h3>Platform</h3>
            <StackedBar segments={split} of="of this problem's evidence" />
          </section>

          {
            signals.length > 0 && (
              <section class="block">
                <h3>Signals</h3>
                <ul class="signals num">
                  {signals.map((sig) => (
                    <li>
                      <span class="sig-mark" aria-hidden="true" />
                      <span class="sig-label">{sig.label}</span>
                      <span class="sig-count">{sig.count}</span>
                    </li>
                  ))}
                </ul>
                <p class="ch-caption">
                  How many of the {problem.evidence.length} reviews carried each signal.
                </p>
              </section>
            )
          }

          {
            /* Without a gap line these two stay in the rail. With one they
               move out to the full-width block below, where the third column
               can pay them off. */
            !gap && (
              <>
                <section class="block">
                  <h3>What people do instead</h3>
                  {problem.workarounds.length > 0 ? (
                    <ul class="listing">
                      {problem.workarounds.map((w) => (
                        <li>{w}</li>
                      ))}
                    </ul>
                  ) : (
                    <p class="muted-note">No workaround was described in these reviews.</p>
                  )}
                </section>

                <section class="block">
                  <h3>What already exists</h3>
                  {problem.existingSolutions.length > 0 ? (
                    <ul class="listing">
                      {problem.existingSolutions.map((s) => (
                        <li>{s}</li>
                      ))}
                    </ul>
                  ) : (
                    <p class="muted-note">No existing product was named in these reviews.</p>
                  )}
                </section>
              </>
            )
          }

          <section class="block">
            <h3>Seen</h3>
            <p class="num dates">
              First reported <time datetime={problem.firstSeen}>{formatDate(problem.firstSeen)}</time
              >, last reported <time datetime={problem.lastSeen}>{formatDate(problem.lastSeen)}</time
              >.
            </p>
          </section>
        </div>
      </aside>

      <!-- ---------- left: the evidence stream ---------- -->
      <div class="stream">
        {
          gap && (
            <section class="gap-section" aria-labelledby="gap-heading">
              <h2 id="gap-heading">Where the gap is</h2>
              <GapBlock
                workarounds={problem.workarounds}
                existing={problem.existingSolutions}
                gap={gap}
                subject="this problem"
              />
            </section>
          )
        }

        <h2 class="stream-heading">Evidence</h2>

        <p class="standing-note">
          Neither app store gives an individual review a permanent public link, so each entry below
          is a snapshot taken on the date shown, and the link goes to the app's review listing
          rather than to the review itself. The repository's git history is the audit trail.
        </p>

        {evidence.map((e) => <EvidenceItem evidence={e} />)}

        <RelatedStrip problem={problem} />
      </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .crumb {
    padding-block: var(--space-lg) 0;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .columns {
    display: grid;
    gap: var(--space-xl);
    padding-block: var(--space-lg) var(--space-xl);
  }

  /* A container query, not a viewport query: the split responds to the space
     this block actually has. Without container-query support the rules simply
     do not apply and the single-column layout stands, which is a fine result. */
  .detail {
    container-type: inline-size;
  }

  /* Two columns only where there is room for both to stay legible. Grid areas
     place the panel on the right while it stays second in the DOM. */
  @container (min-width: 64rem) {
    .columns {
      grid-template-columns: minmax(0, 1fr) 20rem;
      grid-template-areas:
        'head  panel'
        'stream panel';
      grid-template-rows: auto 1fr;
      column-gap: var(--space-3xl);
      row-gap: 0;
      align-items: start;
    }

    .intro {
      grid-area: head;
    }

    .stream {
      grid-area: stream;
    }

    /* Stretched rather than content-height, otherwise the sticky child has no
       room to travel and never actually sticks. */
    .panel-column {
      grid-area: panel;
      align-self: stretch;
      height: 100%;
    }
  }

  .stream {
    min-width: 0;
  }

  .intro {
    max-width: var(--measure);
  }

  h1 {
    /* Problem titles get the serif, like the quotes they summarise. */
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 500;
    letter-spacing: -0.014em;
    line-height: 1.18;
  }

  .summary {
    margin-top: var(--space-md);
    max-width: var(--measure);
  }

  .meta {
    margin-top: var(--space-sm);
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }

  .stale {
    color: var(--color-muted);
  }

  /* The gap sits above the evidence, not beside it: it is the conclusion the
     stream below supports, and a rail would make it look like a statistic. */
  .gap-section {
    margin-bottom: var(--space-2xl);
    padding-bottom: var(--space-xl);
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }

  .gap-section h2 {
    font-size: var(--text-lg);
    font-weight: 600;
    margin-bottom: var(--space-md);
  }

  .stream-heading {
    margin-top: var(--space-xl);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  /* A hairline aside, not a tinted panel: the site carries no cards. */
  .standing-note {
    margin-top: var(--space-sm);
    max-width: var(--measure);
    font-size: var(--text-sm);
    color: var(--color-muted);
    border-left: 2px solid var(--color-rule);
    padding-left: var(--space-md);
  }

  .stream :global(.evidence) {
    max-width: var(--measure);
  }

  /* ---- right column ---- */

  @container (min-width: 64rem) {
    .sticky {
      position: sticky;
      /* Below the fixed header, never under it. */
      top: calc(var(--nav-h) + var(--space-md));
    }
  }

  .block {
    margin-top: var(--space-lg);
  }

  .block h3 {
    font-size: var(--text-sm);
    font-weight: 600;
    margin-bottom: var(--space-xs);
  }

  .block p {
    font-size: var(--text-sm);
  }

  /*
   * Five possible signals, only the ones actually present. A mark, the phrase
   * as the extractor recorded it, and a count — one line each, in place of the
   * five sentences this used to be.
   */
  .signals {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .signals li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-xs);
    padding-block: var(--space-3xs);
  }

  .signals li + li {
    border-top: var(--rule-hair) solid var(--color-rule);
  }

  .sig-mark {
    width: 4px;
    height: 4px;
    border-radius: 1px;
    background: var(--color-accent);
    translate: 0 -2px;
  }

  .sig-count {
    color: var(--color-ink);
    min-width: 1.2em;
    text-align: right;
  }

  .listing {
    margin: 0;
    padding-left: var(--space-md);
    font-size: var(--text-sm);
    display: grid;
    gap: var(--space-2xs);
  }

  .muted-note,
  .dates {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
</style>
