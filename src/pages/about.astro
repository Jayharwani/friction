---
/**
 * About: what this is, and why store reviews are a better evidence base than
 * forum posts for this particular question.
 *
 * The argument used to be a forty-word paragraph. It is now two columns of
 * fields, because the asymmetry between what a forum post carries and what a
 * store review carries IS the argument, and it reads in a second.
 *
 * Neither column quotes anything. They list the fields each source carries —
 * inventing a specimen review or forum post to illustrate a point would be
 * fabricated content on a site whose whole claim is that it does not do that.
 */
import Layout from '../layouts/Layout.astro';
import { url } from '../lib/url';
import RecordCard from '../components/charts/RecordCard.astro';
import { formatDate, getProblems, getProducts } from '../lib/data';

const products = getProducts();

/*
 * One real review of each kind. The comparison is the fields each source
 * supplies, never a specimen of either — a fabricated forum post on a site
 * whose claim is that it fabricates nothing would be the worst possible joke.
 */
const everyEvidence = getProblems().flatMap((p) => p.evidence);
const apple = everyEvidence.find((e) => e.platform === 'ios' && e.version && e.title);
const COUNTRY: Record<string, string> = {
  us: 'United States', gb: 'United Kingdom', ca: 'Canada',
  au: 'Australia', nz: 'New Zealand', ie: 'Ireland', sg: 'Singapore',
};
---

<Layout
  title="About"
  description="What Friction is, and why app store reviews are a better evidence base than forum posts for finding recurring product problems."
>
  <div class="shell prose">
    <h1>About</h1>

    <p>
      A free, public index of recurring complaints in {products.length} widely used apps.
    </p>

    <section class="compare" aria-labelledby="compare-heading">
      <h2 id="compare-heading">Why store reviews</h2>
      <p class="lede">
        A forum thread tells you someone was annoyed. A store review tells you who, when, on what,
        and how badly.
      </p>

      <div class="cols hero-box">
        <RecordCard
          source="A forum post"
          fields={[
            { name: 'date', value: 'supplied' },
            { name: 'author', value: 'supplied' },
            { name: 'star rating', value: null },
            { name: 'app version', value: null },
            { name: 'country', value: null },
            { name: 'platform', value: null },
          ]}
          note="Enough to know it happened. Not enough to know whether it is spreading, or which release caused it."
        />

        <RecordCard
          source="A store review"
          strong
          fields={[
            { name: 'date', value: apple ? formatDate(apple.reviewedAt) : 'supplied' },
            { name: 'author', value: 'hashed on read' },
            { name: 'star rating', value: apple ? `${apple.rating} of 5` : '1 of 5' },
            { name: 'app version', value: apple?.version ?? '1.7.338' },
            { name: 'country', value: apple ? (COUNTRY[apple.country] ?? apple.country.toUpperCase()) : 'United States' },
            { name: 'platform', value: 'iOS or Android' },
          ]}
          note="Enough to ask whether a complaint started after a specific release, whether it affects one platform or both, and whether it is getting worse or fading."
        />
      </div>

      <p class="cost">
        Reviews have no permanent public link. The{' '}
        <a href={url('/how-it-works')}>method</a> is honest about that.
      </p>
    </section>

    <section class="isnot" aria-labelledby="isnot-heading">
      <h2 id="isnot-heading">What this is, and is not</h2>
      <div class="cols">
        <div class="col">
          <p class="col-name">It is</p>
          <ul class="plain">
            <li>free and public</li>
            <li>non-commercial</li>
            <li>auditable, line by line</li>
            <li>computed in code, never by a model</li>
          </ul>
        </div>
        <div class="col">
          <p class="col-name">It is not</p>
          <ul class="plain struck">
            <li>affiliated with any app it tracks</li>
            <li>a ranking of apps</li>
            <li>a conclusion</li>
            <li>a substitute for your own research</li>
          </ul>
        </div>
      </div>
    </section>

    <p class="sig">
      Built by <a href="https://github.com/Jayharwani" rel="noopener noreferrer">Jay Harwani</a>.
      The <a href="https://github.com/Jayharwani/friction" rel="noopener noreferrer">source and
      every version of the data</a> are public.
    </p>
  </div>
</Layout>

<style>

  h2 {
    font-size: var(--text-lg);
  }

  .compare,
  .isnot {
    margin-top: var(--space-2xl);
    max-width: none;
  }

  .lede {
    max-width: var(--measure);
  }

  /* The page's one hero container: what a store review carries that a
     forum post does not, which is the whole argument for the site. */
  .hero-box {
    padding: var(--space-lg);
    border-radius: var(--shape-xxl);
    background: var(--m-surface-container-high);
  }

  .cols {
    display: grid;
    gap: var(--space-lg);
    margin-top: var(--space-lg);
    max-width: 52rem;
  }

  @media (min-width: 40rem) {
    .cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-2xl);
    }
  }

  .col-name {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .col-note {
    margin-top: var(--space-sm);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    list-style: none;
    margin: var(--space-sm) 0 0;
    padding: 0;
    font-size: var(--text-xs);
  }

  .chips li {
    padding: var(--space-3xs) var(--space-xs);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--r-pill);
    color: var(--color-muted);
  }

  /* The side with more to say is drawn at full strength. */
  .chips.strong li {
    color: var(--color-ink);
    border-color: color-mix(in oklch, var(--color-accent) 45%, transparent);
  }

  .plain {
    list-style: none;
    margin: var(--space-sm) 0 0;
    padding: 0;
    font-size: var(--text-sm);
  }

  .plain li {
    padding-block: var(--space-2xs);
    border-top: var(--rule-hair) solid var(--color-rule);
  }

  .plain.struck li {
    color: var(--color-muted);
    text-decoration: line-through;
    text-decoration-color: color-mix(in oklch, var(--color-muted) 55%, transparent);
  }

  .cost {
    max-width: var(--measure);
  }

  .prose {
    padding-block: var(--space-xl) 0;
  }

  .prose > * {
    max-width: var(--measure);
  }

  h1 {
    font-size: var(--text-2xl);
    letter-spacing: -0.02em;
  }

  p {
    margin-top: var(--space-md);
  }

  .sig {
    margin-top: var(--space-xl);
    padding-top: var(--space-md);
    border-top: var(--rule-hair) solid var(--color-rule);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
</style>
