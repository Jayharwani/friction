---
/**
 * Archive (spec 6.1): every run from runs.json with funnel numbers, newest first.
 */
import Layout from '../layouts/Layout.astro';
import CoverageGrid from '../components/charts/CoverageGrid.astro';
import RunCard from '../components/table/RunCard.astro';
import { url } from '../lib/url';
import { formatDate, getProduct, getRuns } from '../lib/data';
import { CANDIDATE_CAP } from '../../scripts/validate';

const runs = getRuns();


// Newest first for reading; the timeline runs oldest to newest.
const byDate = [...runs].sort((a, b) => a.date.localeCompare(b.date));

/*
 * Cumulative problems tracked, one step per scan. With a single scan this is
 * one point, and it says so rather than drawing a line through nothing.
 */
const cumulative = byDate.map((run) => ({
  date: run.date,
  total: run.problemsTotal ?? 0,
  added: run.problemsNew ?? 0,
}));
const peak = Math.max(1, ...cumulative.map((c) => c.total));

/*
 * The axis runs twelve weeks from the first scan whatever has happened yet, so
 * a single point sits at the left of a mostly empty axis. That emptiness is
 * the honest picture and it is the only thing on the page that says, without
 * saying it, that this chart is waiting for more scans.
 */
const AXIS_WEEKS = 12;
const axisStart = byDate[0] ? Date.parse(byDate[0].date) : Date.now();
const axisEnd = axisStart + AXIS_WEEKS * 7 * 86_400_000;
const atX = (iso: string) =>
  Math.min(100, Math.max(0, ((Date.parse(iso) - axisStart) / (axisEnd - axisStart)) * 100));
---

<Layout title="Archive" description="Every Friction scan, with the funnel numbers for each run.">
  <div class="shell">
    <header class="intro">
      <h1>Archive</h1>
      <p class="measure">Every scan, and what it found.</p>
    </header>

    {
      runs.length === 0 ? (
        <p class="empty measure">
          No scans have completed yet. Once one does it will be listed here, and the{' '}
          <a href={url('/how-it-works')}>methodology</a> explains what each number means.
        </p>
      ) : (
        <section class="timeline-block" aria-labelledby="runs-heading">
          <h2 id="runs-heading">Every scan</h2>

          {
            runs.length === 1 ? (
              <p class="sparse">
                One weekly check so far, on{' '}
                <time datetime={runs[0]!.date}>{formatDate(runs[0]!.date)}</time>.
              </p>
            ) : (
              <p class="sparse num">
                {runs.length} scans, from {formatDate(byDate[0]!.date)} to{' '}
                {formatDate(byDate.at(-1)!.date)}.
              </p>
            )
          }

          <ol class="runs">
            {
              [...runs].map((run, i) => {
                const prev = runs[i + 1];
                return (
                  <li>
                    <RunCard
                      date={run.date}
                      stages={[
                        { label: 'Read', value: run.funnel.fetched.total },
                        { label: 'Screened', value: run.funnel.screened.total },
                        { label: 'Complaints', value: run.funnel.filtered.total },
                        { label: 'Carried', value: run.funnel.capped.total },
                      ]}
                      problems={run.problemsTotal ?? 0}
                      fresh={run.problemsNew ?? 0}
                      coverage={{
                        ok: run.products.filter((x) => x.playOk).length,
                        of: run.products.length,
                      }}
                      delta={
                        prev
                          ? {
                              problems: (run.problemsTotal ?? 0) - (prev.problemsTotal ?? 0),
                              fetched: run.funnel.fetched.total - prev.funnel.fetched.total,
                            }
                          : undefined
                      }
                      connected={i < runs.length - 1}
                    />
                    <CoverageGrid run={run} names={(slug) => getProduct(slug)?.name ?? slug} />
                  </li>
                );
              })
            }
          </ol>
        </section>

        <section class="cumulative" aria-labelledby="cumulative-heading">
          <h2 id="cumulative-heading">Problems tracked over time</h2>
          <div class="plot" data-chart>
            <div class="grid-lines" aria-hidden="true">
              {
                Array.from({ length: AXIS_WEEKS / 2 }, (_, i) => (
                  <span style={`left:${((i + 1) / (AXIS_WEEKS / 2)) * 100}%`} />
                ))
              }
            </div>

            {
              cumulative.map((c, i) => (
                <>
                  <span
                    class="point ch-pop"
                    style={`--ch-i:${i}; left:${atX(c.date)}%; --v:${(c.total / peak) * 100}`}
                  />
                  {/* A sibling, not a child: the label sits above the dot, on the
                      page, and nesting it inside an accent-filled span would put
                      it on a background it is not actually drawn against. */}
                  <span
                    class="p-value num ch-fade"
                    style={`--ch-i:${i}; left:${atX(c.date)}%; --v:${(c.total / peak) * 100}`}
                  >
                    {c.total}
                  </span>
                </>
              ))
            }

            <p class="axis num" aria-hidden="true">
              <span>{formatDate(byDate[0]!.date)}</span>
              <span class="ahead">{AXIS_WEEKS} weeks</span>
            </p>
          </div>

          {/*
            Wrapped, not marked sr-only directly: a <table> treats width as a
            minimum and grows past the 1px box, which put 300px of invisible
            table into the page's scroll width.
          */}
          <div class="sr-only">
            <table>
              <caption>Problems tracked after each scan</caption>
              <thead>
                <tr><th scope="col">Scan</th><th scope="col">Problems tracked</th></tr>
              </thead>
              <tbody>
                {cumulative.map((c) => (
                  <tr><th scope="row">{formatDate(c.date)}</th><td>{c.total}</td></tr>
                ))}
              </tbody>
            </table>
          </div>

          {
            cumulative.length === 1 && (
              <p class="ch-caption">
                One point, because there has been one scan.
              </p>
            )
          }
        </section>


      )
    }

    {
      runs.length > 0 && (
        <p class="note measure">
          "Read" counts every review pulled from both stores, including ones already processed in an
          earlier scan. "Carried" is capped at {CANDIDATE_CAP} per run by design — see the{' '}
          <a href={url('/how-it-works')}>methodology</a>.
        </p>
      )
    }
  </div>
</Layout>

<style>

  /* ---- the run timeline ---- */

  .timeline-block,
  .cumulative {
    margin-top: var(--space-2xl);
    padding-bottom: var(--space-md);
    max-width: none;
  }

  h2 {
    font-size: var(--text-lg);
  }

  .sparse {
    margin-top: var(--space-xs);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .runs {
    list-style: none;
    margin: var(--space-lg) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-xl);
  }

  .runs li {
    padding-top: var(--space-md);
    border-top: var(--rule-hair) solid var(--color-rule);
  }

  /* The funnel says how much survived; the grid says where it came from. */
  .run-body {
    display: grid;
    gap: var(--space-xl);
    align-items: start;
  }

  @media (min-width: 46rem) {
    .run-body {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-2xl);
    }
  }

  .run-date {
    display: flex;
    justify-content: space-between;
    gap: var(--space-sm);
    font-size: var(--text-sm);
    font-weight: 600;
    margin-bottom: var(--space-sm);
  }

  .run-added {
    font-weight: 400;
    color: var(--color-muted);
    font-size: var(--text-xs);
  }

  /* ---- cumulative steps ---- */

  /* A plot with room in it: the point sits at the left of an axis sized for
     the weeks ahead, so the empty space is the message. */
  .plot {
    position: relative;
    height: 7rem;
    /* Room above for the highest point's label, and below for the axis. */
    margin: var(--space-xl) 0 var(--space-2xl);
    max-width: 34rem;
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }

  .grid-lines span {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--rule-hair);
    background: var(--color-rule);
    opacity: 0.5;
  }

  /* Plotted into the lower 84% of the box, so the tallest point's label has
     somewhere to sit without running into the heading above. */
  .point {
    position: absolute;
    bottom: calc(var(--v, 0) * 0.84%);
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-accent);
    translate: -50% 50%;
  }

  .p-value {
    position: absolute;
    bottom: calc(var(--v, 0) * 0.84% + 12px);
    translate: -50% 0;
    font-size: var(--text-xs);
    font-weight: 600;
    white-space: nowrap;
    /* The point is accent-filled; its label sits on the page, not on the dot. */
    color: var(--color-ink);
  }

  .axis {
    position: absolute;
    inset: auto 0 -1.6rem;
    margin: 0;
    display: flex;
    justify-content: space-between;
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .ahead {
    /* --color-neutral is under 4.5:1 at this size. */
    color: var(--color-muted);
  }

  .intro {
    padding-block: var(--space-xl) 0;
  }

  h1 {
    font-size: var(--text-2xl);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-sm);
  }

  /*
   * The scroller exists only where the table cannot fit. Above 64rem it is
   * turned off: an overflow container becomes the scrollport for anything
   * sticky inside it, which pinned the header 68px down its own 80px box and
   * hid the first row behind it.
   */
  .scroller {
    overflow-x: auto;
    margin-top: var(--space-xl);
  }

  @media (min-width: 64rem) {
    .scroller {
      overflow-x: visible;
    }
  }

  @media (max-width: 63.999rem) {
    thead th {
      position: static;
    }
  }

  table {
    border-collapse: collapse;
    width: 100%;
    min-width: 40rem;
    font-size: var(--text-sm);
    text-align: left;
  }

  th,
  td {
    padding: var(--space-xs) var(--space-md) var(--space-xs) 0;
    border-top: var(--rule-hair) solid var(--color-rule);
    font-weight: 400;
    white-space: nowrap;
  }

  thead th {
    border-top: 0;
    border-bottom: var(--rule-hair) solid var(--color-ink);
    font-weight: 600;
  }

  tbody th {
    font-weight: 500;
  }

  .n {
    text-align: right;
    padding-right: var(--space-lg);
  }

  .note,
  .empty {
    margin-top: var(--space-lg);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  /* ---- table craft (spec 4.4) ---- */

  /*
   * The header stays put while a long table scrolls. It needs its own
   * background or the rows would read straight through it.
   */
  thead th {
    position: sticky;
    top: var(--nav-h);
    z-index: var(--z-raise);
    background: var(--color-paper);
  }

  /* Whole-row hover, mixed off the page colour so it works in both themes. */
  tbody tr:hover {
    background: color-mix(in oklch, var(--color-ink) 5%, transparent);
  }

  tbody tr:has(a:focus-visible) {
    background: color-mix(in oklch, var(--color-accent) 10%, transparent);
  }
</style>
