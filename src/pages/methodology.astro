---
/**
 * Methodology (spec 6.1). Plain English, not marketing copy.
 *
 * Every number here is read from the live data or from the scoring module
 * itself, so the page cannot drift out of step with what the site actually did.
 */
import Layout from '../layouts/Layout.astro';
import { url } from '../lib/url';
import {
  formatDate,
  getActiveProblems,
  getBuildThreshold,
  getLatestRun,
  getPassRate,
  getProblems,
  getProducts,
} from '../lib/data';
import {
  COMPONENT_LABELS,
  COMPONENT_ORDER,
  EVIDENCE_WINDOW_DAYS,
  MIN_BUILD_THRESHOLD,
  STALE_AFTER_DAYS,
  THRESHOLD_PERCENTILE,
  WEIGHTS,
} from '../lib/scoring';
import {
  APP_DENYLIST,
  CANDIDATE_CAP,
  CRISIS_PATTERNS,
  MAX_AGE_DAYS,
  MIN_TEXT_LENGTH,
} from '../../scripts/validate';

/*
 * The margin contents. Declared here rather than scraped from the DOM so the
 * ids live next to each other and a renamed heading is a visible edit.
 */
const sections = [
  ['where-the-data-comes-from', 'Where the data comes from'],
  ['how-reviews-become-problems', 'How reviews become problems'],
  ['how-the-score-is-computed', 'How the score is computed'],
  ['the-verdict-and-why-most-problems-fail', 'The verdict'],
  ['what-this-method-cannot-tell-you', 'What this cannot tell you'],
  ['privacy', 'Privacy'],
  ['what-is-never-tracked', 'What is never tracked'],
  ['non-commercial', 'Non-commercial'],
];

const problems = getProblems();
const active = getActiveProblems();
const threshold = getBuildThreshold();
const passRate = getPassRate();
const run = getLatestRun();
const products = getProducts();

const worthBuilding = active.filter((p) => p.verdict === 'Strong signal').length;
const playGaps = run?.products.filter((p) => !p.playOk) ?? [];

// Storefront list is read from the tracked apps so it cannot drift.
const STOREFRONT_NAMES: Record<string, string> = {
  us: 'the United States', gb: 'the United Kingdom', ca: 'Canada',
  au: 'Australia', nz: 'New Zealand', ie: 'Ireland', sg: 'Singapore',
};
const storefronts = [...new Set(products.flatMap((p) => p.countries))];
const storefrontList = storefronts.map((c) => STOREFRONT_NAMES[c] ?? c.toUpperCase());
const storefrontSentence =
  storefrontList.length > 1
    ? `${storefrontList.slice(0, -1).join(', ')} and ${storefrontList.at(-1)}`
    : (storefrontList[0] ?? '');

const componentMeaning: Record<string, string> = {
  distinctUsers: 'How many different people reported it, counted by a salted hash of the reviewer name.',
  recurrence: 'How many separate weeks it appeared in, rather than all at once.',
  recency: 'How long ago it was last reported.',
  severity: 'The mean star rating of the reviews reporting it.',
  churnIntent: 'How many reviewers said they were leaving, deleting or cancelling.',
  versionPersistence: 'How many distinct app versions it survived.',
  crossPlatform: 'Whether it was reported on both iOS and Android.',
};
---

<Layout
  title="Methodology"
  description="Where Friction's data comes from, exactly how each score is computed, and what this method cannot tell you."
>
  <div class="shell prose">
    {/* Margin contents. Shown above 1100px, where there is room beside the measure. */}
    <nav class="toc" aria-label="On this page">
      <p class="toc-title">On this page</p>
      <ol>
        {sections.map(([id, label]) => (
          <li><a href={`#${id}`} data-toc={id}>{label}</a></li>
        ))}
      </ol>
    </nav>

    <h1>Methodology</h1>

    <p class="lede">
      This page exists so you can check the work. Every number on this site is computed in
      TypeScript from fields extracted out of public app store reviews. The code is
      <a href="https://github.com/Jayharwani/friction" rel="noopener noreferrer">on GitHub</a>, and
      so is every version of the data.
    </p>

    <h2 id="where-the-data-comes-from">Where the data comes from</h2>

    <p>
      Two sources, both public, neither requiring credentials or an agreement.
    </p>

    <h3>Apple App Store</h3>
    <p>
      Apple publishes a customer reviews feed for each app in each storefront. Friction reads up to
      ten pages per app per storefront, at one request per second, from {storefrontSentence}. Each
      review carries a star rating, an app version, a country and a date. This is the backbone of
      the project.
    </p>

    <h3>Google Play</h3>
    <p>
      Google publishes no API for reading reviews of apps you do not own. Friction reads publicly
      visible review pages using the <code>google-play-scraper</code> package, at one request per
      second, taking the most recent English reviews from the United States storefront. Play
      reviews carry no title, and often no app version.
    </p>
    <p>
      Play is an enhancement, not a dependency. If it fails for an app, the run continues with
      Apple data alone and the gap is recorded.
      {
        playGaps.length === 0
          ? ' In the most recent scan every tracked app returned Play data.'
          : ` In the most recent scan ${playGaps.length} of ${products.length} apps returned no Play data: ${playGaps.map((p) => p.slug).join(', ')}.`
      }
    </p>

    <h2 id="how-reviews-become-problems">How reviews become problems</h2>

    <p>
      Most of the filtering is deterministic and happens before any model sees anything. A review is
      rejected outright if it has already been processed, if it is older than {MAX_AGE_DAYS} days, if
      the title and body together run under {MIN_TEXT_LENGTH} characters, or if it matches the
      crisis language screen below.
      What survives is kept only when it is rated three stars or lower and contains at least one of
      a fixed list of complaint markers. The survivors are ranked by marker count, then star rating,
      then recency, and capped at {CANDIDATE_CAP} per run.
    </p>

    {
      run && (
        <p class="num">
          The scan on <time datetime={run.date}>{formatDate(run.date)}</time> read{' '}
          {run.funnel.fetched.total.toLocaleString('en-GB')} reviews, of which{' '}
          {run.funnel.screened.total.toLocaleString('en-GB')} passed screening,{' '}
          {run.funnel.filtered.total.toLocaleString('en-GB')} read like complaints, and{' '}
          {run.funnel.capped.total} were carried forward. Every run is listed in the{' '}
          <a href={url('/archive')}>archive</a>.
        </p>
      )
    }

    <p>
      Those go to a language model with one job: group reviews that describe the same
      underlying problem, and copy a short verbatim quote from each. The model is explicitly
      forbidden from producing a score, a rank or a priority of any kind. Its output is then parsed
      against a strict schema and every quote is checked, character by character, against the review
      it claims to come from. If any check fails the run stops and nothing is published, leaving the
      previous week's data in place.
    </p>

    <h2 id="how-the-score-is-computed">How the score is computed</h2>

    <p>
      Seven components, each normalised to a value between 0 and 1 over evidence from the last{' '}
      {EVIDENCE_WINDOW_DAYS} days, multiplied by the weights below, and scaled to 0–100.
    </p>

    {/*
      The same arithmetic the prose describes, set as an equation. The weights
      are read from scoring.ts, so this cannot drift out of step with the code.
    */}
    <figure class="equation" aria-label="The scoring formula">
      <pre><code>score = 100 × (
{
  COMPONENT_ORDER.map((key, i) => (
    <>{'  '}{i === 0 ? ' ' : '+'} {WEIGHTS[key].toFixed(2)} × {key}{'\n'}</>
  ))
})</code></pre>
    </figure>

    <table class="weights">
      <thead>
        <tr>
          <th scope="col">Component</th>
          <th scope="col" class="w">Weight</th>
          <th scope="col">What it measures</th>
        </tr>
      </thead>
      <tbody>
        {
          COMPONENT_ORDER.map((key) => (
            <tr>
              <th scope="row">{COMPONENT_LABELS[key]}</th>
              <td class="w num">{Math.round(WEIGHTS[key] * 100)}%</td>
              <td>{componentMeaning[key]}</td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <p>
      Open "How this score is calculated" on any problem page to see these seven values for that
      problem, with the raw counts behind each one and the arithmetic that produces the total.
    </p>

    <h2 id="the-verdict-and-why-most-problems-fail">The verdict, and why most problems fail</h2>

    <p>
      The verdict is decided in a fixed order. Fewer than four distinct reviewers is
      <strong>Thin evidence</strong>, whatever the score. Three or more existing products that already
      solve it is <strong>Already solved</strong>. Otherwise a score at or above the build threshold
      is <strong>Strong signal</strong>, and anything else is <strong>Recurring</strong>.
    </p>

    <p class="num">
      The threshold is the higher of {MIN_BUILD_THRESHOLD} and the {THRESHOLD_PERCENTILE}th
      percentile of all active problem scores, computed by linear interpolation between the closest
      ranks. It currently stands at <strong>{threshold.toFixed(1)}</strong>.
      {
        active.length > 0 && (
          <>
            {' '}Of {active.length} active {active.length === 1 ? 'problem' : 'problems'},{' '}
            {worthBuilding} {worthBuilding === 1 ? 'carries' : 'carry'} the "Strong signal"
            verdict, a pass rate of {passRate.toFixed(0)}%.
          </>
        )
      }
    </p>

    <p>
      That low pass rate is deliberate. A site where everything looks promising is worth nothing to
      anyone deciding what to work on, so the bar moves with the field and never drops below{' '}
      {MIN_BUILD_THRESHOLD}. A problem with no new evidence for {STALE_AFTER_DAYS} days is marked
      stale; it stays readable but is left out of the homepage and out of the threshold calculation.
    </p>

    {/* A full-width band, one step lighter: the limits are not a footnote. */}
    <section class="full limits">
      <div class="limits-inner">
      <h2 id="what-this-method-cannot-tell-you">What this method cannot tell you</h2>

      <h3>Reviews have no permanent link</h3>
      <p>
        Neither store gives an individual review a stable public URL. This is the single biggest
        limitation of the whole project and it cannot be engineered away. Evidence therefore links to
        the app's review listing, not to the review itself, and every quote is labelled with the date
        the scan captured it. You cannot click through and re-read the original. What you can do is
        read the commit history in the repository, where every scan's output is recorded with a
        timestamp.
      </p>

      <h3>Coverage is narrow</h3>
      <p>
        English-language reviews, {storefronts.length} Apple storefronts, one Play storefront, mobile apps only, and
        only the {products.length} apps currently tracked. A quiet app produces a small sample, and a
        small sample produces an unreliable score. Treat a scored problem as a starting point for your
        own research, not as a conclusion.
      </p>
      </div>
    </section>

    <h2 id="privacy">Privacy</h2>

    <ul>
      <li>
        <strong>No reviewer name is ever stored.</strong> Names are hashed with a secret salt the
        moment they are read, truncated to sixteen characters, and discarded. The hash exists only
        to count distinct people and is never displayed.
      </li>
      <li>
        <strong>Quotes are capped at 25 words</strong> and must be verbatim. A quote that is not a
        character-for-character substring of the review it cites fails validation and stops the run.
      </li>
      <li>
        <strong>Raw review text is deleted after 30 days.</strong> Full review bodies exist only in
        the intermediate files for a single scan; the published records keep the capped quote and
        nothing more.
      </li>
    </ul>

    <h2 id="what-is-never-tracked">What is never tracked</h2>

    <p>
      Apps whose subject matter is personal distress or health are never tracked. The check runs
      before any request is made, against the app name, the developer name and the store category,
      and the tracked list is not exempt from it. An app matching any of these terms is excluded:
    </p>

    <p class="terms">{APP_DENYLIST.join(', ')}</p>

    <p>
      Separately, any individual review whose text matches crisis language is dropped before it
      enters the pipeline. Such a review is never stored, never quoted and never counted towards any
      score. The terms are:
    </p>

    <p class="terms">{CRISIS_PATTERNS.join(', ')}</p>

    <p>
      Both screens match inflected forms as well as the exact words. They are deliberately broad.
      Excluding something that belonged is a cost worth paying here.
    </p>

    <h2 id="non-commercial">Non-commercial</h2>

    <p>
      Friction has no ads, no payments, no signup, no paywall and no affiliate links, and it is not
      affiliated with any of the apps it tracks. It reads publicly visible reviews and publishes the
      analysis with the method attached. If you think something here is wrong, the data and the code
      are both <a href="https://github.com/Jayharwani/friction" rel="noopener noreferrer">in the
      repository</a> and you can check it yourself.
    </p>

    {
      problems.length === 0 && (
        <p class="empty-note">
          No problems have been recorded yet, so the threshold and pass rate above are computed from
          an empty set.
        </p>
      )
    }
  </div>
</Layout>

<script>
  /**
   * Marks the section being read in the margin contents. An
   * IntersectionObserver, never a scroll listener, and it only sets an
   * attribute — nothing here animates.
   */
  function watchSections(): void {
    const links = new Map<string, HTMLAnchorElement>();
    for (const a of document.querySelectorAll<HTMLAnchorElement>('[data-toc]')) {
      links.set(a.dataset.toc!, a);
    }
    if (links.size === 0) return;

    const seen = new Set<string>();
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) seen.add(e.target.id);
          else seen.delete(e.target.id);
        }
        // The topmost visible heading wins, so the mark never jumps backwards.
        let current: string | null = null;
        for (const id of links.keys()) {
          if (seen.has(id)) { current = id; break; }
        }
        for (const [id, a] of links) {
          if (id === current) a.setAttribute('aria-current', 'true');
          else a.removeAttribute('aria-current');
        }
      },
      { rootMargin: '-20% 0px -70% 0px' },
    );

    for (const id of links.keys()) {
      const el = document.getElementById(id);
      if (el) io.observe(el);
    }
    document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
  }

  document.addEventListener('astro:page-load', watchSections);
</script>

<style>

  /* ---- margin contents ---- */

  .toc {
    display: none;
  }

  /*
   * Fixed rather than sticky: the shell is a single grid column list, so a
   * sticky item would only span its own row. Anchored off the measure, which
   * keeps it the same distance from the text at every width.
   */
  @media (min-width: 1100px) {
    .toc {
      display: block;
      position: fixed;
      top: calc(var(--nav-h) + var(--space-xl));
      right: calc(50% + var(--measure) / 2 + var(--space-xl));
      width: 11rem;
      max-height: calc(100vh - var(--nav-h) - var(--space-2xl));
      overflow-y: auto;
    }
  }

  /*
   * The small type lives on the children, not on .toc. `ch` resolves against
   * the element's own font, so setting --text-xs on the container made
   * `var(--measure)` compute narrower there than in the shell and the
   * contents overlapped the text it was meant to sit beside.
   */
  .toc-title,
  .toc ol {
    font-size: var(--text-xs);
  }

  .toc-title {
    /* --color-neutral is 4.27:1 at this size; muted clears 4.5. */
    color: var(--color-muted);
    margin-bottom: var(--space-xs);
  }

  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2xs);
  }

  .toc a {
    color: var(--color-muted);
    text-decoration: none;
    display: block;
    padding: var(--space-3xs) 0 var(--space-3xs) var(--space-sm);
    border-left: var(--rule-hair) solid var(--color-rule);
    text-wrap: pretty;
  }

  .toc a:hover,
  .toc a[aria-current='true'] {
    color: var(--color-ink);
    border-left-color: var(--color-accent);
  }

  /* ---- the scoring formula ---- */

  .equation {
    margin: var(--space-lg) 0;
    background: var(--color-paper-2);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: 6px;
    padding: var(--space-md) var(--space-lg);
    overflow-x: auto;
  }

  .equation pre {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.7;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  /* ---- the limits band ---- */

  .limits {
    background: var(--color-paper-2);
    border-block: var(--rule-hair) solid var(--color-rule);
    padding-block: var(--space-2xl);
    margin-block: var(--space-2xl);
  }

  .limits-inner {
    width: min(var(--measure), 100% - (var(--page-gutter) * 2));
    margin-inline: auto;
  }

  .limits-inner > :first-child {
    margin-top: 0;
  }

  .prose {
    padding-block: var(--space-xl) 0;
  }

  .prose > * {
    max-width: var(--measure);
  }

  h1 {
    font-size: var(--text-2xl);
    letter-spacing: -0.02em;
  }

  h2 {
    font-size: var(--text-lg);
    margin-top: var(--space-xl);
  }

  h3 {
    font-size: var(--text-md);
    font-weight: 600;
    margin-top: var(--space-lg);
  }

  p {
    margin-top: var(--space-md);
  }

  .lede {
    margin-top: var(--space-md);
    font-size: var(--text-lg);
    line-height: 1.5;
  }

  ul {
    margin-top: var(--space-md);
    padding-left: var(--space-md);
    display: grid;
    gap: var(--space-xs);
  }

  code {
    font-size: 0.92em;
    background: var(--color-paper-2);
    padding: 0.05em 0.3em;
  }

  /* The denylist is data, set apart from the prose that explains it. */
  .terms {
    background: var(--color-paper-2);
    padding: var(--space-sm) var(--space-md);
    font-size: var(--text-sm);
    color: var(--color-muted);
    line-height: 1.6;
  }

  .weights {
    margin-top: var(--space-md);
    border-collapse: collapse;
    width: 100%;
    font-size: var(--text-sm);
    text-align: left;
  }

  .weights th,
  .weights td {
    border-top: var(--rule-hair) solid var(--color-rule);
    padding: var(--space-xs) var(--space-sm) var(--space-xs) 0;
    vertical-align: top;
    font-weight: 400;
  }

  .weights thead th {
    border-top: 0;
    border-bottom: var(--rule-hair) solid var(--color-ink);
    font-weight: 600;
    padding-bottom: var(--space-xs);
  }

  .weights tbody th {
    font-weight: 500;
    white-space: nowrap;
  }

  .weights .w {
    text-align: right;
    padding-right: var(--space-md);
    white-space: nowrap;
  }

  .empty-note {
    margin-top: var(--space-xl);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
</style>
