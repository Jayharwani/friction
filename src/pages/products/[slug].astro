---
/**
 * Product page (spec 6.1): every problem for one app, grouped by category and
 * sorted by score, with a twelve-week evidence trend split by platform.
 */
import Layout from '../../layouts/Layout.astro';
import ProblemRow from '../../components/ProblemRow.astro';
import {
  getProductsWithProblems,
  getProblemsForProduct,
  productTrend,
  weekLabel,
} from '../../lib/data';
import type { Problem, Product } from '../../../scripts/validate';

export function getStaticPaths() {
  // Only products that actually have a problem recorded get a page; an empty
  // product page would be a dead end.
  return getProductsWithProblems().map((product) => ({
    params: { slug: product.slug },
    props: { product, problems: getProblemsForProduct(product.slug) },
  }));
}

interface Props {
  product: Product;
  problems: Problem[];
}

const { product, problems } = Astro.props;

// Grouped by category, each group sorted by score.
const categories = [...new Set(problems.map((p) => p.category))].sort();
const grouped = categories.map((category) => ({
  category,
  items: problems.filter((p) => p.category === category).sort((a, b) => b.score - a.score),
}));

const trend = productTrend(problems);
const totalEvidence = problems.reduce((n, p) => n + p.evidence.length, 0);
const platforms = [...new Set(problems.flatMap((p) => p.platforms))];
---

<Layout
  title={product.name}
  description={`Recurring problems reported in ${product.name} app store reviews, scored from public evidence.`}
>
  <div class="shell">
    <header class="intro">
      <h1>{product.name}</h1>
      <p class="meta num">
        {product.category}, {problems.length} {problems.length === 1 ? 'problem' : 'problems'},{' '}
        {totalEvidence} {totalEvidence === 1 ? 'review' : 'reviews'} recorded
      </p>
    </header>

    <section class="trend-block">
      <h2>Evidence over the last twelve weeks</h2>

      <div class="trend" role="img" aria-label={`Weekly evidence volume for ${product.name} over the last twelve weeks, split by platform.`}>
        {
          trend.weeks.map((week, i) => {
            const ios = trend.ios[i] ?? 0;
            const android = trend.android[i] ?? 0;
            const total = ios + android;
            return (
              <div
                class="col"
                title={`Week of ${weekLabel(week)}: ${total} ${total === 1 ? 'review' : 'reviews'} (${ios} iOS, ${android} Android)`}
              >
                <div class="stack">
                  <div class="bar ios" style={`height:${(ios / trend.max) * 100}%`} />
                  <div class="bar android" style={`height:${(android / trend.max) * 100}%`} />
                </div>
                <span class="tick num">{i % 3 === 0 ? weekLabel(week) : ''}</span>
              </div>
            );
          })
        }
      </div>

      {/* Platforms are told apart by tone and by a written legend, never by hue alone. */}
      <p class="legend">
        <span class="swatch ios" aria-hidden="true"></span> iOS
        <span class="swatch android" aria-hidden="true"></span> Android
      </p>
    </section>

    {
      grouped.map((group) => (
        <section class="group">
          <h2>{group.category}</h2>
          {group.items.map((problem) => (
            <ProblemRow problem={problem} />
          ))}
        </section>
      ))
    }

    <p class="disclaimer measure">
      This page reflects publicly visible {platforms.length === 2 ? 'App Store and Google Play' : platforms[0] === 'android' ? 'Google Play' : 'App Store'} reviews
      only. Friction is not affiliated with {product.name} or its makers, and nothing here is a
      statement from them.
    </p>
  </div>
</Layout>

<style>
  .intro {
    padding-block: var(--space-6) 0;
    max-width: var(--measure);
  }

  h1 {
    font-size: var(--text-2xl);
    letter-spacing: -0.02em;
  }

  .meta {
    margin-top: var(--space-2);
    color: var(--muted);
    font-size: var(--text-sm);
  }

  h2 {
    font-size: var(--text-sm);
    font-weight: 600;
    margin-bottom: var(--space-3);
  }

  .trend-block {
    margin-top: var(--space-6);
  }

  .trend {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 5.5rem;
    max-width: 34rem;
  }

  .col {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: 100%;
    min-width: 0;
  }

  .stack {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-start;
    height: 100%;
    /* A hairline floor so an empty week still reads as a week. */
    box-shadow: inset 0 -1px 0 0 var(--rule);
  }

  .bar.ios {
    background: var(--text);
  }

  .bar.android {
    background: color-mix(in oklch, var(--text) 40%, var(--bg));
  }

  .tick {
    margin-top: var(--space-1);
    font-size: var(--text-xs);
    color: var(--muted);
    white-space: nowrap;
    line-height: 1;
  }

  .legend {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-5);
    font-size: var(--text-xs);
    color: var(--muted);
  }

  .legend .swatch {
    width: 0.7rem;
    height: 0.7rem;
    display: inline-block;
  }

  .legend .swatch.android {
    margin-left: var(--space-3);
  }

  .swatch.ios {
    background: var(--text);
  }

  .swatch.android {
    background: color-mix(in oklch, var(--text) 40%, var(--bg));
  }

  .group {
    margin-top: var(--space-7);
    max-width: var(--measure);
  }

  .disclaimer {
    margin-top: var(--space-7);
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule);
    font-size: var(--text-sm);
    color: var(--muted);
  }
</style>
