---
/**
 * One app's challenges, grouped by category and ordered by how widely each
 * was reported.
 *
 * The twelve-week evidence chart and the platform split that used to sit at
 * the top of this page are on /how-it-works now, on one worked example. A
 * page a visitor lands on says what was found; the page for a sceptic says
 * how it was counted.
 */
import Layout from '../../layouts/Layout.astro';
import ProblemRow from '../../components/ProblemRow.astro';
import { url } from '../../lib/url';
import {
  getProductsWithProblems,
  getProblemsForProduct,
  platformsLabel,
} from '../../lib/data';
import type { Problem, Product } from '../../../scripts/validate';

export function getStaticPaths() {
  // Only products that actually have a problem recorded get a page; an empty
  // product page would be a dead end.
  return getProductsWithProblems().map((product) => ({
    params: { slug: product.slug },
    props: { product, problems: getProblemsForProduct(product.slug) },
  }));
}

interface Props {
  product: Product;
  problems: Problem[];
}

const { product, problems } = Astro.props;

const totalEvidence = problems.reduce((n, p) => n + p.evidence.length, 0);
const platforms = [...new Set(problems.flatMap((p) => p.platforms))];

/* Categories in the order they are most present, then by reach inside each. */
const categories = [...new Set(problems.map((p) => p.category))].sort(
  (a, b) =>
    problems.filter((p) => p.category === b).length -
    problems.filter((p) => p.category === a).length,
);
const ordered = categories.flatMap((label) =>
  problems.filter((p) => p.category === label).sort((a, b) => b.score - a.score),
);
---

<Layout
  title={product.name}
  description={`Recurring challenges reported in ${product.name} app store reviews, drawn from what reviewers wrote.`}
>
  <div class="shell">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href={url('/apps')}>All apps</a>
    </nav>

    <header class="intro">
      <div class="ident">
        <img
          src={url(`/icons/${product.slug}.jpg`)}
          alt=""
          width="72"
          height="72"
          class="icon"
          transition:name={`icon-${product.slug}`}
        />
        <div>
          <h1>{product.name}</h1>
          <p class="meta num">{product.category}</p>
        </div>
      </div>

      <p class="found num">
        {problems.length} {problems.length === 1 ? 'challenge' : 'challenges'}, from{' '}
        {totalEvidence} reviews on {platformsLabel(platforms)}.
      </p>

    </header>

    <section class="problems">
      <h2>What has been found</h2>
      {ordered.map((problem) => <ProblemRow problem={problem} />)}
    </section>

    <p class="disclaimer measure">
      This page reflects publicly visible {platforms.length === 2 ? 'App Store and Google Play' : platforms[0] === 'android' ? 'Google Play' : 'App Store'} reviews
      only. Friction is not affiliated with {product.name} or its makers, and nothing here is a
      statement from them.
    </p>
  </div>
</Layout>

<style>
  .crumb {
    padding-block: var(--space-lg) 0;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .intro {
    padding-block: var(--space-md) 0;
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--space-lg) var(--space-2xl);
  }

  h1 {
    font-size: var(--text-2xl);
    letter-spacing: -0.02em;
  }

  .meta {
    margin-top: var(--space-xs);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  h2 {
    font-size: var(--text-sm);
    font-weight: 600;
    margin-bottom: var(--space-sm);
  }

  .problems {
    margin-top: var(--space-2xl);
  }

  .problems h2 {
    font-size: var(--text-lg);
  }

  /* ---- band 1: identity ---- */

  .ident {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .icon {
    width: 4.5rem;
    height: 4.5rem;
    border-radius: var(--r-card);
    flex: none;
    background: var(--color-paper-2);
  }

  .found {
    margin: 0;
    color: var(--color-muted);
  }

  .disclaimer {
    margin-top: var(--space-2xl);
    padding-top: var(--space-md);
    border-top: var(--rule-hair) solid var(--color-rule);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
</style>
