---
/**
 * Today — Map / Diagram.
 *
 * The Friction Field organises the page spatially: twelve weeks across, the
 * tracked problems back, height for how often each one was reported. The
 * statement sits over its lower third, the proof row states the figures, and
 * the specimen shows one problem in full before the list.
 *
 * The old 2D recurrence grid is gone; the field replaces it.
 */
import Layout from '../layouts/Layout.astro';
import FrictionField from '../components/FrictionField.astro';
import ProblemRow from '../components/ProblemRow.astro';
import Specimen from '../components/Specimen.astro';
import { url } from '../lib/url';
import {
  formatDate,
  getActiveProblems,
  getLatestRun,
  getProblems,
  getProblemsFromRun,
  getProduct,
  groupByProduct,
} from '../lib/data';
import { VERDICT_GLOSS } from '../lib/scoring';
import type { Verdict } from '../../scripts/validate';

const all = getProblems();
const active = getActiveProblems();
const run = getLatestRun();

// Every figure below is read from the data. Nothing here is invented.
const reviewsRead = run?.funnel.fetched.total ?? 0;
const problemsTracked = all.length;

const specimen = active[0]; // getProblems() is sorted by score, descending
const specimenProduct = specimen ? getProduct(specimen.productSlug) : undefined;

const grouped = groupByProduct(run ? getProblemsFromRun(run.date) : []);

// A gloss appears once per verdict, on its first appearance.
const seenVerdicts = new Set<Verdict>();
if (specimen) seenVerdicts.add(specimen.verdict);
---

<Layout title="Friction">
  <FrictionField />

  <div class="shell">
    {/* 04 · Stat-led, directly beneath the diagram. */}
    <section class="proof" data-enter="3" aria-label="Current figures">
      <div class="fig">
        <p class="stat-figure">{reviewsRead.toLocaleString('en-GB')}</p>
        <p class="stat-label">reviews read</p>
      </div>
      <div class="fig">
        <p class="stat-figure">{problemsTracked}</p>
        <p class="stat-label">problems tracked</p>
      </div>
      <div class="fig">
        <p class="stat-figure">
          {run ? <time datetime={run.date}>{formatDate(run.date)}</time> : '—'}
        </p>
        <p class="stat-label">last scan</p>
      </div>
    </section>

    {
      specimen && specimenProduct && (
        <Specimen problem={specimen} productName={specimenProduct.name} />
      )
    }

    {
      all.length === 0 && (
        <section class="empty">
          <p>
            No problems have been recorded yet. The first scan has not produced data, or the
            pipeline stopped before writing. Nothing here is a placeholder.
          </p>
          <p><a href={url('/methodology')}>How this works</a></p>
        </section>
      )
    }

    {
      grouped.length > 0 && (
        <section class="list">
          <h2>Everything found in the last scan</h2>

          {grouped.map((group) => (
            <div class="group">
              <h3 class="app-name">
                <a href={url(`/products/${group.product.slug}`)}>{group.product.name}</a>
              </h3>
              {group.problems.map((problem) => {
                const first = !seenVerdicts.has(problem.verdict);
                seenVerdicts.add(problem.verdict);
                return (
                  <>
                    <ProblemRow problem={problem} />
                    {first && (
                      <p class="gloss">
                        {problem.verdict} — {VERDICT_GLOSS[problem.verdict]}
                      </p>
                    )}
                  </>
                );
              })}
            </div>
          ))}
        </section>
      )
    }
  </div>
</Layout>

<style>
  .proof {
    display: flex;
    flex-wrap: wrap;
    padding-block: var(--space-lg);
    border-block: var(--rule-hair) solid var(--color-rule);
  }

  /* Separated by hairlines, never by middle dots. */
  .fig + .fig {
    margin-left: var(--space-lg);
    padding-left: var(--space-lg);
    border-left: var(--rule-hair) solid var(--color-rule);
  }

  .stat-figure {
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.024em;
  }

  .stat-label {
    margin-top: var(--space-2xs);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  /*
   * Wrapped flex items keep their left rule, which left the last figure
   * indented under a stray hairline. Below 30rem the row is a grid instead:
   * two figures up, the date across the full width under a top rule.
   */
  @media (max-width: 34rem) {
    .proof {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-lg);
      row-gap: var(--space-md);
    }

    /*
     * Sibling chains rather than :nth-child. Astro scopes every compound, so
     * `.fig + .fig` carries more specificity than `.fig:nth-child(2)` and a
     * reset-then-restore pattern silently loses.
     */
    .fig + .fig {
      margin-left: 0;
    }

    .fig + .fig + .fig {
      grid-column: 1 / -1;
      padding: var(--space-md) 0 0;
      border-left: none;
      border-top: var(--rule-hair) solid var(--color-rule);
    }
  }

  .list {
    margin-top: var(--section-gap);
  }

  h2 {
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .group {
    margin-top: var(--space-xl);
  }

  .app-name {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-muted);
    margin-bottom: var(--space-xs);
  }

  .app-name a {
    text-decoration: none;
  }

  .gloss {
    padding: var(--space-xs) 0 var(--space-sm);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .empty {
    margin-top: var(--space-2xl);
    display: grid;
    gap: var(--space-sm);
  }

  /* The proof row joins the field's entry sequence as its third beat. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (transition-behavior: allow-discrete) {
      [data-enter] {
        opacity: 1;
        translate: 0 0;
        transition:
          opacity var(--dur-long) var(--ease-out),
          translate var(--dur-long) var(--ease-out);
        transition-delay: 120ms;
      }

      @starting-style {
        [data-enter] {
          opacity: 0;
          translate: 0 8px;
        }
      }
    }
  }

</style>
