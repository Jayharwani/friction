---
/**
 * Home.
 *
 *   1  the promise, and the way in
 *   2  three challenges
 *
 * Cut back to this in v4 step 2. The wall of voices is gone, and so are the
 * whole-challenge section and the lens explainer that followed it: 774 words
 * of page for a reader who only needed to know what the site is and where to
 * start. Step 7 rebuilds it around a hero card and three short panels.
 *
 * Prose budget: 110 words, counted by `npm run words`.
 */
import Layout from '../layouts/Layout.astro';
import ChallengeCard from '../components/ui/ChallengeCard.astro';
import { url } from '../lib/url';
import { getProblems } from '../lib/data';

const all = getProblems();

/** Apps sharing a category — what a challenge card needs for its lenses. */
const appsIn = (category: string) =>
  new Set(all.filter((p) => p.category === category).map((p) => p.productSlug)).size;

const featured = [...all].sort((a, b) => b.score - a.score).slice(0, 3);
---

<Layout title="Friction">
  {/* ---------- 1. the promise ---------- */}
  <section class="hero">
    <div class="shell">
      <div class="bleed">
        <div class="say">
          <h1>Find what to build from what people complain about.</h1>
          <p class="sub">
            Every week it reads app store reviews and turns the repeated complaints into things
            you could make.
          </p>
          <a class="go" href={url('/challenges')}>See the {all.length} challenges</a>
        </div>
      </div>
    </div>

  </section>

  {/* ---------- 2. three of them ---------- */}
  <section class="shell section" aria-labelledby="more-heading">
    <header class="head bleed">
      <h2 id="more-heading">Three of them</h2>
      <a class="more" href={url('/challenges')}>All {all.length} challenges</a>
    </header>

    <div class="cards bleed">
      {
        featured.map((problem) => (
          <ChallengeCard problem={problem} appsInCategory={appsIn(problem.category)} />
        ))
      }
    </div>
  </section>
</Layout>

<style>
  /* ---- 1. the promise ---- */

  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: center;
    min-height: min(82svh, 44rem);
    overflow: hidden;
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }

  .hero > .shell {
    position: relative;
    z-index: var(--z-raise);
  }

  /*
   * Left, not centred. The wall runs the full width behind it and the scrim
   * is a one-sided wash, so the headline sits on calm paper while the far
   * half of the wall stays readable as a wall.
   */
  .say {
    padding-block: var(--space-3xl);
    max-width: 30rem;
  }

  @media (max-width: 52rem) {
    .say {
      max-width: 34rem;
    }

    /* Shorter: the phone arc is smaller, and 82svh left a screen of nothing
       under the button. */
    .hero {
      min-height: min(70svh, 34rem);
    }
  }

  h1 {
    font-size: clamp(2rem, 1.1rem + 3.4vw, 3.4rem);
    font-weight: 300;
    line-height: 1.02;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .sub {
    margin-top: var(--space-md);
    font-size: var(--text-md);
    color: var(--color-muted);
    text-wrap: pretty;
  }

  .go {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    margin-top: var(--space-lg);
    padding: var(--space-2xs) var(--space-lg);
    border-radius: var(--r-pill);
    background: var(--color-accent);
    color: var(--color-paper);
    font-weight: 500;
    text-decoration: none;
  }

  .go:hover {
    background: color-mix(in oklab, var(--color-accent) 86%, var(--color-ink));
  }

  .go:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }

  /* ---- 2. three of them ---- */

  .section {
    padding-block: var(--space-2xl) var(--space-4xl);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm) var(--space-lg);
    margin-bottom: var(--space-lg);
  }

  .head h2 {
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .more {
    font-size: var(--text-sm);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: var(--space-md);
  }
</style>
