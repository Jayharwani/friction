---
/**
 * Home — four screens, hard stop.
 *
 * Pitch, how it works, patterns, latest. The field is not here: a spatial
 * overview belongs after the reader knows what a problem is, not before.
 *
 * Prose budget: 120 words. Counted, not estimated — every sentence outside
 * problem titles, quotes and data labels.
 */
import Layout from '../layouts/Layout.astro';
import HeroCard from '../components/HeroCard.astro';
import Explainer from '../components/Explainer.astro';
import PatternCard from '../components/PatternCard.astro';
import ProblemCard from '../components/ProblemCard.astro';
import AppIcon from '../components/AppIcon.astro';
import { url } from '../lib/url';
import {
  formatDate,
  getActiveProblems,
  getGaps,
  getLatestRun,
  getProblems,
  getProduct,
  getProducts,
} from '../lib/data';
import { buildPatterns } from '../lib/patterns';

const all = getProblems();
const active = getActiveProblems();
const run = getLatestRun();
const products = getProducts();

const reviewsRead = run?.funnel.fetched.total ?? 0;
const specimen = active[0];
const specimenProduct = specimen ? getProduct(specimen.productSlug) : undefined;

const patterns = buildPatterns(active, products.length, getGaps()).slice(0, 4);
const latest = all.slice(0, 6);

/* Excerpts for the explainer's scatter — real review text, trimmed. */
const specimenQuotes = (specimen?.evidence ?? []).map((e) => ({
  text: e.quote,
  rating: e.rating,
  member: true,
}));
const otherQuotes = all
  .filter((p) => p.slug !== specimen?.slug)
  .flatMap((p) => p.evidence)
  .filter((e) => e.rating <= 2)
  .map((e) => ({ text: e.quote, rating: e.rating, member: false }));

const excerpts: { text: string; rating: number; member: boolean }[] = [];
for (let i = 0; i < 26; i++) {
  const fromMembers = i % 4 === 1 && specimenQuotes.length > 0;
  const pool = fromMembers ? specimenQuotes : otherQuotes;
  const pick = pool[Math.floor(i / (fromMembers ? 4 : 1.35)) % pool.length];
  if (pick) excerpts.push(pick);
}
---

<Layout title="Friction">
  {/* ---------- 1. Pitch ---------- */}
  <section class="hero">
    <div class="shell"><div class="hero-grid bleed">
      <div class="hero-copy">
        <h1 data-enter="1">See what's broken in the apps everyone uses.</h1>
        <p class="how" data-enter="2">
          Friction reads public App Store and Google Play reviews every week, groups the complaints
          that keep repeating, and scores each by how much evidence there is.
        </p>

        <dl class="proof num" data-enter="3">
          <div>
            <dt>Reviews read</dt>
            <dd>{reviewsRead.toLocaleString('en-GB')}</dd>
          </div>
          <div>
            <dt>Problems tracked</dt>
            <dd>{all.length}</dd>
          </div>
          <div>
            <dt>Last checked</dt>
            <dd>{run ? formatDate(run.date) : '—'}</dd>
          </div>
        </dl>
      </div>

      <div class="hero-visual" data-enter="2">
        {specimen && <HeroCard problems={active.slice(0, 3)} />}
      </div>
      </div>
    </div>

    <ul class="wall" aria-label={`Tracking ${products.length} apps`}>
      {
        products.map((p) => (
          <li>
            <AppIcon slug={p.slug} name={p.name} size={48} />
          </li>
        ))
      }
    </ul>
  </section>

  {/* ---------- 2. How it works ---------- */}
  <section class="band">
    <div class="shell">
      {
        specimen && specimenProduct && (
          <Explainer
            problem={specimen}
            productName={specimenProduct.name}
            reviewsRead={reviewsRead}
            excerpts={excerpts}
          />
        )
      }
    </div>
  </section>

  {/* ---------- 3. Patterns ---------- */}
  {
    patterns.length > 0 && (
      <section class="shell section">
        <header class="head bleed">
          <h2>The same complaints show up across different apps.</h2>
          <a class="more" href={url('/patterns')}>All patterns</a>
        </header>

        <div class="bento bleed">
          {patterns.map((pattern) => (
            <PatternCard pattern={pattern} trackedApps={products.length} compact />
          ))}
        </div>
      </section>
    )
  }

  {/* ---------- 4. Latest ---------- */}
  <section class="shell section">
    <header class="head bleed">
      <h2>Found this week</h2>
      <a class="more" href={url('/problems')}>All {all.length} problems</a>
    </header>

    <div class="cards bleed">
      {latest.map((problem) => <ProblemCard problem={problem} />)}
    </div>
  </section>
</Layout>

<style>
  /* ---- 1. hero ---- */

  .hero {
    padding-block: var(--space-3xl) var(--space-2xl);
  }

  .hero-grid {
    display: grid;
    gap: var(--space-2xl);
    align-items: center;
  }

  @media (min-width: 60rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 26rem);
      gap: var(--space-3xl);
    }
  }

  h1 {
    font-size: clamp(2rem, 1rem + 2.8vw, 3.2rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.034em;
    max-width: 14em;
    text-wrap: balance;
  }

  .how {
    margin-top: var(--space-md);
    font-size: var(--text-md);
    line-height: 1.5;
    max-width: 40em;
    text-wrap: pretty;
  }

  .proof {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xl);
    margin-top: var(--space-xl);
  }

  .proof dt {
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .proof dd {
    margin: var(--space-3xs) 0 0;
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: 1;
  }

  /* The credibility row: every app we watch, as its own icon. */
  /*
   * The apps, at a size where they are recognised rather than inventoried.
   * They overlap slightly, like the pattern cards' rows, so the wall reads
   * as one set and not fifteen separate logos.
   */
  .wall {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    list-style: none;
    margin: var(--space-3xl) auto 0;
    padding: 0 var(--page-gutter);
    max-width: 48rem;
  }

  .wall li {
    margin-left: -0.18em;
    font-size: 48px;
    line-height: 0;
    border-radius: 24%;
    box-shadow: 0 0 0 3px var(--color-paper);
  }

  .wall li:first-child {
    margin-left: 0;
  }

  /* ---- 2. band ---- */

  .band {
    padding-block: var(--space-2xl) var(--space-3xl);
    background: var(--color-paper-2);
    border-block: var(--rule-hair) solid var(--color-rule);
  }

  /* ---- 3 and 4 ---- */

  .section {
    padding-block: var(--space-3xl) 0;
  }

  .section:last-of-type {
    padding-bottom: var(--space-3xl);
  }

  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-lg);
    flex-wrap: wrap;
    margin-bottom: var(--space-xl);
  }

  h2 {
    font-size: clamp(1.4rem, 1rem + 1.4vw, 2rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.024em;
    max-width: 20em;
    text-wrap: balance;
  }

  .more {
    font-size: var(--text-sm);
    white-space: nowrap;
  }

  .bento,
  .cards {
    display: grid;
    gap: var(--space-md);
  }

  @media (min-width: 46rem) {
    .bento,
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 70rem) {
    .cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* ---- entry ---- */

  @media (prefers-reduced-motion: no-preference) {
    @supports (transition-behavior: allow-discrete) {
      [data-enter] {
        opacity: 1;
        translate: 0 0;
        transition:
          opacity var(--dur-long) var(--ease-out),
          translate var(--dur-long) var(--ease-out);
      }

      [data-enter='2'] {
        transition-delay: 60ms;
      }

      [data-enter='3'] {
        transition-delay: 120ms;
      }

      @starting-style {
        [data-enter] {
          opacity: 0;
          translate: 0 8px;
        }
      }
    }
  }
</style>
