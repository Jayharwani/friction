---
/**
 * Today — Map / Diagram.
 *
 * The Friction Field organises the page spatially: twelve weeks across, the
 * tracked problems back, height for how often each one was reported. The
 * statement sits over its lower third, the proof row states the figures, and
 * the specimen shows one problem in full before the list.
 *
 * The old 2D recurrence grid is gone; the field replaces it.
 */
import Layout from '../layouts/Layout.astro';
import FrictionField from '../components/FrictionField.astro';
import ProblemRow from '../components/ProblemRow.astro';
import Specimen from '../components/Specimen.astro';
import Explainer from '../components/Explainer.astro';
import { url } from '../lib/url';
import {
  formatDate,
  getActiveProblems,
  getLatestRun,
  getProblems,
  getProblemsFromRun,
  getProduct,
  groupByProduct,
} from '../lib/data';
import { VERDICT_GLOSS } from '../lib/scoring';
import type { Verdict } from '../../scripts/validate';

const all = getProblems();
const active = getActiveProblems();
const run = getLatestRun();

// Every figure below is read from the data. Nothing here is invented.
const reviewsRead = run?.funnel.fetched.total ?? 0;
const problemsTracked = all.length;

const specimen = active[0]; // getProblems() is sorted by score, descending
const specimenProduct = specimen ? getProduct(specimen.productSlug) : undefined;

const grouped = groupByProduct(run ? getProblemsFromRun(run.date) : []);

/*
 * Excerpts for the explainer's scatter. Real review text, trimmed to a few
 * words: the cards are deliberately too small to read, so this is texture
 * made of the actual thing rather than lorem.
 *
 * `member` marks the ones belonging to the problem panel three resolves into,
 * so the grouping the animation shows is the grouping the pipeline made.
 */
const specimenQuotes = (specimen?.evidence ?? []).map((e) => ({
  text: e.quote,
  rating: e.rating,
  member: true,
}));
const otherQuotes = all
  .filter((p) => p.slug !== specimen?.slug)
  .flatMap((p) => p.evidence)
  .filter((e) => e.rating <= 2)
  .map((e) => ({ text: e.quote, rating: e.rating, member: false }));

// Interleaved, so the members are strewn through the scatter rather than
// sitting together before the grouping step has happened.
const excerpts: { text: string; rating: number; member: boolean }[] = [];
for (let i = 0; i < 26; i++) {
  const fromMembers = i % 4 === 1 && specimenQuotes.length > 0;
  const pool = fromMembers ? specimenQuotes : otherQuotes;
  const pick = pool[Math.floor(i / (fromMembers ? 4 : 1.35)) % pool.length];
  if (pick) excerpts.push(pick);
}

// A gloss appears once per verdict, on its first appearance.
const seenVerdicts = new Set<Verdict>();
if (specimen) seenVerdicts.add(specimen.verdict);
---

<Layout title="Friction">
  <div class="shell">
    <header class="hero bleed">
      <h1 data-enter="1">See what people complain about in the apps they use every day.</h1>
      <p class="how" data-enter="2">
        Friction reads public App Store and Google Play reviews every week, groups the complaints
        that keep repeating, and shows you the evidence behind each one.
      </p>
    </header>

    {
      specimen && specimenProduct && (
        <Explainer
          problem={specimen}
          productName={specimenProduct.name}
          reviewsRead={reviewsRead}
          excerpts={excerpts}
        />
      )
    }

    {/* 04 · Stat-led, directly beneath the diagram. */}
    <section class="proof" data-enter="3" aria-label="Current figures">
      <div class="fig">
        <p class="stat-figure">{reviewsRead.toLocaleString('en-GB')}</p>
        <p class="stat-label">reviews read</p>
      </div>
      <div class="fig">
        <p class="stat-figure">{problemsTracked}</p>
        <p class="stat-label">problems tracked</p>
      </div>
      <div class="fig">
        <p class="stat-figure">
          {run ? <time datetime={run.date}>{formatDate(run.date)}</time> : '—'}
        </p>
        <p class="stat-label">last scan</p>
      </div>
    </section>

    {
      specimen && specimenProduct && (
        <Specimen problem={specimen} productName={specimenProduct.name} />
      )
    }

    {
      all.length === 0 && (
        <section class="empty">
          <p>
            No problems have been recorded yet. The first scan has not produced data, or the
            pipeline stopped before writing. Nothing here is a placeholder.
          </p>
          <p><a href={url('/methodology')}>How this works</a></p>
        </section>
      )
    }

    {
      grouped.length > 0 && (
        <section class="list">
          <h2>Everything found in the last scan</h2>

          {grouped.map((group) => (
            <div class="group">
              <h3 class="app-name">
                <a href={url(`/products/${group.product.slug}`)}>{group.product.name}</a>
              </h3>
              {group.problems.map((problem) => {
                const first = !seenVerdicts.has(problem.verdict);
                seenVerdicts.add(problem.verdict);
                return (
                  <>
                    <ProblemRow problem={problem} />
                    {first && (
                      <p class="gloss">
                        {problem.verdict} — {VERDICT_GLOSS[problem.verdict]}
                      </p>
                    )}
                  </>
                );
              })}
            </div>
          ))}
        </section>
      )
    }
  </div>

  {/* The spatial overview, where an overview belongs: after the thing it
      summarises, not before the visitor knows what a problem is. */}
  <FrictionField />
</Layout>

<style>

  /* ---- hero ---- */

  .hero {
    padding-block: var(--space-3xl) 0;
  }

  .hero h1 {
    /* The measure sits on the heading, in em, so it tracks the clamped
       display size and holds two lines at every width. */
    max-width: 16em;
    font-size: clamp(1.9rem, 1rem + 2.6vw, 3.1rem);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.032em;
    text-wrap: balance;
  }

  /*
   * The sentence that actually explains the site. It used to be 10px of
   * muted grey; it is body size and full contrast now, because it is the
   * most useful sentence here.
   */
  .how {
    margin-top: var(--space-md);
    font-size: var(--text-md);
    line-height: 1.5;
    max-width: 46em;
    text-wrap: pretty;
  }

  .proof {
    display: flex;
    flex-wrap: wrap;
    padding-block: var(--space-lg);
    border-block: var(--rule-hair) solid var(--color-rule);
  }

  /* Separated by hairlines, never by middle dots. */
  .fig + .fig {
    margin-left: var(--space-lg);
    padding-left: var(--space-lg);
    border-left: var(--rule-hair) solid var(--color-rule);
  }

  .stat-figure {
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.024em;
  }

  .stat-label {
    margin-top: var(--space-2xs);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  /*
   * Wrapped flex items keep their left rule, which left the last figure
   * indented under a stray hairline. Below 30rem the row is a grid instead:
   * two figures up, the date across the full width under a top rule.
   */
  @media (max-width: 34rem) {
    .proof {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-lg);
      row-gap: var(--space-md);
    }

    /*
     * Sibling chains rather than :nth-child. Astro scopes every compound, so
     * `.fig + .fig` carries more specificity than `.fig:nth-child(2)` and a
     * reset-then-restore pattern silently loses.
     */
    .fig + .fig {
      margin-left: 0;
    }

    .fig + .fig + .fig {
      grid-column: 1 / -1;
      padding: var(--space-md) 0 0;
      border-left: none;
      border-top: var(--rule-hair) solid var(--color-rule);
    }
  }

  .list {
    margin-top: var(--section-gap);
  }

  h2 {
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .group {
    margin-top: var(--space-xl);
  }

  .app-name {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-muted);
    margin-bottom: var(--space-xs);
  }

  .app-name a {
    text-decoration: none;
  }

  /* A standalone target, not a link in a sentence: it takes the touch floor. */
  @media (pointer: coarse) {
    .app-name a {
      display: inline-flex;
      align-items: center;
      min-height: var(--tap);
    }
  }

  .gloss {
    padding: var(--space-xs) 0 var(--space-sm);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .empty {
    margin-top: var(--space-2xl);
    display: grid;
    gap: var(--space-sm);
  }

  /* The proof row joins the field's entry sequence as its third beat. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (transition-behavior: allow-discrete) {
      [data-enter] {
        opacity: 1;
        translate: 0 0;
        transition:
          opacity var(--dur-long) var(--ease-out),
          translate var(--dur-long) var(--ease-out);
        transition-delay: 120ms;
      }

      @starting-style {
        [data-enter] {
          opacity: 0;
          translate: 0 8px;
        }
      }
    }
  }

</style>
