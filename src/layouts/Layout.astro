---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { url } from '../lib/url';
import ThemeToggle from '../components/ThemeToggle.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'A free, auditable index of recurring complaints in widely used mobile apps, built from public app store reviews.',
} = Astro.props;

const documentTitle = title === 'Friction' ? 'Friction' : `${title} — Friction`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const nav = [
  { href: '/', label: 'Today' },
  { href: '/apps', label: 'Apps' },
  { href: '/methodology', label: 'Methodology' },
  { href: '/archive', label: 'Archive' },
  { href: '/about', label: 'About' },
];

const here = Astro.url.pathname.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    {/* Applied before first paint so a chosen theme never flashes the other one. */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('friction-theme');
          if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
        } catch (e) {
          /* storage blocked; the system preference applies */
        }
      })();
    </script>

    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Friction" />
    <meta name="twitter:card" content="summary" />

    <meta name="theme-color" content="#f9f7f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1714" media="(prefers-color-scheme: dark)" />

    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Friction" href={url('/rss.xml')} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* Newsreader is requested roman only — no italic axis is ever used. */}
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300..700&family=Geist+Mono:wght@400..500&family=Newsreader:opsz,wght@6..72,400..600&display=swap"
    />

    <ClientRouter />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="site-header" data-nav>
      <div class="header-inner">
          <a class="wordmark" href={url('/')}>Friction</a>

          <nav aria-label="Primary">
            <ul>
              {
                nav.map((item) => {
                  const target = url(item.href).replace(/\/$/, '');
                  const current = here === target;
                  return (
                    <li>
                      <a href={url(item.href)} aria-current={current ? 'page' : undefined}>
                        {item.label}
                      </a>
                    </li>
                  );
                })
              }
            </ul>
          </nav>

          <ThemeToggle />
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <SiteFooter />

    <script>
      // The nav backdrop engages past 64px. IntersectionObserver on a
      // zero-height sentinel rather than a scroll listener, so this costs
      // nothing on the main thread while scrolling.
      function watchScroll(): void {
        const header = document.querySelector('[data-nav]');
        if (!header) return;

        const sentinel = document.createElement('div');
        sentinel.style.cssText = 'position:absolute;top:64px;height:1px;width:1px;pointer-events:none';
        document.body.prepend(sentinel);

        new IntersectionObserver(
          ([entry]) => {
            if (entry?.isIntersecting) header.removeAttribute('data-scrolled');
            else header.setAttribute('data-scrolled', '');
          },
          { threshold: 0 },
        ).observe(sentinel);
      }

      document.addEventListener('astro:page-load', watchScroll);
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -9999px;
    top: 0;
    background: var(--color-paper);
    color: var(--color-ink);
    padding: var(--space-sm) var(--space-md);
    z-index: 10;
    border: 1px solid var(--color-ink);
  }

  .skip:focus {
    left: var(--space-xs);
    top: var(--space-xs);
  }

  /* N9 · edge-aligned. Wordmark hard left at the viewport edge, controls
     hard right, nothing in the middle. The empty span is the design.
     Fixed and transparent so the field runs underneath it. */
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 5;
    border-bottom: var(--rule-hair) solid transparent;
    transition:
      background-color var(--dur-short) var(--ease-out),
      border-color var(--dur-short) var(--ease-out),
      backdrop-filter var(--dur-short) var(--ease-out);
  }

  /* Engages past 64px of scroll — one of the six sanctioned moments. */
  .site-header[data-scrolled] {
    background: color-mix(in oklch, var(--color-paper) 72%, transparent);
    backdrop-filter: blur(14px) saturate(120%);
    border-bottom-color: var(--color-rule);
  }

  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm) var(--space-lg);
    padding: var(--space-md) var(--page-gutter);
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-lg);
    letter-spacing: -0.02em;
    text-decoration: none;
    margin-right: auto;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--text-sm);
  }

  nav a {
    color: var(--color-muted);
    text-decoration: none;
    padding-block: 2px;
  }

  nav a:hover {
    color: var(--color-ink);
  }

  /* Current page marked by weight and a rule, not by colour alone. */
  nav a[aria-current='page'] {
    color: var(--color-ink);
    font-weight: 600;
    box-shadow: inset 0 -1px 0 0 currentColor;
  }

  @media (max-width: 34rem) {
    .header-inner {
      gap: var(--space-xs) var(--space-sm);
      padding-block: var(--space-sm);
    }

    /* Wordmark and theme control share the first row; nav wraps under them. */
    nav {
      order: 3;
      width: 100%;
    }
  }
</style>
