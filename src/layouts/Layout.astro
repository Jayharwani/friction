---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { url } from '../lib/url';
import ThemeToggle from '../components/ThemeToggle.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'A free, auditable index of recurring complaints in widely used mobile apps, built from public app store reviews.',
} = Astro.props;

const documentTitle = title === 'Friction' ? 'Friction' : `${title} — Friction`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const nav = [
  { href: '/', label: 'Today' },
  { href: '/apps', label: 'Apps' },
  { href: '/methodology', label: 'Methodology' },
  { href: '/archive', label: 'Archive' },
  { href: '/about', label: 'About' },
];

const here = Astro.url.pathname.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    {/* Applied before first paint so a chosen theme never flashes the other one. */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('friction-theme');
          if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
        } catch (e) {
          /* storage blocked; the system preference applies */
        }
      })();
    </script>

    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Friction" />
    <meta name="twitter:card" content="summary" />

    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#181b20" media="(prefers-color-scheme: dark)" />

    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Friction" href={url('/rss.xml')} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=Newsreader:ital,opsz,wght@0,6..72,400..600;1,6..72,400..600&display=swap"
    />

    <ClientRouter />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="shell">
        <div class="header-inner">
          <a class="wordmark" href={url('/')}>Friction</a>

          <nav aria-label="Primary">
            <ul>
              {
                nav.map((item) => {
                  const target = url(item.href).replace(/\/$/, '');
                  const current = here === target;
                  return (
                    <li>
                      <a href={url(item.href)} aria-current={current ? 'page' : undefined}>
                        {item.label}
                      </a>
                    </li>
                  );
                })
              }
            </ul>
          </nav>

          <ThemeToggle />
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <SiteFooter />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -9999px;
    top: 0;
    background: var(--bg);
    color: var(--text);
    padding: var(--space-3) var(--space-4);
    z-index: 10;
    border: 1px solid var(--text);
  }

  .skip:focus {
    left: var(--space-2);
    top: var(--space-2);
  }

  .site-header {
    border-bottom: 1px solid var(--rule);
  }

  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    padding-block: var(--space-4);
  }

  .wordmark {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--text-lg);
    letter-spacing: -0.02em;
    text-decoration: none;
    margin-right: auto;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--text-sm);
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
    padding-block: 2px;
  }

  nav a:hover {
    color: var(--text);
  }

  /* Current page marked by weight and a rule, not by colour alone. */
  nav a[aria-current='page'] {
    color: var(--text);
    font-weight: 600;
    box-shadow: inset 0 -1px 0 0 currentColor;
  }

  @media (max-width: 34rem) {
    .wordmark {
      margin-right: 0;
      width: 100%;
    }
  }
</style>
