---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { url } from '../lib/url';
import ThemeToggle from '../components/ThemeToggle.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CommandPalette from '../components/CommandPalette.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'A free, auditable index of recurring complaints in widely used mobile apps, built from public app store reviews.',
} = Astro.props;

const documentTitle = title === 'Friction' ? 'Friction' : `${title} — Friction`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

/* About and Archive live in the footer now; the nav carries the product. */
const nav = [
  { href: '/problems', label: 'Problems' },
  { href: '/patterns', label: 'Patterns' },
  { href: '/apps', label: 'Apps' },
  { href: '/how-it-works', label: 'How it works' },
];

const here = Astro.url.pathname.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    {/* Applied before first paint so a chosen theme never flashes the other one. */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('friction-theme');
          if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
        } catch (e) {
          /* storage blocked; the system preference applies */
        }
      })();
    </script>

    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Friction" />
    <meta name="twitter:card" content="summary" />

    <!--
      The only colours in the project written as hex: a meta tag cannot take a
      var(). Both are --color-paper converted, light then dark, and verified
      against a sampled pixel of the rendered page.
    -->
    <meta name="theme-color" content="#faf4ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0806" media="(prefers-color-scheme: dark)" />

    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Friction" href={url('/rss.xml')} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* Newsreader is requested roman only — no italic axis is ever used. */}
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300..700&family=Geist+Mono:wght@400..500&family=Newsreader:opsz,wght@6..72,400..600&display=swap"
    />

    <ClientRouter />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="site-header" data-nav>
      <div class="header-inner">
          <a class="wordmark" href={url('/')}>Friction</a>

          <nav aria-label="Primary">
            <ul>
              {
                nav.map((item) => {
                  const target = url(item.href).replace(/\/$/, '');
                  const current = here === target;
                  return (
                    <li>
                      <a href={url(item.href)} aria-current={current ? 'page' : undefined}>
                        {item.label}
                      </a>
                    </li>
                  );
                })
              }
            </ul>
          </nav>

          <button class="find" type="button" data-palette-open>
            <span>Search</span>
            <kbd aria-hidden="true">⌘K</kbd>
          </button>

          <ThemeToggle />
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <SiteFooter />

    <CommandPalette />

    <script>
      import { watchCharts, stopWatchingCharts } from '../scripts/reveal';
      import { initPalette } from '../scripts/palette';

      let palette: { destroy(): void } | null = null;

      // The nav backdrop engages past 64px. IntersectionObserver on a
      // zero-height sentinel rather than a scroll listener, so this costs
      // nothing on the main thread while scrolling.
      function watchScroll(): void {
        const header = document.querySelector('[data-nav]');
        if (!header) return;

        const sentinel = document.createElement('div');
        sentinel.style.cssText = 'position:absolute;top:64px;height:1px;width:1px;pointer-events:none';
        document.body.prepend(sentinel);

        new IntersectionObserver(
          ([entry]) => {
            if (entry?.isIntersecting) header.removeAttribute('data-scrolled');
            else header.setAttribute('data-scrolled', '');
          },
          { threshold: 0 },
        ).observe(sentinel);
      }

      document.addEventListener('astro:page-load', () => {
        watchScroll();
        watchCharts();
        palette?.destroy();
        palette = initPalette();
      });
      document.addEventListener('astro:before-swap', () => {
        stopWatchingCharts();
        palette?.destroy();
        palette = null;
      });
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -9999px;
    top: 0;
    background: var(--color-paper);
    color: var(--color-ink);
    padding: var(--space-sm) var(--space-md);
    z-index: 10;
    border: 1px solid var(--color-ink);
  }

  .skip:focus {
    left: var(--space-xs);
    top: var(--space-xs);
  }

  /* N9 · edge-aligned. Wordmark hard left at the viewport edge, controls
     hard right, nothing in the middle. The empty span is the design.
     Fixed and transparent so the field runs underneath it. */
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 5;
    border-bottom: var(--rule-hair) solid transparent;
  }

  /* Under reduced motion the backdrop simply appears. */
  @media (prefers-reduced-motion: no-preference) {
    .site-header {
      transition:
        background-color var(--dur-short) var(--ease-out),
        border-color var(--dur-short) var(--ease-out);
    }
  }

  /* Engages past 64px of scroll — one of the six sanctioned moments. */
  /*
   * A surface, not a blur. backdrop-filter on a fixed full-width header makes
   * the compositor re-sample and blur the whole strip on every scroll frame —
   * measured at 101ms on the worst frames against 37ms without it. At 94%
   * opacity the difference is invisible and the scroll is not.
   */
  .site-header[data-scrolled] {
    background: color-mix(in oklch, var(--color-paper) 94%, transparent);
    border-bottom-color: var(--color-rule);
  }

  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm) var(--space-lg);
    padding: var(--space-md) var(--page-gutter);
  }

  /* A real button, so it is reachable without a keyboard shortcut. */
  .find {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    font: inherit;
    font-size: var(--text-xs);
    color: var(--color-muted);
    background: none;
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: 999px;
    /* Matches the theme control beside it: same padding, same line-height. */
    padding: var(--space-2xs) var(--space-xs);
    line-height: 1.4;
    /* One explicit height shared with the theme control beside it. The two
       are bordered differently — one per button, one on the wrapper — so
       matching their padding was never going to match their boxes. */
    height: 1.875rem;
    cursor: pointer;
  }

  .find:hover {
    color: var(--color-ink);
  }

  .find:active {
    background: color-mix(in oklch, var(--color-ink) 10%, transparent);
  }

  .find:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .find kbd {
    font-family: var(--font-mono);
    /* --color-neutral measures 4.27:1 at this size; muted clears 4.5. */
    color: var(--color-muted);
  }

  @media (max-width: 34rem) {
    .find span {
      /* The shortcut hint alone on a phone, where there is no ⌘K anyway. */
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }

    .find kbd {
      display: none;
    }

    .find::after {
      content: 'Find';
      color: var(--color-muted);
    }
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-lg);
    letter-spacing: -0.02em;
    text-decoration: none;
    margin-right: auto;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--text-sm);
  }

  nav a {
    color: var(--color-muted);
    text-decoration: none;
    padding-block: var(--space-3xs);
  }

  /*
   * Nav links are standalone targets, so they take the touch floor. Links
   * inside a sentence do not, and should not — WCAG exempts inline links
   * precisely because padding them out breaks the line they sit in.
   */
  @media (pointer: coarse) {
    nav a,
    .wordmark {
      display: inline-flex;
      align-items: center;
      min-height: var(--tap);
    }
  }

  nav a:hover {
    color: var(--color-ink);
  }

  /* Current page marked by weight and a rule, not by colour alone. */
  nav a[aria-current='page'] {
    color: var(--color-ink);
    font-weight: 600;
    box-shadow: inset 0 -1px 0 0 currentColor;
  }

  @media (max-width: 34rem) {
    .header-inner {
      gap: var(--space-xs) var(--space-sm);
      padding-block: var(--space-sm);
    }

    /* Wordmark and theme control share the first row; nav wraps under them. */
    nav {
      order: 3;
      width: 100%;
    }
  }
</style>
