---
import { ClientRouter } from 'astro:transitions';
import TopBar from '../components/ui/TopBar.astro';
import '../styles/global.css';
import { url } from '../lib/url';
import SiteFooter from '../components/ui/Footer.astro';
import CommandPalette from '../components/ui/CommandPalette.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'A free, auditable index of recurring complaints in widely used mobile apps, built from public app store reviews.',
} = Astro.props;

const documentTitle = title === 'Friction' ? 'Friction' : `${title} — Friction`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

/* About lives in the footer; the nav carries the five routes. */
const nav = [
  { href: '/challenges', label: 'Challenges' },
  { href: '/patterns', label: 'Patterns' },
  { href: '/apps', label: 'Apps' },
  { href: '/how-it-works', label: 'How it works' },
];

const here = Astro.url.pathname.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    {/*
      Applied before first paint so a chosen theme never flashes the other one.
      Nothing stored means dark: the site has a default, and following the
      operating system is one of the three choices rather than the fallback.
    */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('friction-theme');
          if (t === 'light' || t === 'dark' || t === 'system') {
            document.documentElement.dataset.theme = t;
          }
        } catch (e) {
          /* storage blocked; the dark default applies */
        }
      })();
    </script>

    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Friction" />
    {/*
      A committed raster, not an SVG and not a runtime render: no social
      platform runs JavaScript and most will not preview an SVG. The board it
      is captured from lives at src/pages/og.astro, which is built from the
      live data — regenerate it after a scan and the numbers stay honest.
    */}
    <meta property="og:image" content={new URL(url('/og.png'), Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Friction — public App Store and Google Play reviews, read every week." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL(url('/og.png'), Astro.site).href} />

    <!--
      The only colours in the project written as hex: a meta tag cannot take a
      var(). Both are --color-paper converted, light then dark, and verified
      against a sampled pixel of the rendered page.
    -->
    {/* Both are --color-paper converted: the cool navy ground, and the
        near-white the light theme uses. */}
    <meta name="theme-color" content="#2b313c" />

    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Friction" href={url('/rss.xml')} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* Newsreader is requested roman only — no italic axis is ever used. */}
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300..700&family=Geist+Mono:wght@400..500&family=Newsreader:opsz,wght@6..72,400..600&display=swap"
    />

    <ClientRouter />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <TopBar nav={nav} here={here} />

    <main id="main">
      <slot />
    </main>

    <SiteFooter />

    <CommandPalette />

    <script>
      import { watchCharts, stopWatchingCharts } from '../scripts/reveal';
      import { initPalette } from '../scripts/palette';

      let palette: { destroy(): void } | null = null;

      // The nav backdrop engages past 64px. IntersectionObserver on a
      // zero-height sentinel rather than a scroll listener, so this costs
      // nothing on the main thread while scrolling.
      function watchScroll(): void {
        const header = document.querySelector('[data-nav]');
        if (!header) return;

        const sentinel = document.createElement('div');
        sentinel.style.cssText = 'position:absolute;top:64px;height:1px;width:1px;pointer-events:none';
        document.body.prepend(sentinel);

        new IntersectionObserver(
          ([entry]) => {
            if (entry?.isIntersecting) header.removeAttribute('data-scrolled');
            else header.setAttribute('data-scrolled', '');
          },
          { threshold: 0 },
        ).observe(sentinel);
      }

      document.addEventListener('astro:page-load', () => {
        watchScroll();
        watchCharts();
        palette?.destroy();
        palette = initPalette();
      });
      document.addEventListener('astro:before-swap', () => {
        stopWatchingCharts();
        palette?.destroy();
        palette = null;
      });
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -9999px;
    top: 0;
    background: var(--m-surface-container-lowest);
    color: var(--color-ink);
    padding: var(--space-sm) var(--space-md);
    z-index: var(--z-nav);
    border: 1px solid var(--color-ink);
  }

  .skip:focus {
    left: var(--space-xs);
    top: var(--space-xs);
  }

  /* N9 · edge-aligned. Wordmark hard left at the viewport edge, controls
     hard right, nothing in the middle. The empty span is the design.
     Fixed and transparent so the field runs underneath it. */

  /* Under reduced motion the backdrop simply appears. */
  @media (prefers-reduced-motion: no-preference) {
  }

  /* Engages past 64px of scroll — one of the six sanctioned moments. */
  /*
   * A surface, not a blur. backdrop-filter on a fixed full-width header makes
   * the compositor re-sample and blur the whole strip on every scroll frame —
   * measured at 101ms on the worst frames against 37ms without it. At 94%
   * opacity the difference is invisible and the scroll is not.
   */


  /* A real button, so it is reachable without a keyboard shortcut. */





  @media (max-width: 34rem) {


  }




</style>
