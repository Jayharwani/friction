# Copy to .env for local runs. .env is gitignored and must never be committed.
# In CI these come from GitHub Actions secrets (Settings -> Secrets and variables -> Actions).

# Long random string used to salt reviewer-name hashes. Generate once, never change it:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it breaks distinct-user counts on all existing problems.
AUTHOR_SALT=

# From `claude setup-token` on a machine with a Claude Pro/Max subscription.
# Only used by the GitHub Action. Never needed for local fetch/score runs.
CLAUDE_CODE_OAUTH_TOKEN=
